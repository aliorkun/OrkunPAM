{
  "ConnectionStrings": {
    "Default": "Data Source=orkunpam.db"
  },
  "Cors": {
    "AllowedOrigins": ["https://localhost:5001", "https://localhost:7001"]
  },
  "Jwt": {
    "Issuer": "OrkunPAM",
    "Audience": "OrkunPAM",
    "AccessTokenMinutes": 15,
    "RefreshTokenHours": 8
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Security": {
    "HsmMode": "none",
    "HsmSlot": 0,
    "Pkcs11LibraryPath": "",
    "AzureKeyVaultUrl": "",
    "AwsKmsKeyArn": "",
    "AwsRegion": "",
    "MekKeyLabel": "OrkunPAM-MEK"
  },
  "ProxyService": {
    "Secret": ""
  },
  "RdpProxy": {
    "PublicHostname": null,
    "ListenPort": 3389,
    "RdsHosts": []
  },
  "RemoteApps": [
    {
      "Name": "Notepad",
      "AppPath": "||notepad",
      "Description": "Windows Notepad",
      "AppArgs": "",
      "Category": "Utilities",
      "DefaultDeviceId": null
    },
    {
      "Name": "Calculator",
      "AppPath": "||calc",
      "Description": "Windows Calculator",
      "AppArgs": "",
      "Category": "Utilities",
      "DefaultDeviceId": null
    },
    {
      "Name": "Remote Desktop Connection",
      "AppPath": "||mstsc",
      "Description": "Remote Desktop Connection client",
      "AppArgs": "",
      "Category": "Administration",
      "DefaultDeviceId": null
    }
  ]
}
