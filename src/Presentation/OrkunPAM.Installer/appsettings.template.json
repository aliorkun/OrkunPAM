{
  "ConnectionStrings": {
    "DefaultConnection": "{{DATABASE_CONNECTION_STRING}}"
  },
  "OrkunPAM": {
    "InstallDirectory": "{{INSTALL_DIRECTORY}}",
    "DataDirectory": "{{DATA_DIRECTORY}}",
    "LogsDirectory": "{{LOGS_DIRECTORY}}",
    "Version": "{{VERSION}}"
  },
  "Security": {
    "Encryption": {
      "MasterKeyDerivation": "PBKDF2-SHA512",
      "Algorithm": "AES-256-GCM",
      "KeyRotationDays": 90
    },
    "Authentication": {
      "JwtIssuer": "OrkunPAM",
      "JwtAudience": "OrkunPAM.Clients",
      "TokenExpirationMinutes": 60,
      "RefreshTokenExpirationDays": 7,
      "MaxFailedLoginAttempts": 5,
      "LockoutDurationMinutes": 30
    },
    "PasswordPolicy": {
      "MinLength": 12,
      "RequireUppercase": true,
      "RequireLowercase": true,
      "RequireDigit": true,
      "RequireSpecialChar": true,
      "HistoryCount": 12
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://0.0.0.0:{{WEBAPI_PORT}}",
        "Certificate": {
          "Path": "{{CERTIFICATE_PATH}}",
          "Password": "{{CERTIFICATE_PASSWORD}}"
        }
      }
    }
  },
  "Proxy": {
    "Ssh": {
      "ListenPort": "{{SSH_PROXY_PORT}}",
      "Enabled": "{{SSH_PROXY_ENABLED}}"
    },
    "Rdp": {
      "ListenPort": "{{RDP_PROXY_PORT}}",
      "Enabled": "{{RDP_PROXY_ENABLED}}"
    },
    "Http": {
      "ListenPort": "{{HTTP_PROXY_PORT}}",
      "Enabled": "{{HTTP_PROXY_ENABLED}}"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "{{LOGS_DIRECTORY}}/orkunpam-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "fileSizeLimitBytes": 104857600
        }
      }
    ]
  },
  "AuditLog": {
    "Enabled": true,
    "HashChainEnabled": true,
    "RetentionDays": 365
  }
}
