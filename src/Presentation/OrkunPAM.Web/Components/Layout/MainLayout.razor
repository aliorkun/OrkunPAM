@inherits LayoutComponentBase
@inject AuthStateService Auth
@inject NavigationManager Nav

@if (_isLoginPage)
{
    @Body
}
else if (_checked && _authenticated)
{
    <div class="pam-app">
        <NavMenu />
        <main class="pam-main">
            <div class="pam-content">
                @Body
            </div>
        </main>
    </div>
}

<div id="blazor-error-ui" style="display:none;">
    An unhandled error occurred.
    <a href="" class="reload">Reload</a>
    <span class="dismiss">✕</span>
</div>

@code {
    private bool _checked       = false;
    private bool _authenticated = false;
    private bool _isLoginPage   = false;

    protected override void OnInitialized()
    {
        var path = new Uri(Nav.Uri).AbsolutePath;
        _isLoginPage = path.Equals("/login", StringComparison.OrdinalIgnoreCase) ||
                       path.StartsWith("/saml", StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _isLoginPage) return;

        _authenticated = await Auth.IsAuthenticatedAsync();
        _checked = true;

        if (!_authenticated)
        {
            Nav.NavigateTo("/login", forceLoad: true);
        }
        else
        {
            StateHasChanged();
        }
    }
}
