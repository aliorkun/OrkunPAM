@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>
    <main>
        <div class="top-row px-4 d-flex align-items-center justify-content-end gap-2">
            <span id="pam-topbar-user" style="color:#94a3b8;font-size:0.85rem;"></span>
            <button id="pam-topbar-logout" class="btn btn-sm btn-outline-danger"
                    style="display:none;font-size:0.8rem;padding:2px 10px;"
                    onclick="pamLogout()">Logout</button>
        </div>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
