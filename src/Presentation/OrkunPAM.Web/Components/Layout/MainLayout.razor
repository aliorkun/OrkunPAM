@inherits LayoutComponentBase
@rendermode InteractiveServer
@inject AuthStateService Auth
@inject NavigationManager Nav

@if (_checked && _authenticated)
{
    <div class="pam-app">
        <NavMenu />
        <main class="pam-main">
            <div class="pam-content">
                @Body
            </div>
        </main>
    </div>
}
else if (!_checked)
{
    <div class="pam-loading">
        <div class="pam-loading-spinner"></div>
    </div>
}

<div id="blazor-error-ui">
    An unhandled error occurred.
    <a href="" class="reload">Reload</a>
    <span class="dismiss">✕</span>
</div>

@code {
    private bool _checked       = false;
    private bool _authenticated = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var path = new Uri(Nav.Uri).AbsolutePath;
        if (path.Equals("/login", StringComparison.OrdinalIgnoreCase))
        {
            _checked = _authenticated = true;
            StateHasChanged();
            return;
        }

        _authenticated = await Auth.IsAuthenticatedAsync();
        _checked = true;

        if (!_authenticated)
            Nav.NavigateTo("/login");
        else
            StateHasChanged();
    }
}
