@inject AuthStateService Auth
@inject NavigationManager Nav
@inject PamApiService Api
@inject IStringLocalizer<SharedResource> L
@inject CultureService CultureSvc

<div class="pam-sidebar">
    <div class="pam-brand">
        <span class="pam-brand-icon">&#x1F510;</span>
        <span class="pam-brand-text">OrkunPAM</span>
    </div>

    @if (_user != null)
    {
        <div class="pam-user-info">
            <div class="pam-user-avatar">@_user.DisplayName[0]</div>
            <div class="pam-user-details">
                <div class="pam-user-name">@_user.DisplayName</div>
                <div class="pam-user-role">@_user.Username</div>
            </div>
        </div>
    }

    <!-- Language switcher -->
    <div class="pam-lang-switcher">
        <button class="pam-lang-btn @(_currentCulture.StartsWith(&quot;en&quot;) ? &quot;pam-lang-active&quot; : &quot;&quot;)"
                @onclick="@(() => CultureSvc.SetCulture(&quot;en-US&quot;))">EN</button>
        <button class="pam-lang-btn @(_currentCulture.StartsWith(&quot;tr&quot;) ? &quot;pam-lang-active&quot; : &quot;&quot;)"
                @onclick="@(() => CultureSvc.SetCulture(&quot;tr-TR&quot;))">TR</button>
    </div>

    <nav class="pam-nav">
        <div class="pam-nav-section">@L["nav_section_overview"]</div>
        <NavLink class="pam-nav-link" href="/" Match="NavLinkMatch.All">
            <span class="pam-nav-icon">&#x229E;</span> @L["nav_dashboard"]
        </NavLink>
        <NavLink class="pam-nav-link" href="/portal">
            <span class="pam-nav-icon">&#x1F9D1;</span> @L["nav_my_portal"]
        </NavLink>
        <NavLink class="pam-nav-link" href="/sessions">
            <span class="pam-nav-icon">&#x25B6;</span> @L["nav_active_sessions"]
        </NavLink>
        <NavLink class="pam-nav-link" href="/session-playback">
            <span class="pam-nav-icon">&#x23EF;</span> @L["nav_session_playback"]
        </NavLink>

        <div class="pam-nav-section">@L["nav_section_access"]</div>
        <NavLink class="pam-nav-link" href="/vault">
            <span class="pam-nav-icon">&#x1F511;</span> @L["nav_vault"]
        </NavLink>
        <NavLink class="pam-nav-link" href="/devices">
            <span class="pam-nav-icon">&#x1F5B5;</span> @L["nav_devices"]
        </NavLink>

        <div class="pam-nav-section">@L["nav_section_identity"]</div>
        <NavLink class="pam-nav-link" href="/users">
            <span class="pam-nav-icon">&#x1F464;</span> @L["nav_users"]
        </NavLink>
        <NavLink class="pam-nav-link" href="/policies">
            <span class="pam-nav-icon">&#x1F4CB;</span> @L["nav_policies"]
        </NavLink>

        <div class="pam-nav-section">@L["nav_section_workflow"]</div>
        <NavLink class="pam-nav-link" href="/approvals">
            <span class="pam-nav-icon">&#x2705;</span> @L["nav_approvals"]
            @if (_pendingCount > 0)
            {
                <span class="pam-nav-badge @(_pendingCount > 0 ? &quot;pam-nav-badge-red&quot; : &quot;&quot;)">@_pendingCount</span>
            }
        </NavLink>
        <NavLink class="pam-nav-link" href="/break-glass">
            <span class="pam-nav-icon">&#x1F6A8;</span> @L["nav_break_glass"]
        </NavLink>
        <NavLink class="pam-nav-link" href="/jit">
            <span class="pam-nav-icon">&#x23F1;</span> @L["nav_jit_access"]
        </NavLink>
        <NavLink class="pam-nav-link" href="/vendors">
            <span class="pam-nav-icon">&#x1F3ED;</span> @L["nav_vendor_access"]
        </NavLink>

        <div class="pam-nav-section">@L["nav_section_reporting"]</div>
        <NavLink class="pam-nav-link" href="/reports">
            <span class="pam-nav-icon">&#x1F4CA;</span> @L["nav_reports"]
        </NavLink>
        @if (_user?.Roles.Contains("GlobalAdmin") == true || _user?.Roles.Contains("Auditor") == true)
        {
            <NavLink class="pam-nav-link" href="/executive-dashboard">
                <span class="pam-nav-icon">&#x1F4C8;</span> Executive Dashboard
            </NavLink>
        }
        <NavLink class="pam-nav-link" href="/compliance">
            <span class="pam-nav-icon">&#x2714;</span> @L["nav_certifications"]
        </NavLink>

        <div class="pam-nav-section">@L["nav_section_terminal"]</div>
        <NavLink class="pam-nav-link" href="/connect">
            <span class="pam-nav-icon">&#x2328;</span> @L["nav_ssh_rdp"]
        </NavLink>

        <div class="pam-nav-section">@L["nav_section_network"]</div>
        <NavLink class="pam-nav-link" href="/network-access">
            <span class="pam-nav-icon">&#x2B21;</span> @L["nav_tacacs_radius"]
        </NavLink>
        <NavLink class="pam-nav-link" href="/rdp-management">
            <span class="pam-nav-icon">&#x1F5A5;</span> @L["nav_rdp_management"]
        </NavLink>

        <div class="pam-nav-section">Cloud</div>
        <NavLink class="pam-nav-link" href="/cloud-pam">
            <span class="pam-nav-icon">&#x2601;</span> Cloud PAM
        </NavLink>

        <div class="pam-nav-section">Threat Analytics</div>
        <NavLink class="pam-nav-link" href="/threat-analytics">
            <span class="pam-nav-icon">&#x26A0;</span> SOC Dashboard
        </NavLink>

        <div class="pam-nav-section">Security</div>
        <NavLink class="pam-nav-link" href="/security-keys">
            <span class="pam-nav-icon">&#x1F5DD;</span> Security Keys
        </NavLink>
        <NavLink class="pam-nav-link" href="/push-devices">
            <span class="pam-nav-icon">&#x1F4F1;</span> Push MFA Devices
        </NavLink>
        <NavLink class="pam-nav-link" href="/certificates">
            <span class="pam-nav-icon">&#x1F4DC;</span> Certificates
        </NavLink>

        <div class="pam-nav-section">@L["nav_section_system"]</div>
        <NavLink class="pam-nav-link" href="/system-health">
            <span class="pam-nav-icon">&#x2764;</span> @L["nav_system_health"]
        </NavLink>
        <NavLink class="pam-nav-link" href="/system-logs">
            <span class="pam-nav-icon">&#x1F4DC;</span> System Logs
        </NavLink>
        <NavLink class="pam-nav-link" href="/discovery">
            <span class="pam-nav-icon">&#x1F50D;</span> @L["nav_discovery"]
        </NavLink>
        <NavLink class="pam-nav-link" href="/integrations">
            <span class="pam-nav-icon">&#x1F517;</span> @L["nav_integrations"]
        </NavLink>
        <NavLink class="pam-nav-link" href="/encryption">
            <span class="pam-nav-icon">&#x1F512;</span> @L["nav_encryption"]
        </NavLink>
    </nav>

    <div class="pam-sidebar-footer">
        <button class="pam-logout-btn" @onclick="LogoutAsync">
            <span>&#x21A9;</span> @L["nav_sign_out"]
        </button>
    </div>
</div>

@code {
    private AuthUser? _user;
    private int _pendingCount;
    private string _currentCulture = "en-US";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _user = await Auth.GetUserAsync();
        _pendingCount = await Api.GetPendingApprovalCountAsync();
        _currentCulture = CultureSvc.CurrentCulture;
        StateHasChanged();
    }

    private async Task LogoutAsync()
    {
        await Auth.ClearAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
