@inject AuthStateService Auth
@inject NavigationManager Nav
@inject PamApiService Api

<div class="pam-sidebar">
    <div class="pam-brand">
        <span class="pam-brand-icon">🔐</span>
        <span class="pam-brand-text">OrkunPAM</span>
    </div>

    @if (_user != null)
    {
        <div class="pam-user-info">
            <div class="pam-user-avatar">@_user.DisplayName[0]</div>
            <div class="pam-user-details">
                <div class="pam-user-name">@_user.DisplayName</div>
                <div class="pam-user-role">@_user.Username</div>
            </div>
        </div>
    }

    <nav class="pam-nav">
        <div class="pam-nav-section">OVERVIEW</div>
        <NavLink class="pam-nav-link" href="/" Match="NavLinkMatch.All">
            <span class="pam-nav-icon">⊞</span> Dashboard
        </NavLink>
        <NavLink class="pam-nav-link" href="/sessions">
            <span class="pam-nav-icon">▶</span> Active Sessions
        </NavLink>

        <div class="pam-nav-section">ACCESS</div>
        <NavLink class="pam-nav-link" href="/vault">
            <span class="pam-nav-icon">🔑</span> Vault
        </NavLink>
        <NavLink class="pam-nav-link" href="/devices">
            <span class="pam-nav-icon">🖵</span> Devices
        </NavLink>

        <div class="pam-nav-section">IDENTITY</div>
        <NavLink class="pam-nav-link" href="/users">
            <span class="pam-nav-icon">👤</span> Users
        </NavLink>
        <NavLink class="pam-nav-link" href="/policies">
            <span class="pam-nav-icon">📋</span> Policies
        </NavLink>

        <div class="pam-nav-section">WORKFLOW</div>
        <NavLink class="pam-nav-link" href="/approvals">
            <span class="pam-nav-icon">✅</span> Approvals
            @if (_pendingCount > 0)
            {
                <span class="pam-nav-badge @(_pendingCount > 0 ? "pam-nav-badge-red" : "")">@_pendingCount</span>
            }
        </NavLink>
        <NavLink class="pam-nav-link" href="/break-glass">
            <span class="pam-nav-icon">🚨</span> Break-Glass
        </NavLink>
        <NavLink class="pam-nav-link" href="/jit">
            <span class="pam-nav-icon">⏱</span> JIT Access
        </NavLink>

        <div class="pam-nav-section">REPORTING</div>
        <NavLink class="pam-nav-link" href="/reports">
            <span class="pam-nav-icon">📊</span> Reports
        </NavLink>

        <div class="pam-nav-section">TERMINAL</div>
        <NavLink class="pam-nav-link" href="/connect">
            <span class="pam-nav-icon">⌨</span> SSH/RDP Connect
        </NavLink>

        <div class="pam-nav-section">SYSTEM</div>
        <NavLink class="pam-nav-link" href="/integrations">
            <span class="pam-nav-icon">🔗</span> Integrations
        </NavLink>
        <NavLink class="pam-nav-link" href="/encryption">
            <span class="pam-nav-icon">🔒</span> Encryption
        </NavLink>
    </nav>

    <div class="pam-sidebar-footer">
        <button class="pam-logout-btn" @onclick="LogoutAsync">
            <span>↩</span> Sign Out
        </button>
    </div>
</div>

@code {
    private AuthUser? _user;
    private int _pendingCount;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _user = await Auth.GetUserAsync();
        _pendingCount = await Api.GetPendingApprovalCountAsync();
        StateHasChanged();
    }

    private async Task LogoutAsync()
    {
        await Auth.ClearAsync();
        Nav.NavigateTo("/login", forceLoad: true);
    }
}
