<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="OrkunPAM.Web.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>

<body>
    <!-- Static splash screen — renders instantly before Blazor/SignalR connects -->
    <div id="app-loading">
        <style>
            #app-loading {
                position: fixed; inset: 0; z-index: 9999;
                background: linear-gradient(135deg, #1a1d23 0%, #252932 100%);
                display: flex; align-items: center; justify-content: center;
                flex-direction: column; gap: 16px;
            }
            #app-loading .boot-logo { font-size: 48px; }
            #app-loading .boot-title { font-size: 24px; font-weight: 700; color: #fff; letter-spacing: 1px; }
            #app-loading .boot-sub { font-size: 13px; color: #8895aa; }
            #app-loading .boot-spin {
                width: 32px; height: 32px; margin-top: 8px;
                border: 3px solid #2a2d38; border-top-color: #4f8ef7;
                border-radius: 50%; animation: bootspin 0.8s linear infinite;
            }
            @@keyframes bootspin { to { transform: rotate(360deg); } }
        </style>
        <div class="boot-logo">🔐</div>
        <div class="boot-title">OrkunPAM</div>
        <div class="boot-sub">Privileged Access Management</div>
        <div class="boot-spin"></div>
    </div>

    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />

    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        Blazor.start({
            circuit: {
                configureSignalR: function (builder) {
                    builder.withUrl("/_blazor", {
                        transport: 1 | 2 | 4
                    });
                }
            }
        });
    </script>
    <script>
        // Remove splash once Blazor circuit is connected
        document.addEventListener('blazor:connected', function() {
            var el = document.getElementById('app-loading');
            if (el) { el.style.opacity = '0'; el.style.transition = 'opacity 0.3s'; setTimeout(function(){ el.remove(); }, 300); }
        });
        // Fallback: remove after 5s even if event doesn't fire
        setTimeout(function() {
            var el = document.getElementById('app-loading');
            if (el) el.remove();
        }, 5000);

        function pamUpdateAuthBar() {
            const user = localStorage.getItem('orkunpam_user');
            const el  = document.getElementById('pam-topbar-user');
            const btn = document.getElementById('pam-topbar-logout');
            if (el)  el.textContent = user || '';
            if (btn) btn.style.display = user ? 'inline-block' : 'none';
        }
        function pamLogout() {
            localStorage.removeItem('orkunpam_token');
            localStorage.removeItem('orkunpam_user');
            window.location.href = '/login';
        }
        document.addEventListener('DOMContentLoaded', pamUpdateAuthBar);
        document.addEventListener('blazor:navigated', pamUpdateAuthBar);

        // Download an RDP launch file from a base64-encoded string
        function downloadRdpFile(filename, contentBase64) {
            const binary = atob(contentBase64);
            const bytes  = new Uint8Array(binary.length);
            for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
            const blob = new Blob([bytes], { type: 'application/x-rdp' });
            const url  = URL.createObjectURL(blob);
            const a    = document.createElement('a');
            a.href     = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }
        // Download a CSV file from a plain-text string
        function downloadCsvFile(filename, csvContent) {
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url  = URL.createObjectURL(blob);
            const a    = document.createElement('a');
            a.href     = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }
        // Download a binary file from a base64-encoded string (PDF, Excel, etc.)
        function downloadBinaryFile(filename, contentType, contentBase64) {
            const binary = atob(contentBase64);
            const bytes  = new Uint8Array(binary.length);
            for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
            const blob = new Blob([bytes], { type: contentType });
            const url  = URL.createObjectURL(blob);
            const a    = document.createElement('a');
            a.href     = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }
        // Download any text file (client profiles, config snippets, etc.)
        function downloadTextFile(filename, content, mimeType) {
            const blob = new Blob([content], { type: mimeType || 'text/plain' });
            const url  = URL.createObjectURL(blob);
            const a    = document.createElement('a');
            a.href     = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }
        // Copy text to clipboard (falls back to execCommand for HTTP contexts)
        function copyToClipboard(text) {
            if (navigator.clipboard) {
                navigator.clipboard.writeText(text).catch(() => _copyFallback(text));
            } else {
                _copyFallback(text);
            }
        }
        function _copyFallback(text) {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity  = '0';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
        }
        // ── FIDO2/WebAuthn helpers ──
        function _b64urlToBuffer(b64) {
            const s = b64.replace(/-/g, '+').replace(/_/g, '/');
            const pad = (4 - s.length % 4) % 4;
            const bin = atob(s + '==='.slice(0, pad));
            const buf = new ArrayBuffer(bin.length);
            const u8  = new Uint8Array(buf);
            for (let i = 0; i < bin.length; i++) u8[i] = bin.charCodeAt(i);
            return buf;
        }
        function _bufToB64url(buf) {
            const u8 = new Uint8Array(buf);
            let bin = '';
            for (let i = 0; i < u8.byteLength; i++) bin += String.fromCharCode(u8[i]);
            return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
        }
        async function fido2CreateCredential(optionsJson) {
            const o = JSON.parse(optionsJson);
            o.challenge = _b64urlToBuffer(o.challenge);
            o.user.id   = _b64urlToBuffer(o.user.id);
            if (o.excludeCredentials)
                o.excludeCredentials = o.excludeCredentials.map(c => ({ ...c, id: _b64urlToBuffer(c.id) }));
            const cred = await navigator.credentials.create({ publicKey: o });
            return JSON.stringify({
                id:    cred.id,
                rawId: _bufToB64url(cred.rawId),
                type:  cred.type,
                response: {
                    clientDataJSON:    _bufToB64url(cred.response.clientDataJSON),
                    attestationObject: _bufToB64url(cred.response.attestationObject)
                }
            });
        }
        async function fido2GetAssertion(optionsJson) {
            const o = JSON.parse(optionsJson);
            o.challenge = _b64urlToBuffer(o.challenge);
            if (o.allowCredentials)
                o.allowCredentials = o.allowCredentials.map(c => ({ ...c, id: _b64urlToBuffer(c.id) }));
            const asr = await navigator.credentials.get({ publicKey: o });
            return JSON.stringify({
                id:    asr.id,
                rawId: _bufToB64url(asr.rawId),
                type:  asr.type,
                response: {
                    clientDataJSON:    _bufToB64url(asr.response.clientDataJSON),
                    authenticatorData: _bufToB64url(asr.response.authenticatorData),
                    signature:         _bufToB64url(asr.response.signature),
                    userHandle: asr.response.userHandle ? _bufToB64url(asr.response.userHandle) : null
                }
            });
        }
    </script>
</body>

</html>