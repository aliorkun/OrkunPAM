<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="OrkunPAM.Web.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="@InteractiveServer" />
</head>

<body>
    <!-- Static splash screen — renders instantly before Blazor/SignalR connects -->
    <div id="app-loading">
        <style>
            #app-loading {
                position: fixed; inset: 0; z-index: 9999;
                background: linear-gradient(135deg, #1a1d23 0%, #252932 100%);
                display: flex; align-items: center; justify-content: center;
                flex-direction: column; gap: 16px;
            }
            #app-loading .boot-logo { font-size: 48px; }
            #app-loading .boot-title { font-size: 24px; font-weight: 700; color: #fff; letter-spacing: 1px; }
            #app-loading .boot-sub { font-size: 13px; color: #8895aa; }
            #app-loading .boot-spin {
                width: 32px; height: 32px; margin-top: 8px;
                border: 3px solid #2a2d38; border-top-color: #4f8ef7;
                border-radius: 50%; animation: bootspin 0.8s linear infinite;
            }
            @@keyframes bootspin { to { transform: rotate(360deg); } }
        </style>
        <div class="boot-logo">🔐</div>
        <div class="boot-title">OrkunPAM</div>
        <div class="boot-sub">Privileged Access Management</div>
        <div class="boot-spin"></div>
    </div>

    <Routes @rendermode="@InteractiveServer" />

    <script src="_framework/blazor.web.js"></script>
    <script>
        // Remove splash once Blazor circuit is connected
        document.addEventListener('blazor:connected', function() {
            var el = document.getElementById('app-loading');
            if (el) { el.style.opacity = '0'; el.style.transition = 'opacity 0.3s'; setTimeout(function(){ el.remove(); }, 300); }
        });
        // Fallback: remove after 5s even if event doesn't fire
        setTimeout(function() {
            var el = document.getElementById('app-loading');
            if (el) el.remove();
        }, 5000);

        function pamUpdateAuthBar() {
            const user = localStorage.getItem('orkunpam_user');
            const el  = document.getElementById('pam-topbar-user');
            const btn = document.getElementById('pam-topbar-logout');
            if (el)  el.textContent = user || '';
            if (btn) btn.style.display = user ? 'inline-block' : 'none';
        }
        function pamLogout() {
            localStorage.removeItem('orkunpam_token');
            localStorage.removeItem('orkunpam_user');
            window.location.href = '/login';
        }
        document.addEventListener('DOMContentLoaded', pamUpdateAuthBar);
        document.addEventListener('blazor:navigated', pamUpdateAuthBar);

        // Download an RDP launch file from a base64-encoded string
        function downloadRdpFile(filename, contentBase64) {
            const binary = atob(contentBase64);
            const bytes  = new Uint8Array(binary.length);
            for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
            const blob = new Blob([bytes], { type: 'application/x-rdp' });
            const url  = URL.createObjectURL(blob);
            const a    = document.createElement('a');
            a.href     = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }
        // Download a CSV file from a plain-text string
        function downloadCsvFile(filename, csvContent) {
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const url  = URL.createObjectURL(blob);
            const a    = document.createElement('a');
            a.href     = url;
            a.download = filename;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }
    </script>
</body>

</html>
