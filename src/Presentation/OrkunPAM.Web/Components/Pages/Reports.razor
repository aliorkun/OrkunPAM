@page "/reports"
@using System.Text
@using System.Text.Json
@inject PamApiService Api
@inject IJSRuntime JS

<PageTitle>Reports — OrkunPAM</PageTitle>

<div class="pam-page-header">
    <h2 class="pam-page-title">Reports &amp; Audit</h2>
</div>

<div style="display:flex;gap:4px;margin-bottom:16px">
    <button class="pam-btn @(_tab == "audit" ? "pam-btn-primary" : "pam-btn-secondary")"
            @onclick="@(() => SetTab("audit"))">&#x1F4CB; Audit Log</button>
    <button class="pam-btn @(_tab == "reports" ? "pam-btn-primary" : "pam-btn-secondary")"
            @onclick="@(() => SetTab("reports"))">&#x1F4CA; Reports</button>
    <button class="pam-btn @(_tab == "schedule" ? "pam-btn-primary" : "pam-btn-secondary")"
            @onclick="@(() => SetTab("schedule"))">&#x1F551; Schedule</button>
    <button class="pam-btn @(_tab == "custom" ? "pam-btn-primary" : "pam-btn-secondary")"
            @onclick="@(() => SetTab("custom"))">&#x1F527; Custom</button>
    <button class="pam-btn @(_tab == "compliance" ? "pam-btn-primary" : "pam-btn-secondary")"
            @onclick="@(() => SetTab("compliance"))">&#x2705; Compliance</button>
</div>

@if (_tab == "audit")
{
    <div class="pam-filters">
        <select class="pam-input pam-select" @bind="_auditCategory" style="width:140px">
            <option value="">All Categories</option>
            <option value="Auth">Auth</option>
            <option value="User">User</option>
            <option value="Vault">Vault</option>
            <option value="Session">Session</option>
            <option value="Device">Device</option>
            <option value="Policy">Policy</option>
            <option value="System">System</option>
        </select>
        <input class="pam-input" placeholder="Filter event…"
               @bind="_auditEventFilter" style="width:160px" />
        <button class="pam-btn @(_preset == "1d" ? "pam-btn-primary" : "pam-btn-secondary") pam-btn-sm"
                @onclick="@(() => ApplyPreset("1d"))">24h</button>
        <button class="pam-btn @(_preset == "7d" ? "pam-btn-primary" : "pam-btn-secondary") pam-btn-sm"
                @onclick="@(() => ApplyPreset("7d"))">7d</button>
        <button class="pam-btn @(_preset == "30d" ? "pam-btn-primary" : "pam-btn-secondary") pam-btn-sm"
                @onclick="@(() => ApplyPreset("30d"))">30d</button>
        <button class="pam-btn @(_preset == "custom" ? "pam-btn-primary" : "pam-btn-secondary") pam-btn-sm"
                @onclick="@(() => ApplyPreset("custom"))">Custom</button>
        @if (_preset == "custom")
        {
            <input type="date" class="pam-input" @bind="_customFrom" @bind:format="yyyy-MM-dd" style="width:140px" />
            <input type="date" class="pam-input" @bind="_customTo" @bind:format="yyyy-MM-dd" style="width:140px" />
        }
        <button class="pam-btn pam-btn-primary" @onclick="LoadAuditAsync">Search</button>
        <button class="pam-btn pam-btn-secondary" @onclick="ExportAuditCsvAsync"
                disabled="@(_auditLogs == null || _auditLogs.Count == 0)">Export CSV</button>
        <button class="pam-btn pam-btn-secondary" @onclick="VerifyIntegrityAsync">Verify Integrity</button>
    </div>

    @if (_integrityResult != null)
    {
        <div class="pam-alert @(_integrityResult.IntegrityValid ? "pam-alert-info" : "pam-alert-danger")" style="margin-bottom:8px">
            @(_integrityResult.IntegrityValid ? "✓" : "⚠") @_integrityResult.Message
            @if (!_integrityResult.IntegrityValid)
            {
                <span> (checked @_integrityResult.EntriesChecked entries, @_integrityResult.TamperedCount tampered)</span>
            }
        </div>
    }

    @if (_auditError != null) { <div class="pam-alert pam-alert-danger">@_auditError</div> }

    <div class="pam-card">
        <div class="pam-card-body p-0">
            @if (_auditLoading)
            {
                <div class="pam-loading-text p-4">Loading audit log…</div>
            }
            else if (_auditLogs == null || _auditLogs.Count == 0)
            {
                <div class="pam-empty p-4">No audit events in selected range.</div>
            }
            else
            {
                <table class="pam-table pam-table-hover" style="font-size:0.85em">
                    <thead>
                        <tr>
                            <th>Timestamp</th>
                            <th>Actor</th>
                            <th>IP</th>
                            <th>Category</th>
                            <th>Event</th>
                            <th>Target</th>
                            <th>Outcome</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in _auditLogs)
                        {
                            <tr>
                                <td style="white-space:nowrap">@log.Timestamp.ToLocalTime().ToString("MM/dd HH:mm:ss")</td>
                                <td>@(log.ActorUsername ?? "—")</td>
                                <td>@(log.ActorIpAddress ?? "—")</td>
                                <td><span class="pam-badge">@log.EventCategory</span></td>
                                <td>@log.EventType</td>
                                <td>
                                    @if (log.TargetId != null)
                                    {
                                        <span>@log.TargetType:@log.TargetId</span>
                                    }
                                    else
                                    {
                                        <span>@(log.TargetType ?? "—")</span>
                                    }
                                </td>
                                <td>
                                    <span class="pam-status @OutcomeClass(log.Outcome)">@log.Outcome</span>
                                    @if (log.IsTampered) { <span class="pam-badge" style="background:#dc3545;color:#fff;margin-left:4px">⚠ TAMPERED</span> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_auditMeta != null && _auditMeta.TotalCount > _auditPageSize)
                {
                    <div class="pam-pagination">
                        <button class="pam-btn pam-btn-secondary pam-btn-sm"
                                disabled="@(_auditPage == 1)" @onclick="AuditPrevPage">← Prev</button>
                        <span class="pam-page-info">Page @_auditPage / @AuditTotalPages — @_auditMeta.TotalCount events</span>
                        <button class="pam-btn pam-btn-secondary pam-btn-sm"
                                disabled="@(_auditPage >= AuditTotalPages)" @onclick="AuditNextPage">Next →</button>
                    </div>
                }
            }
        </div>
    </div>
}
else if (_tab == "reports")
{
    <div class="pam-filters">
        <span style="font-size:0.9em;color:#555;line-height:32px">Range:</span>
        <button class="pam-btn @(_reportPreset == "1d" ? "pam-btn-primary" : "pam-btn-secondary") pam-btn-sm"
                @onclick="@(() => _reportPreset = "1d")">24h</button>
        <button class="pam-btn @(_reportPreset == "7d" ? "pam-btn-primary" : "pam-btn-secondary") pam-btn-sm"
                @onclick="@(() => _reportPreset = "7d")">7d</button>
        <button class="pam-btn @(_reportPreset == "30d" ? "pam-btn-primary" : "pam-btn-secondary") pam-btn-sm"
                @onclick="@(() => _reportPreset = "30d")">30d</button>
        <button class="pam-btn @(_reportPreset == "custom" ? "pam-btn-primary" : "pam-btn-secondary") pam-btn-sm"
                @onclick="@(() => _reportPreset = "custom")">Custom</button>
        @if (_reportPreset == "custom")
        {
            <input type="date" class="pam-input" @bind="_reportFrom" @bind:format="yyyy-MM-dd" style="width:140px" />
            <input type="date" class="pam-input" @bind="_reportTo" @bind:format="yyyy-MM-dd" style="width:140px" />
        }
    </div>

    @if (_reportsLoading)
    {
        <div class="pam-loading-text">Loading reports…</div>
    }
    else if (_reports == null || _reports.Count == 0)
    {
        <div class="pam-alert pam-alert-info">No reports available.</div>
    }
    else
    {
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px;margin-bottom:16px">
            @foreach (var r in _reports)
            {
                <div class="pam-card"
                     style="cursor:pointer;outline:@CardOutline(r.Id)"
                     @onclick="@(() => RunReportAsync(r))">
                    <div class="pam-card-body" style="padding:14px">
                        <div style="font-weight:600;margin-bottom:4px">@r.Name</div>
                        <div style="font-size:0.8em;color:#888;margin-bottom:8px">@r.Description</div>
                        <div style="display:flex;align-items:center;gap:8px">
                            <span class="pam-badge">@r.Category</span>
                            @if (_runningReport == r.Id)
                            {
                                <span style="font-size:0.75em;color:#666">Running…</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (_reportError != null) { <div class="pam-alert pam-alert-danger">@_reportError</div> }

        @if (_reportResult != null && _selectedReport != null)
        {
            <div class="pam-card">
                <div class="pam-card-body">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
                        <strong>@_selectedReport.Name</strong>
                        <div style="display:flex;gap:6px">
                            @if (_reportRows.Count > 0)
                            {
                                <button class="pam-btn pam-btn-secondary pam-btn-sm" @onclick="ExportReportCsvAsync">Export CSV</button>
                            }
                            <button class="pam-btn pam-btn-secondary pam-btn-sm" @onclick="CloseReport">✕</button>
                        </div>
                    </div>
                    @if (_reportSummary.Count > 0)
                    {
                        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:8px;margin-bottom:16px">
                            @foreach (var kv in _reportSummary)
                            {
                                <div style="background:#f9fafb;border-radius:6px;padding:10px">
                                    <div style="font-size:0.75em;color:#888;margin-bottom:2px">@kv.Key</div>
                                    <div style="font-weight:600;font-size:1.05em">@kv.Value</div>
                                </div>
                            }
                        </div>
                    }
                    @if (_reportRows.Count > 0)
                    {
                        <div style="overflow-x:auto">
                            <table class="pam-table pam-table-hover" style="font-size:0.85em">
                                <thead>
                                    <tr>
                                        @foreach (var col in _reportColumns)
                                        {
                                            <th>@FormatKey(col)</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in _reportRows)
                                    {
                                        <tr>
                                            @foreach (var col in _reportColumns)
                                            {
                                                <td>@row.GetValueOrDefault(col, "—")</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    }
}

@if (_tab == "custom")
{
    <div style="display:flex;gap:16px;align-items:flex-start">
        <div style="width:260px;flex-shrink:0">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
                <strong style="font-size:0.9em">Saved Reports</strong>
                <button class="pam-btn pam-btn-primary pam-btn-sm"
                        @onclick="@(() => StartNewReport())">+ New</button>
            </div>
            @if (_crLoading)
            { <div class="pam-loading-text">Loading…</div> }
            else if (_crSavedReports == null || _crSavedReports.Count == 0)
            { <div style="font-size:0.85em;color:#888;padding:4px">No saved reports yet.</div> }
            else
            {
                @foreach (var cr in _crSavedReports)
                {
                    <div class="pam-card" style="margin-bottom:6px;cursor:pointer"
                         @onclick="@(() => SelectSavedReport(cr))">
                        <div class="pam-card-body" style="padding:8px">
                            <div style="font-weight:600;font-size:0.88em">@cr.Name</div>
                            <div style="font-size:0.75em;color:#888">
                                @cr.DataSource
                                @if (cr.LastRunAtUtc.HasValue)
                                { <span>· @cr.LastRunAtUtc.Value.ToLocalTime().ToString("MM/dd")</span> }
                                else { <span>· never run</span> }
                            </div>
                            <div style="display:flex;gap:4px;margin-top:4px">
                                <button class="pam-btn pam-btn-secondary pam-btn-sm"
                                        @onclick:stopPropagation="true"
                                        @onclick="@(() => RunSavedReportAsync(cr.Id))"
                                        disabled="@_crRunning">▶</button>
                                <button class="pam-btn pam-btn-secondary pam-btn-sm"
                                        style="color:#dc3545"
                                        @onclick:stopPropagation="true"
                                        @onclick="@(() => DeleteSavedReportAsync(cr.Id))">✕</button>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>

        <div style="flex:1;min-width:0">
            <div class="pam-card" style="margin-bottom:12px">
                <div class="pam-card-body">
                    <h4 style="margin-bottom:12px">Custom Report Builder</h4>

                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px">
                        <div>
                            <label class="pam-label">Report Name</label>
                            <input class="pam-input" placeholder="e.g. VaultAdmin RDP Last 90 Days" @bind="_crName" />
                        </div>
                        <div>
                            <label class="pam-label">Data Source</label>
                            <select class="pam-input pam-select"
                                    value="@_crDataSource"
                                    @onchange="@(e => OnDataSourceChanged(e.Value?.ToString() ?? "AuditLogs"))">
                                <option value="AuditLogs">Audit Logs</option>
                                <option value="Sessions">Sessions</option>
                                <option value="Credentials">Credentials</option>
                                <option value="Users">Users</option>
                            </select>
                        </div>
                    </div>

                    @if (_crDataSource == "AuditLogs" || _crDataSource == "Sessions")
                    {
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px">
                            <div>
                                <label class="pam-label">Date From</label>
                                <input type="date" class="pam-input" @bind="_crDateFrom" @bind:format="yyyy-MM-dd" />
                            </div>
                            <div>
                                <label class="pam-label">Date To</label>
                                <input type="date" class="pam-input" @bind="_crDateTo" @bind:format="yyyy-MM-dd" />
                            </div>
                        </div>
                    }

                    @if (_crDataSource == "AuditLogs")
                    {
                        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:10px">
                            <div>
                                <label class="pam-label">Actor Username</label>
                                <input class="pam-input" placeholder="contains…" @bind="_crFilterUsername" />
                            </div>
                            <div>
                                <label class="pam-label">Category</label>
                                <select class="pam-input pam-select" @bind="_crFilterCategory">
                                    <option value="">All</option>
                                    <option value="Auth">Auth</option>
                                    <option value="User">User</option>
                                    <option value="Vault">Vault</option>
                                    <option value="Session">Session</option>
                                    <option value="Device">Device</option>
                                    <option value="Report">Report</option>
                                    <option value="System">System</option>
                                </select>
                            </div>
                            <div>
                                <label class="pam-label">Outcome</label>
                                <select class="pam-input pam-select" @bind="_crFilterOutcome">
                                    <option value="">All</option>
                                    <option value="Success">Success</option>
                                    <option value="Failure">Failure</option>
                                    <option value="Denied">Denied</option>
                                </select>
                            </div>
                        </div>
                        <div style="margin-bottom:10px">
                            <label class="pam-label">Event Type Contains</label>
                            <input class="pam-input" placeholder="e.g. Login" @bind="_crFilterEventType" style="max-width:280px" />
                        </div>
                    }
                    else if (_crDataSource == "Sessions")
                    {
                        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:10px">
                            <div>
                                <label class="pam-label">Protocol</label>
                                <select class="pam-input pam-select" @bind="_crFilterProtocol">
                                    <option value="">All</option>
                                    <option value="Ssh">SSH</option>
                                    <option value="Rdp">RDP</option>
                                    <option value="Vnc">VNC</option>
                                    <option value="Http">HTTP</option>
                                    <option value="Sql">SQL</option>
                                </select>
                            </div>
                            <div>
                                <label class="pam-label">Min Risk Score</label>
                                <input type="number" class="pam-input" min="0" max="100" @bind="_crFilterMinRisk" placeholder="0" />
                            </div>
                            <div>
                                <label class="pam-label">Max Risk Score</label>
                                <input type="number" class="pam-input" min="0" max="100" @bind="_crFilterMaxRisk" placeholder="100" />
                            </div>
                        </div>
                    }
                    else if (_crDataSource == "Credentials")
                    {
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px">
                            <div>
                                <label class="pam-label">Credential Type</label>
                                <select class="pam-input pam-select" @bind="_crFilterCredType">
                                    <option value="">All</option>
                                    <option value="UserPassword">User Password</option>
                                    <option value="SshKey">SSH Key</option>
                                    <option value="ApiKey">API Key</option>
                                    <option value="Certificate">Certificate</option>
                                    <option value="ConnectionString">Connection String</option>
                                </select>
                            </div>
                            <div>
                                <label class="pam-label">Status</label>
                                <select class="pam-input pam-select" @bind="_crFilterCredStatus">
                                    <option value="">All</option>
                                    <option value="Active">Active</option>
                                    <option value="Disabled">Disabled</option>
                                    <option value="CheckedOut">Checked Out</option>
                                    <option value="Rotating">Rotating</option>
                                </select>
                            </div>
                        </div>
                    }
                    else if (_crDataSource == "Users")
                    {
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px">
                            <div>
                                <label class="pam-label">Status</label>
                                <select class="pam-input pam-select" @bind="_crFilterUserStatus">
                                    <option value="">All</option>
                                    <option value="Active">Active</option>
                                    <option value="Disabled">Disabled</option>
                                    <option value="Locked">Locked</option>
                                    <option value="Expired">Expired</option>
                                </select>
                            </div>
                            <div>
                                <label class="pam-label">MFA Enabled</label>
                                <select class="pam-input pam-select" @bind="_crFilterMfaEnabled">
                                    <option value="">All</option>
                                    <option value="yes">Yes</option>
                                    <option value="no">No</option>
                                </select>

                            </div>
                        </div>
                    }

                    <div style="margin-bottom:12px">
                        <label class="pam-label">Columns</label>
                        <div style="display:flex;flex-wrap:wrap;gap:6px 18px;margin-top:4px">
                            @foreach (var col in GetAvailableCols())
                            {
                                <label style="display:flex;align-items:center;gap:4px;font-size:0.85em;cursor:pointer">
                                    <input type="checkbox"
                                           checked="@_crSelectedColumns.Contains(col)"
                                           @onchange="@(e => ToggleColumn(col, (bool)(e.Value ?? false)))" />
                                    @col
                                </label>
                            }
                        </div>
                    </div>

                    @if (_crError != null) { <div class="pam-alert pam-alert-danger" style="margin-bottom:8px">@_crError</div> }
                    @if (_crSuccess != null) { <div class="pam-alert pam-alert-info" style="margin-bottom:8px">@_crSuccess</div> }

                    <div style="display:flex;gap:8px;flex-wrap:wrap">
                        <button class="pam-btn pam-btn-primary"
                                @onclick="PreviewReportAsync"
                                disabled="@_crRunning">
                            @(_crRunning ? "Running…" : "&#x1F50D; Preview (50 rows)")
                        </button>
                        <button class="pam-btn pam-btn-secondary"
                                @onclick="SaveReportAsync"
                                disabled="@(_crSaving || string.IsNullOrWhiteSpace(_crName))">
                            @(_crSaving ? "Saving…" : "&#x1F4BE; Save")
                        </button>
                        @if (_crResultRows.Count > 0)
                        {
                            <button class="pam-btn pam-btn-secondary" @onclick="ExportCustomCsvAsync">
                                &#x1F4C4; Export CSV
                            </button>
                        }
                    </div>
                </div>
            </div>

            @if (_crResultRows.Count > 0)
            {
                <div class="pam-card">
                    <div class="pam-card-body p-0">
                        <div style="padding:8px 12px;font-size:0.78em;color:#666;border-bottom:1px solid #f0f0f0">
                            @_crFilterSummary — @_crResultRows.Count rows
                        </div>
                        <div style="overflow-x:auto">
                            <table class="pam-table pam-table-hover" style="font-size:0.82em">
                                <thead>
                                    <tr>
                                        @foreach (var col in _crResultColumns)
                                        { <th>@FormatKey(col)</th> }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in _crResultRows)
                                    {
                                        <tr>
                                            @foreach (var col in _crResultColumns)
                                            { <td>@row.GetValueOrDefault(col, "—")</td> }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (_tab == "schedule")
{
    <div class="pam-card" style="margin-bottom:16px">
        <div class="pam-card-body">
            <h4 style="margin-bottom:12px">New Scheduled Report</h4>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
                <div>
                    <label class="pam-label">Schedule Name</label>
                    <input class="pam-input" placeholder="e.g. Weekly Checkout Report" @bind="_schName" />
                </div>
                <div>
                    <label class="pam-label">Report Type</label>
                    <select class="pam-input pam-select" @bind="_schReportType">
                        <option value="">— Select —</option>
                        <option value="checkout-history">Checkout History</option>
                        <option value="session-activity">Session Activity</option>
                        <option value="failed-logins">Failed Logins</option>
                        <option value="password-age">Password Age</option>
                        <option value="mfa-adoption">MFA Adoption</option>
                        <option value="rotation-compliance">Rotation Compliance</option>
                        <option value="policy-compliance">Policy Compliance</option>
                    </select>
                </div>
                <div>
                    <label class="pam-label">Frequency</label>
                    <select class="pam-input pam-select" @bind="_schFrequency">
                        <option value="daily">Daily</option>
                        <option value="weekly">Weekly</option>
                        <option value="monthly">Monthly</option>
                    </select>
                </div>
                <div>
                    <label class="pam-label">Run at Hour (UTC, 0-23)</label>
                    <input type="number" class="pam-input" min="0" max="23" @bind="_schHour" />
                </div>
                @if (_schFrequency == "weekly")
                {
                    <div>
                        <label class="pam-label">Day of Week</label>
                        <select class="pam-input pam-select" @bind="_schDayOfWeek">
                            <option value="0">Sunday</option>
                            <option value="1">Monday</option>
                            <option value="2">Tuesday</option>
                            <option value="3">Wednesday</option>
                            <option value="4">Thursday</option>
                            <option value="5">Friday</option>
                            <option value="6">Saturday</option>
                        </select>
                    </div>
                }
                @if (_schFrequency == "monthly")
                {
                    <div>
                        <label class="pam-label">Day of Month (1-28)</label>
                        <input type="number" class="pam-input" min="1" max="28" @bind="_schDayOfMonth" />
                    </div>
                }
                <div style="grid-column:1/-1">
                    <label class="pam-label">Recipients (semicolon-separated emails)</label>
                    <input class="pam-input" placeholder="admin@company.com;ciso@company.com" @bind="_schRecipients" />
                </div>
            </div>
            @if (_schError != null) { <div class="pam-alert pam-alert-danger" style="margin-top:8px">@_schError</div> }
            @if (_schSuccess != null) { <div class="pam-alert pam-alert-info" style="margin-top:8px">@_schSuccess</div> }
            <div style="margin-top:12px">
                <button class="pam-btn pam-btn-primary" @onclick="CreateScheduleAsync" disabled="@_schSaving">
                    @(_schSaving ? "Saving…" : "+ Create Schedule")
                </button>
            </div>
        </div>
    </div>

    @if (_schLoading)
    {
        <div class="pam-loading-text">Loading schedules…</div>
    }
    else if (_schedules == null || _schedules.Count == 0)
    {
        <div class="pam-alert pam-alert-info">No scheduled reports yet. Create one above.</div>
    }
    else
    {
        <div class="pam-card">
            <div class="pam-card-body p-0">
                <table class="pam-table pam-table-hover" style="font-size:0.85em">
                    <thead>
                        <tr>
                            <th>Name</th><th>Report Type</th><th>Frequency</th>
                            <th>Recipients</th><th>Status</th>
                            <th>Last Run</th><th>Next Run</th><th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _schedules)
                        {
                            <tr>
                                <td>@s.Name</td>
                                <td><span class="pam-badge">@s.ReportType</span></td>
                                <td>@FormatFrequency(s)</td>
                                <td style="max-width:150px;overflow:hidden;text-overflow:ellipsis" title="@s.Recipients">@s.Recipients</td>
                                <td>
                                    @if (s.IsActive)
                                    { <span class="pam-status pam-status-active">Active</span> }
                                    else
                                    { <span class="pam-status pam-status-warn">Paused</span> }
                                    @if (!string.IsNullOrEmpty(s.LastRunStatus))
                                    { <span class="pam-badge" style="margin-left:4px">@s.LastRunStatus</span> }
                                </td>
                                <td>@(s.LastRunAtUtc?.ToLocalTime().ToString("MM/dd HH:mm") ?? "—")</td>
                                <td>@(s.NextRunAtUtc?.ToLocalTime().ToString("MM/dd HH:mm") ?? "—")</td>
                                <td>
                                    <button class="pam-btn pam-btn-secondary pam-btn-sm"
                                            @onclick="@(() => RunNowAsync(s.Id))">▶ Run</button>
                                    <button class="pam-btn pam-btn-secondary pam-btn-sm"
                                            @onclick="@(() => ToggleActiveAsync(s))">
                                        @(s.IsActive ? "Pause" : "Resume")
                                    </button>
                                    <button class="pam-btn pam-btn-secondary pam-btn-sm"
                                            style="color:#dc3545"
                                            @onclick="@(() => DeleteScheduleAsync(s.Id))">✕</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@if (_tab == "compliance")
{
    <div class="pam-card" style="margin-bottom:16px">
        <div class="pam-card-body">
            <div style="display:flex;gap:16px;align-items:center;flex-wrap:wrap">
                <div>
                    <label class="pam-label">Framework</label>
                    <select class="pam-input pam-select" style="width:220px" @bind="_cmpFramework">
                        <option value="sox">SOX PAM Controls</option>
                        <option value="pci-dss">PCI-DSS (Chapter 7/8/10)</option>
                        <option value="iso27001">ISO 27001 (A.9 / A.12)</option>
                    </select>
                </div>
                <div>
                    <label class="pam-label">Period</label>
                    <select class="pam-input pam-select" style="width:140px" @bind="_cmpPeriodDays">
                        <option value="30">Last 30 days</option>
                        <option value="90">Last 90 days</option>
                        <option value="180">Last 180 days</option>
                        <option value="365">Last 365 days</option>
                    </select>
                </div>
                <div style="align-self:flex-end">
                    <button class="pam-btn pam-btn-primary" @onclick="RunComplianceReportAsync"
                            disabled="@_cmpLoading">
                        @(_cmpLoading ? "Evaluating…" : "Evaluate Controls")
                    </button>
                </div>
                @if (_cmpReport != null)
                {
                    <div style="align-self:flex-end">
                        <button class="pam-btn pam-btn-secondary" @onclick="ExportComplianceHtmlAsync">
                            &#x1F4BE; Download Auditor Report
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

    @if (_cmpError != null)
    {
        <div class="pam-alert pam-alert-danger">@_cmpError</div>
    }

    @if (_cmpReport != null)
    {
        var passCount    = _cmpReport.Summary.Passed;
        var partialCount = _cmpReport.Summary.Partial;
        var failCount    = _cmpReport.Summary.Failed;
        var score        = _cmpReport.Summary.Score;
        var statusColor  = score >= 90 ? "#28a745" : score >= 70 ? "#ffc107" : "#dc3545";

        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px;margin-bottom:20px">
            <div class="pam-card">
                <div class="pam-card-body" style="text-align:center">
                    <div style="font-size:2em;font-weight:700;color:@statusColor">@score%</div>
                    <div style="font-size:0.8em;color:#888">Compliance Score</div>
                    <div style="font-size:0.85em;font-weight:600;color:@statusColor;margin-top:4px">@_cmpReport.Summary.OverallStatus</div>
                </div>
            </div>
            <div class="pam-card">
                <div class="pam-card-body" style="text-align:center">
                    <div style="font-size:2em;font-weight:700;color:#28a745">@passCount</div>
                    <div style="font-size:0.8em;color:#888">Passed</div>
                </div>
            </div>
            <div class="pam-card">
                <div class="pam-card-body" style="text-align:center">
                    <div style="font-size:2em;font-weight:700;color:#ffc107">@partialCount</div>
                    <div style="font-size:0.8em;color:#888">Partial</div>
                </div>
            </div>
            <div class="pam-card">
                <div class="pam-card-body" style="text-align:center">
                    <div style="font-size:2em;font-weight:700;color:#dc3545">@failCount</div>
                    <div style="font-size:0.8em;color:#888">Failed</div>
                </div>
            </div>
        </div>

        <div style="font-size:0.8em;color:#888;margin-bottom:8px">
            @_cmpReport.FrameworkName &mdash;
            @_cmpReport.Period.From.ToString("yyyy-MM-dd") to @_cmpReport.Period.To.ToString("yyyy-MM-dd") &mdash;
            Generated @_cmpReport.GeneratedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
        </div>

        @foreach (var ctrl in _cmpReport.Controls)
        {
            var icon  = ctrl.Status == "pass" ? "✅" : ctrl.Status == "partial" ? "⚠️" : "❌";
            var color = ctrl.Status == "pass" ? "#d4edda" : ctrl.Status == "partial" ? "#fff3cd" : "#f8d7da";
            var border= ctrl.Status == "pass" ? "#28a745" : ctrl.Status == "partial" ? "#ffc107" : "#dc3545";

            <div style="border-left:4px solid @border;background:@color;border-radius:4px;padding:12px 16px;margin-bottom:10px">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:4px">
                    <span style="font-size:1.1em">@icon</span>
                    <strong>@ctrl.Code</strong>
                    <span style="color:#555">@ctrl.Name</span>
                    <span style="margin-left:auto;font-size:0.75em;color:#888">@ctrl.Reference</span>
                </div>
                <div style="font-size:0.88em;color:#333;margin-bottom:8px">@ctrl.Finding</div>
                @if (ctrl.Evidence != null && ctrl.Evidence.Count > 0)
                {
                    <div style="display:flex;gap:8px;flex-wrap:wrap">
                        @foreach (var ev in ctrl.Evidence)
                        {
                            <span style="background:rgba(0,0,0,0.07);border-radius:4px;padding:2px 8px;font-size:0.78em">
                                @FormatKey(ev.Key): <strong>@ev.Value</strong>
                            </span>
                        }
                    </div>
                }
            </div>
        }
    }
    else if (!_cmpLoading)
    {
        <div class="pam-alert pam-alert-info">
            Select a framework and period, then click "Evaluate Controls" to generate the compliance report.
        </div>
    }
}

@code {
    private string _tab = "audit";
    private AuditVerifyResult? _integrityResult;

    // ---- Audit Log state ----
    private string   _preset           = "7d";
    private DateTime _customFrom       = DateTime.Today.AddDays(-7);
    private DateTime _customTo         = DateTime.Today;
    private string   _auditCategory    = "";
    private string   _auditEventFilter = "";
    private int      _auditPage        = 1;
    private const int _auditPageSize   = 50;
    private bool     _auditLoading;
    private string?  _auditError;
    private List<AuditLogDto>? _auditLogs;
    private PageMeta? _auditMeta;
    private int AuditTotalPages =>
        _auditMeta == null ? 1 : (int)Math.Ceiling(_auditMeta.TotalCount / (double)_auditPageSize);

    // ---- Reports state ----
    private string   _reportPreset = "30d";
    private DateTime _reportFrom   = DateTime.Today.AddDays(-30);
    private DateTime _reportTo     = DateTime.Today;
    private bool     _reportsLoading;
    private string?  _reportError;
    private List<ReportDto>? _reports;
    private ReportDto?       _selectedReport;
    private string?          _runningReport;
    private ReportRunResult? _reportResult;
    private List<(string Key, string Value)> _reportSummary  = [];
    private List<string>                     _reportColumns  = [];
    private List<Dictionary<string, string>> _reportRows     = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAuditAsync();
        await LoadReportsAsync();
    }

    // ---- Compliance state ----
    private string               _cmpFramework  = "sox";
    private int                  _cmpPeriodDays = 90;
    private bool                 _cmpLoading;
    private string?              _cmpError;
    private ComplianceReportResultDto? _cmpReport;

    private async Task SetTab(string tab)
    {
        _tab = tab;
        if (tab == "schedule" && _schedules == null)
            await LoadSchedulesAsync();
        if (tab == "custom" && _crSavedReports == null)
            await LoadCustomReportsAsync();
    }

    private async Task ApplyPreset(string preset)
    {
        _preset = preset;
        _auditPage = 1;
        await LoadAuditAsync();
    }

    private DateTime GetAuditFrom() => _preset switch
    {
        "1d"    => DateTime.UtcNow.AddDays(-1),
        "7d"    => DateTime.UtcNow.AddDays(-7),
        "30d"   => DateTime.UtcNow.AddDays(-30),
        "custom" => _customFrom.ToUniversalTime(),
        _       => DateTime.UtcNow.AddDays(-7)
    };

    private DateTime GetAuditTo() =>
        _preset == "custom" ? _customTo.AddDays(1).ToUniversalTime() : DateTime.UtcNow;

    private async Task LoadAuditAsync()
    {
        _auditLoading = true; _auditError = null; StateHasChanged();
        var result = await Api.GetAuditLogsAsync(
            category: string.IsNullOrEmpty(_auditCategory) ? null : _auditCategory,
            eventType: string.IsNullOrEmpty(_auditEventFilter) ? null : _auditEventFilter,
            from: GetAuditFrom(), to: GetAuditTo(),
            page: _auditPage, pageSize: _auditPageSize);
        if (result == null) _auditError = "Failed to load audit log.";
        else { _auditLogs = result.Data; _auditMeta = result.Meta; }
        _auditLoading = false; StateHasChanged();
    }

    private async Task AuditPrevPage() { _auditPage--; await LoadAuditAsync(); }
    private async Task AuditNextPage() { _auditPage++; await LoadAuditAsync(); }

    private static string SanitizeCsvCell(string? value)
    {
        if (string.IsNullOrEmpty(value)) return "";
        if (value[0] is '=' or '+' or '-' or '@' or '\t' or '\r')
            value = "'" + value;
        return value.Replace("\"", "\"\"");
    }

    private async Task ExportAuditCsvAsync()
    {
        var result = await Api.GetAuditLogsAsync(
            category: string.IsNullOrEmpty(_auditCategory) ? null : _auditCategory,
            eventType: string.IsNullOrEmpty(_auditEventFilter) ? null : _auditEventFilter,
            from: GetAuditFrom(), to: GetAuditTo(), pageSize: 5000);
        if (result?.Data == null || result.Data.Count == 0) return;

        var sb = new StringBuilder();
        sb.AppendLine("Timestamp,Actor,IP,Category,Event,Target,Outcome,Details");
        foreach (var log in result.Data)
        {
            var target = log.TargetId != null
                ? (log.TargetType + ":" + log.TargetId)
                : (log.TargetType ?? "");
            sb.AppendLine(
                "\"" + log.Timestamp.ToLocalTime().ToString("O") + "\"," +
                "\"" + SanitizeCsvCell(log.ActorUsername) + "\"," +
                "\"" + SanitizeCsvCell(log.ActorIpAddress) + "\"," +
                "\"" + SanitizeCsvCell(log.EventCategory) + "\"," +
                "\"" + SanitizeCsvCell(log.EventType) + "\"," +
                "\"" + SanitizeCsvCell(target) + "\"," +
                "\"" + SanitizeCsvCell(log.Outcome.ToString()) + "\"," +
                "\"" + SanitizeCsvCell(log.Details) + "\"");
        }
        await JS.InvokeVoidAsync("downloadCsvFile",
            "audit-log-" + DateTime.Now.ToString("yyyyMMdd") + ".csv", sb.ToString());
    }

    private async Task VerifyIntegrityAsync()
    {
        _integrityResult = null; StateHasChanged();
        _integrityResult = await Api.VerifyAuditIntegrityAsync();
        if (_integrityResult != null && !_integrityResult.IntegrityValid)
            await LoadAuditAsync();
        StateHasChanged();
    }

    private static string OutcomeClass(string outcome) => outcome switch
    {
        "Success" => "pam-status-active",
        "Failure" => "pam-status-error",
        _         => "pam-status-warn"
    };

    private async Task LoadReportsAsync()
    {
        _reportsLoading = true; StateHasChanged();
        var result = await Api.GetReportsListAsync();
        _reports = result?.Data ?? [];
        _reportsLoading = false; StateHasChanged();
    }

    private DateTime GetReportFrom() => _reportPreset switch
    {
        "1d"    => DateTime.UtcNow.AddDays(-1),
        "7d"    => DateTime.UtcNow.AddDays(-7),
        "30d"   => DateTime.UtcNow.AddDays(-30),
        "custom" => _reportFrom.ToUniversalTime(),
        _       => DateTime.UtcNow.AddDays(-30)
    };

    private DateTime GetReportTo() =>
        _reportPreset == "custom" ? _reportTo.AddDays(1).ToUniversalTime() : DateTime.UtcNow;

    private async Task RunReportAsync(ReportDto report)
    {
        _selectedReport = report;
        _runningReport  = report.Id;
        _reportError    = null;
        _reportResult   = null;
        _reportSummary.Clear();
        _reportColumns.Clear();
        _reportRows.Clear();
        StateHasChanged();

        var result = await Api.RunReportAsync(report.Id, GetReportFrom(), GetReportTo());
        _runningReport = null;
        if (result == null)
            _reportError = "Failed to run report or it is not yet implemented.";
        else
        {
            _reportResult = result;
            ProcessReportResult(result);
        }
        StateHasChanged();
    }

    private void CloseReport() { _reportResult = null; _selectedReport = null; }

    private string CardOutline(string id) =>
        _selectedReport?.Id == id ? "2px solid #3b82f6" : "none";

    private void ProcessReportResult(ReportRunResult result)
    {
        if (result.Data.ValueKind != JsonValueKind.Object) return;
        foreach (var prop in result.Data.EnumerateObject())
        {
            if (prop.Value.ValueKind is JsonValueKind.String or JsonValueKind.Number
                    or JsonValueKind.True or JsonValueKind.False)
            {
                _reportSummary.Add((FormatKey(prop.Name), FormatValue(prop.Value)));
            }
            else if (prop.Value.ValueKind == JsonValueKind.Array && _reportRows.Count == 0)
            {
                var arr = prop.Value.EnumerateArray().ToList();
                if (arr.Count > 0 && arr[0].ValueKind == JsonValueKind.Object)
                {
                    _reportColumns = arr[0].EnumerateObject().Select(p => p.Name).ToList();
                    foreach (var item in arr)
                    {
                        var row = new Dictionary<string, string>();
                        foreach (var col in _reportColumns)
                            if (item.TryGetProperty(col, out var v))
                                row[col] = FormatValue(v);
                        _reportRows.Add(row);
                    }
                }
            }
            else if (prop.Value.ValueKind == JsonValueKind.Object)
            {
                foreach (var sub in prop.Value.EnumerateObject())
                    if (sub.Value.ValueKind is JsonValueKind.String or JsonValueKind.Number
                            or JsonValueKind.True or JsonValueKind.False)
                        _reportSummary.Add((FormatKey(prop.Name) + " / " + FormatKey(sub.Name), FormatValue(sub.Value)));
            }
        }
    }

    private static string FormatKey(string name)
    {
        var sb = new StringBuilder();
        foreach (var c in name)
        {
            if (char.IsUpper(c) && sb.Length > 0) sb.Append(' ');
            sb.Append(sb.Length == 0 ? char.ToUpper(c) : c);
        }
        return sb.ToString();
    }

    private static string FormatValue(JsonElement v) => v.ValueKind switch
    {
        JsonValueKind.True  => "Yes",
        JsonValueKind.False => "No",
        JsonValueKind.Null  => "—",
        JsonValueKind.Number => v.TryGetDouble(out var d)
            ? (d % 1 == 0 ? ((long)d).ToString() : d.ToString("F2"))
            : v.ToString(),
        _ => v.ToString()
    };

    private async Task ExportReportCsvAsync()
    {
        if (_reportColumns.Count == 0 || _reportRows.Count == 0) return;
        var sb = new StringBuilder();
        sb.AppendLine(string.Join(",", _reportColumns.Select(c => "\"" + c + "\"") ));
        foreach (var row in _reportRows)
            sb.AppendLine(string.Join(",", _reportColumns.Select(c =>
                "\"" + SanitizeCsvCell(row.GetValueOrDefault(c, "")) + "\"")));
        var filename = (_selectedReport?.Id ?? "report") + "-" + DateTime.Now.ToString("yyyyMMdd") + ".csv";
        await JS.InvokeVoidAsync("downloadCsvFile", filename, sb.ToString());
    }

    // ---- Schedule tab state ----
    private bool    _schLoading;
    private bool    _schSaving;
    private string? _schError;
    private string? _schSuccess;
    private string  _schName       = "";
    private string  _schReportType = "";
    private string  _schFrequency  = "daily";
    private int     _schHour       = 8;
    private int     _schDayOfWeek  = 1;
    private int     _schDayOfMonth = 1;
    private string  _schRecipients = "";
    private List<ReportScheduleDto>? _schedules;

    private async Task LoadSchedulesAsync()
    {
        _schLoading = true; StateHasChanged();
        var result = await Api.GetReportSchedulesAsync();
        _schedules = result?.Data ?? [];
        _schLoading = false; StateHasChanged();
    }

    private async Task CreateScheduleAsync()
    {
        _schError = null; _schSuccess = null;
        if (string.IsNullOrWhiteSpace(_schName))         { _schError = "Name is required."; return; }
        if (string.IsNullOrWhiteSpace(_schReportType))   { _schError = "Report type is required."; return; }
        if (string.IsNullOrWhiteSpace(_schRecipients))   { _schError = "At least one recipient is required."; return; }

        _schSaving = true; StateHasChanged();
        var ok = await Api.CreateReportScheduleAsync(new CreateReportScheduleDto(
            _schName, _schReportType, _schFrequency,
            _schDayOfWeek, _schDayOfMonth, _schHour, "csv", _schRecipients));

        if (ok)
        {
            _schSuccess = "Schedule created. First run at next scheduled time.";
            _schName = ""; _schReportType = ""; _schRecipients = "";
            await LoadSchedulesAsync();
        }
        else
        {
            _schError = "Failed to create schedule.";
        }
        _schSaving = false; StateHasChanged();
    }

    private async Task ToggleActiveAsync(ReportScheduleDto s)
    {
        await Api.UpdateReportScheduleAsync(s.Id, new UpdateReportScheduleDto(IsActive: !s.IsActive));
        await LoadSchedulesAsync();
    }

    private async Task RunNowAsync(string id)
    {
        await Api.RunReportScheduleNowAsync(id);
        _schSuccess = "Report queued — will be delivered within 60 seconds.";
        StateHasChanged();
    }

    private async Task DeleteScheduleAsync(string id)
    {
        await Api.DeleteReportScheduleAsync(id);
        await LoadSchedulesAsync();
    }

    private static string FormatFrequency(ReportScheduleDto s)
    {
        var dayNames = new[] { "Sun","Mon","Tue","Wed","Thu","Fri","Sat" };
        return s.Frequency switch
        {
            "weekly"  => "Weekly " + (s.DayOfWeek >= 0 && s.DayOfWeek < 7 ? dayNames[s.DayOfWeek] : s.DayOfWeek.ToString()) + " " + s.RunAtHourUtc.ToString("D2") + ":00 UTC",
            "monthly" => "Monthly day " + s.DayOfMonth + " " + s.RunAtHourUtc.ToString("D2") + ":00 UTC",
            _         => "Daily " + s.RunAtHourUtc.ToString("D2") + ":00 UTC"
        };
    }

    // ---- Custom Report Builder (#169) ----

    private static readonly Dictionary<string, string[]> _srcCols = new()
    {
        ["AuditLogs"]   = ["Timestamp","EventCategory","EventType","ActorUsername","ActorIpAddress","TargetType","TargetId","Outcome","Details"],
        ["Sessions"]    = ["Id","UserId","SessionType","Status","TargetIpAddress","TargetPort","StartedAtUtc","EndedAtUtc","DurationSeconds","RiskScore","Reason","TicketNumber"],
        ["Credentials"] = ["Id","Name","Username","DeviceId","CredentialType","Status","LastRotatedAtUtc","NextRotationAtUtc","RequiresApproval","IsDiscovered"],
        ["Users"]       = ["Id","Username","DisplayName","Email","Status","MfaEnabled","LastLoginAtUtc","CreatedAtUtc","IsTemporary"]
    };

    private static string[] DefaultColsFor(string src) => src switch
    {
        "Sessions"    => ["StartedAtUtc","SessionType","Status","TargetIpAddress","DurationSeconds","RiskScore"],
        "Credentials" => ["Name","Username","CredentialType","Status","LastRotatedAtUtc"],
        "Users"       => ["Username","DisplayName","Email","Status","MfaEnabled","LastLoginAtUtc"],
        _             => ["Timestamp","EventCategory","EventType","ActorUsername","Outcome"]
    };

    private IEnumerable<string> GetAvailableCols() =>
        _srcCols.TryGetValue(_crDataSource, out var c) ? c : _srcCols["AuditLogs"];

    private bool   _crLoading;
    private bool   _crRunning;
    private bool   _crSaving;
    private string? _crError;
    private string? _crSuccess;

    private string  _crName           = "";
    private string  _crDataSource     = "AuditLogs";
    private DateTime _crDateFrom      = DateTime.Today.AddDays(-30);
    private DateTime _crDateTo        = DateTime.Today;
    private string  _crFilterUsername = "";
    private string  _crFilterCategory = "";
    private string  _crFilterEventType= "";
    private string  _crFilterOutcome  = "";
    private string  _crFilterProtocol = "";
    private int?    _crFilterMinRisk;
    private int?    _crFilterMaxRisk;
    private string  _crFilterCredType   = "";
    private string  _crFilterCredStatus = "";
    private string  _crFilterUserStatus = "";
    private string  _crFilterMfaEnabled = "";
    private HashSet<string> _crSelectedColumns = new(["Timestamp","EventCategory","EventType","ActorUsername","Outcome"]);

    private List<string> _crResultColumns = [];
    private List<Dictionary<string, string>> _crResultRows = [];
    private string _crFilterSummary = "";

    private List<CustomReportDefinitionDto>? _crSavedReports;

    private void OnDataSourceChanged(string src)
    {
        _crDataSource = src;
        _crSelectedColumns = new HashSet<string>(DefaultColsFor(src));
        _crResultColumns = [];
        _crResultRows = [];
        _crError = null; _crSuccess = null;
    }

    private void ToggleColumn(string col, bool selected)
    {
        if (selected) _crSelectedColumns.Add(col);
        else _crSelectedColumns.Remove(col);
    }

    private void StartNewReport()
    {
        _crName = ""; _crDataSource = "AuditLogs";
        _crDateFrom = DateTime.Today.AddDays(-30); _crDateTo = DateTime.Today;
        _crFilterUsername = ""; _crFilterCategory = ""; _crFilterEventType = "";
        _crFilterOutcome = ""; _crFilterProtocol = ""; _crFilterMinRisk = null;
        _crFilterMaxRisk = null; _crFilterCredType = ""; _crFilterCredStatus = "";
        _crFilterUserStatus = ""; _crFilterMfaEnabled = "";
        _crSelectedColumns = new HashSet<string>(DefaultColsFor("AuditLogs"));
        _crResultColumns = []; _crResultRows = [];
        _crError = null; _crSuccess = null;
    }

    private void SelectSavedReport(CustomReportDefinitionDto cr)
    {
        _crName = cr.Name;
        _crDataSource = cr.DataSource;
        LoadFiltersFromJson(cr.FiltersJson);
        LoadColumnsFromJson(cr.ColumnsJson);
        _crResultColumns = []; _crResultRows = [];
        _crError = null; _crSuccess = null;
    }

    private void LoadFiltersFromJson(string json)
    {
        try
        {
            using var doc = JsonDocument.Parse(json);
            var r = doc.RootElement;
            if (r.TryGetProperty("dateFrom", out var df) && df.ValueKind == JsonValueKind.String && DateTime.TryParse(df.GetString(), out var dfp)) _crDateFrom = dfp;
            if (r.TryGetProperty("dateTo", out var dt) && dt.ValueKind == JsonValueKind.String && DateTime.TryParse(dt.GetString(), out var dtp)) _crDateTo = dtp;
            _crFilterUsername    = r.TryGetProperty("username",        out var u)   ? u.GetString()  ?? "" : "";
            _crFilterCategory    = r.TryGetProperty("eventCategory",   out var ec)  ? ec.GetString() ?? "" : "";
            _crFilterEventType   = r.TryGetProperty("eventType",       out var et)  ? et.GetString() ?? "" : "";
            _crFilterOutcome     = r.TryGetProperty("outcome",         out var oc)  ? oc.GetString() ?? "" : "";
            _crFilterProtocol    = r.TryGetProperty("protocol",        out var pt)  ? pt.GetString() ?? "" : "";
            _crFilterCredType    = r.TryGetProperty("credentialType",  out var crt) ? crt.GetString() ?? "" : "";
            _crFilterCredStatus  = r.TryGetProperty("credentialStatus",out var cs)  ? cs.GetString() ?? "" : "";
            _crFilterUserStatus  = r.TryGetProperty("userStatus",      out var us)  ? us.GetString() ?? "" : "";
            _crFilterMinRisk     = r.TryGetProperty("minRiskScore", out var mr) && mr.ValueKind == JsonValueKind.Number ? mr.GetInt32() : null;
            _crFilterMaxRisk     = r.TryGetProperty("maxRiskScore", out var xr) && xr.ValueKind == JsonValueKind.Number ? xr.GetInt32() : null;
            if (r.TryGetProperty("mfaEnabled", out var mfa) && mfa.ValueKind == JsonValueKind.True)
                _crFilterMfaEnabled = "yes";
            else if (r.TryGetProperty("mfaEnabled", out var mfa2) && mfa2.ValueKind == JsonValueKind.False)
                _crFilterMfaEnabled = "no";
            else _crFilterMfaEnabled = "";
        }
        catch { }
    }

    private void LoadColumnsFromJson(string json)
    {
        try
        {
            var cols = JsonSerializer.Deserialize<List<string>>(json);
            _crSelectedColumns = cols != null && cols.Count > 0
                ? new HashSet<string>(cols)
                : new HashSet<string>(DefaultColsFor(_crDataSource));
        }
        catch { }
    }

    private string BuildFiltersJson()
    {
        var d = new Dictionary<string, object>();
        d["dateFrom"] = _crDateFrom;
        d["dateTo"]   = _crDateTo;
        if (!string.IsNullOrWhiteSpace(_crFilterUsername))    d["username"]        = _crFilterUsername;
        if (!string.IsNullOrWhiteSpace(_crFilterCategory))    d["eventCategory"]   = _crFilterCategory;
        if (!string.IsNullOrWhiteSpace(_crFilterEventType))   d["eventType"]       = _crFilterEventType;
        if (!string.IsNullOrWhiteSpace(_crFilterOutcome))     d["outcome"]         = _crFilterOutcome;
        if (!string.IsNullOrWhiteSpace(_crFilterProtocol))    d["protocol"]        = _crFilterProtocol;
        if (_crFilterMinRisk.HasValue)                        d["minRiskScore"]    = _crFilterMinRisk.Value;
        if (_crFilterMaxRisk.HasValue)                        d["maxRiskScore"]    = _crFilterMaxRisk.Value;
        if (!string.IsNullOrWhiteSpace(_crFilterCredType))    d["credentialType"]  = _crFilterCredType;
        if (!string.IsNullOrWhiteSpace(_crFilterCredStatus))  d["credentialStatus"]= _crFilterCredStatus;
        if (!string.IsNullOrWhiteSpace(_crFilterUserStatus))  d["userStatus"]      = _crFilterUserStatus;
        if (!string.IsNullOrWhiteSpace(_crFilterMfaEnabled))  d["mfaEnabled"]      = _crFilterMfaEnabled == "yes";
        return JsonSerializer.Serialize(d);
    }

    private string BuildColumnsJson() => JsonSerializer.Serialize(_crSelectedColumns.ToList());

    private async Task LoadCustomReportsAsync()
    {
        _crLoading = true; StateHasChanged();
        _crSavedReports = await Api.GetCustomReportsAsync();
        _crLoading = false; StateHasChanged();
    }

    private async Task PreviewReportAsync()
    {
        if (_crSelectedColumns.Count == 0) { _crError = "Select at least one column."; return; }
        _crRunning = true; _crError = null; _crSuccess = null; StateHasChanged();
        var result = await Api.PreviewCustomReportAsync(_crDataSource, BuildFiltersJson(), BuildColumnsJson(), 50);
        _crRunning = false;
        if (result == null)
            _crError = "Preview failed. Check server logs.";
        else
        {
            _crResultColumns = result.Columns;
            _crResultRows    = result.Rows;
            _crFilterSummary = result.FilterSummary;
        }
        StateHasChanged();
    }

    private async Task SaveReportAsync()
    {
        if (string.IsNullOrWhiteSpace(_crName)) { _crError = "Report name is required."; return; }
        _crSaving = true; _crError = null; _crSuccess = null; StateHasChanged();
        var ok = await Api.SaveCustomReportAsync(_crName, null, _crDataSource, BuildFiltersJson(), BuildColumnsJson());
        _crSaving = false;
        if (ok) { _crSuccess = "Report saved."; await LoadCustomReportsAsync(); }
        else _crError = "Failed to save report.";
        StateHasChanged();
    }

    private async Task RunSavedReportAsync(string id)
    {
        _crRunning = true; _crError = null; StateHasChanged();
        var result = await Api.RunSavedCustomReportAsync(id);
        _crRunning = false;
        if (result == null) _crError = "Failed to run report.";
        else
        {
            _crResultColumns = result.Columns;
            _crResultRows    = result.Rows;
            _crFilterSummary = result.FilterSummary;
        }
        StateHasChanged();
    }

    private async Task DeleteSavedReportAsync(string id)
    {
        var ok = await Api.DeleteCustomReportAsync(id);
        if (ok) await LoadCustomReportsAsync();
        StateHasChanged();
    }

    private async Task ExportCustomCsvAsync()
    {
        if (_crResultColumns.Count == 0 || _crResultRows.Count == 0) return;
        var sb = new StringBuilder();
        sb.AppendLine("# " + _crFilterSummary);
        sb.AppendLine(string.Join(",", _crResultColumns.Select(c => "\"" + c + "\"") ));
        foreach (var row in _crResultRows)
            sb.AppendLine(string.Join(",", _crResultColumns.Select(c =>
                "\"" + SanitizeCsvCell(row.GetValueOrDefault(c, "")) + "\"")));
        var filename = (_crName.Length > 0 ? _crName : "custom-report") + "-" + DateTime.Now.ToString("yyyyMMdd") + ".csv";
        await JS.InvokeVoidAsync("downloadCsvFile", filename, sb.ToString());
    }

    // ── Compliance Report (#179) ──────────────────────────────────────────────────

    private async Task RunComplianceReportAsync()
    {
        _cmpLoading = true; _cmpError = null; _cmpReport = null; StateHasChanged();
        var from = DateTime.UtcNow.AddDays(-_cmpPeriodDays);
        var to   = DateTime.UtcNow;
        _cmpReport = await Api.GenerateComplianceReportAsync(_cmpFramework, from, to);
        if (_cmpReport == null) _cmpError = "Failed to generate compliance report. Check server logs.";
        _cmpLoading = false; StateHasChanged();
    }

    private async Task ExportComplianceHtmlAsync()
    {
        if (_cmpReport == null) return;
        var sb = new StringBuilder();
        sb.AppendLine("<!DOCTYPE html><html><head><meta charset=\"utf-8\">");
        sb.AppendLine("<title>" + System.Net.WebUtility.HtmlEncode(_cmpReport.FrameworkName) + " — Compliance Report</title>");
        sb.AppendLine("<style>body{font-family:Arial,sans-serif;margin:40px;color:#333}");
        sb.AppendLine("h1{color:#1a1a2e}table{border-collapse:collapse;width:100%}");
        sb.AppendLine("th,td{border:1px solid #ddd;padding:8px 12px;text-align:left}");
        sb.AppendLine("th{background:#f5f5f5}.pass{background:#d4edda}.partial{background:#fff3cd}.fail{background:#f8d7da}");
        sb.AppendLine(".score{font-size:2.5em;font-weight:bold}.summary-grid{display:flex;gap:24px;margin:16px 0}");
        sb.AppendLine(".kpi{text-align:center;border:1px solid #ddd;padding:12px 24px;border-radius:6px}");
        sb.AppendLine(".kpi-value{font-size:2em;font-weight:bold}.kpi-label{font-size:0.8em;color:#888}</style></head><body>");

        sb.AppendLine("<h1>" + System.Net.WebUtility.HtmlEncode(_cmpReport.FrameworkName) + "</h1>");
        sb.AppendLine("<p><strong>Period:</strong> " + _cmpReport.Period.From.ToString("yyyy-MM-dd") +
                      " to " + _cmpReport.Period.To.ToString("yyyy-MM-dd") + "</p>");
        sb.AppendLine("<p><strong>Generated:</strong> " + _cmpReport.GeneratedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm") + "</p>");

        var s = _cmpReport.Summary;
        var scoreColor = s.Score >= 90 ? "#28a745" : s.Score >= 70 ? "#e6a817" : "#dc3545";
        sb.AppendLine("<div class=\"summary-grid\">");
        sb.AppendLine("<div class=\"kpi\"><div class=\"kpi-value\" style=\"color:" + scoreColor + "\">" + s.Score + "%</div><div class=\"kpi-label\">Compliance Score</div><div style=\"font-weight:bold;color:" + scoreColor + "\">" + s.OverallStatus + "</div></div>");
        sb.AppendLine("<div class=\"kpi\"><div class=\"kpi-value\" style=\"color:#28a745\">" + s.Passed + "</div><div class=\"kpi-label\">Passed</div></div>");
        sb.AppendLine("<div class=\"kpi\"><div class=\"kpi-value\" style=\"color:#e6a817\">" + s.Partial + "</div><div class=\"kpi-label\">Partial</div></div>");
        sb.AppendLine("<div class=\"kpi\"><div class=\"kpi-value\" style=\"color:#dc3545\">" + s.Failed + "</div><div class=\"kpi-label\">Failed</div></div>");
        sb.AppendLine("</div>");

        sb.AppendLine("<h2>Control Assessment</h2>");
        sb.AppendLine("<table><thead><tr><th>Code</th><th>Control</th><th>Reference</th><th>Status</th><th>Finding</th><th>Evidence</th></tr></thead><tbody>");
        foreach (var ctrl in _cmpReport.Controls)
        {
            var cls   = ctrl.Status;
            var label = ctrl.Status == "pass" ? "PASS" : ctrl.Status == "partial" ? "PARTIAL" : "FAIL";
            var ev    = ctrl.Evidence != null
                ? string.Join("; ", ctrl.Evidence.Select(x => FormatKey(x.Key) + ": " + x.Value))
                : "";
            sb.AppendLine("<tr class=\"" + cls + "\"><td>" + ctrl.Code + "</td><td>" + System.Net.WebUtility.HtmlEncode(ctrl.Name) +
                          "</td><td>" + ctrl.Reference + "</td><td><strong>" + label + "</strong></td><td>" +
                          System.Net.WebUtility.HtmlEncode(ctrl.Finding) + "</td><td style=\"font-size:0.85em\">" +
                          System.Net.WebUtility.HtmlEncode(ev) + "</td></tr>");
        }
        sb.AppendLine("</tbody></table></body></html>");

        var filename = _cmpReport.Framework + "-compliance-" + DateTime.Now.ToString("yyyyMMdd") + ".html";
        await JS.InvokeVoidAsync("downloadCsvFile", filename, sb.ToString());
    }
