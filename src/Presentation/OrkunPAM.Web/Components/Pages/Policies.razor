@page "/policies"
@rendermode InteractiveServer
@inject PamApiService Api

<PageTitle>Policies — OrkunPAM</PageTitle>

<div class="pam-page-header">
    <h2 class="pam-page-title">Policies</h2>
    @if (_tab == "list")
    {
        <button class="pam-btn pam-btn-primary" @onclick="OpenAddModal">+ New Policy</button>
    }
</div>

<div class="pam-tabs" style="margin-bottom:1.5rem">
    <button class="pam-tab @(_tab=="list"?"pam-tab-active":"")"       @onclick="@(() => SwitchTab("list"))">Policy List</button>
    <button class="pam-tab @(_tab=="password"?"pam-tab-active":"")"   @onclick="@(() => SwitchTab("password"))">Password Policy</button>
    <button class="pam-tab @(_tab=="lockout"?"pam-tab-active":"")"    @onclick="@(() => SwitchTab("lockout"))">Account Lockout</button>
    <button class="pam-tab @(_tab=="session"?"pam-tab-active":"")"    @onclick="@(() => SwitchTab("session"))">Session Policy</button>
    <button class="pam-tab @(_tab=="mfa"?"pam-tab-active":"")"        @onclick="@(() => SwitchTab("mfa"))">MFA Policy</button>
    <button class="pam-tab @(_tab=="watermark"?"pam-tab-active":"")"    @onclick="@(() => SwitchTab("watermark"))">Watermark</button>
    <button class="pam-tab @(_tab=="adaptive-mfa"?"pam-tab-active":"")" @onclick="@(() => SwitchTab("adaptive-mfa"))">Adaptive MFA</button>
</div>

@if (_error != null)      { <div class="pam-alert pam-alert-danger">@_error</div> }
@if (_successMsg != null) { <div class="pam-alert pam-alert-success">@_successMsg</div> }

@if (_tab == "list")
{
    <div class="pam-filters">
        <select class="pam-input pam-select" @bind="_typeFilter" @bind:after="LoadPoliciesAsync">
            <option value="">All Types</option>
            <option value="Password">Password</option>
            <option value="Session">Session</option>
            <option value="Access">Access</option>
            <option value="MFA">MFA</option>
        </select>
    </div>

    <div class="pam-card">
        <div class="pam-card-body p-0">
            @if (_loading)
            {
                <div class="pam-loading-text p-4">Loading policies…</div>
            }
            else if (_policies == null || _policies.Count == 0)
            {
                <div class="pam-empty p-4">No policies defined. Create your first policy to enforce access controls.</div>
            }
            else
            {
                <table class="pam-table pam-table-hover">
                    <thead>
                        <tr>
                            <th>Name</th><th>Type</th><th>Scope</th><th>Priority</th><th>Status</th><th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _policies)
                        {
                            <tr>
                                <td><strong>@p.Name</strong></td>
                                <td><span class="pam-badge">@p.PolicyType</span></td>
                                <td><span class="pam-badge pam-badge-secondary">@p.Scope</span></td>
                                <td>@p.Priority</td>
                                <td>
                                    @if (p.IsEnabled) { <span class="pam-status pam-status-active">Enabled</span> }
                                    else              { <span class="pam-status pam-status-done">Disabled</span> }
                                </td>
                                <td>
                                    <div class="pam-actions">
                                        @if (p.IsEnabled)
                                        {
                                            <button class="pam-btn-icon" title="Disable"
                                                    @onclick="@(() => ToggleAsync(p.Id, false))">&#9646;</button>
                                        }
                                        else
                                        {
                                            <button class="pam-btn-icon pam-btn-success" title="Enable"
                                                    @onclick="@(() => ToggleAsync(p.Id, true))">&#9654;</button>
                                        }
                                        <button class="pam-btn-icon pam-btn-danger" title="Delete"
                                                @onclick="@(() => ConfirmDelete(p))">&#128465;</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@if (_tab == "password")
{
    <div class="pam-card" style="max-width:640px">
        <div class="pam-card-header"><strong>Password Complexity &amp; Lifetime</strong></div>
        <div class="pam-card-body">
            @if (_pwdLoading)
            {
                <div class="pam-loading-text">Loading…</div>
            }
            else
            {
                <div class="pam-form-row">
                    <div class="pam-form-group" style="flex:1">
                        <label class="pam-label">Min length</label>
                        <input type="number" class="pam-input" style="width:100%" min="1" max="128" @bind="_pwdMinLen" />
                    </div>
                    <div class="pam-form-group" style="flex:1">
                        <label class="pam-label">Max length</label>
                        <input type="number" class="pam-input" style="width:100%" min="1" max="256" @bind="_pwdMaxLen" />
                    </div>
                    <div class="pam-form-group" style="flex:1">
                        <label class="pam-label">Expiry (days, 0=never)</label>
                        <input type="number" class="pam-input" style="width:100%" min="0" @bind="_pwdExpiryDays" />
                    </div>
                </div>
                <div class="pam-form-row" style="flex-wrap:wrap;gap:.5rem 1.5rem;margin-bottom:.75rem">
                    <label class="pam-checkbox-label">
                        <input type="checkbox" @bind="_pwdReqUpper" /> Require uppercase
                    </label>
                    <label class="pam-checkbox-label">
                        <input type="checkbox" @bind="_pwdReqLower" /> Require lowercase
                    </label>
                    <label class="pam-checkbox-label">
                        <input type="checkbox" @bind="_pwdReqDigit" /> Require digit
                    </label>
                    <label class="pam-checkbox-label">
                        <input type="checkbox" @bind="_pwdReqSpecial" /> Require special char
                    </label>
                    <label class="pam-checkbox-label">
                        <input type="checkbox" @bind="_pwdForceChange" /> Force change on first login
                    </label>
                </div>
                <div class="pam-form-group" style="max-width:220px">
                    <label class="pam-label">Prevent reuse (last N passwords, 0=off)</label>
                    <input type="number" class="pam-input" style="width:100%" min="0" max="24" @bind="_pwdReuseCount" />
                </div>
                <div style="margin-top:1rem">
                    <button class="pam-btn pam-btn-primary" @onclick="SavePasswordPolicyAsync" disabled="@_pwdSaving">
                        @if (_pwdSaving) { <span class="pam-spinner-sm"></span> } Save
                    </button>
                </div>
            }
        </div>
    </div>
}

@if (_tab == "lockout")
{
    <div class="pam-card" style="max-width:480px">
        <div class="pam-card-header"><strong>Account Lockout Policy</strong></div>
        <div class="pam-card-body">
            @if (_lockLoading)
            {
                <div class="pam-loading-text">Loading…</div>
            }
            else
            {
                <div class="pam-form-group">
                    <label class="pam-label">Max failed attempts before lockout</label>
                    <input type="number" class="pam-input" style="width:180px" min="1" max="20" @bind="_lockMaxAttempts" />
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Lockout duration (minutes, 0=until admin reset)</label>
                    <input type="number" class="pam-input" style="width:180px" min="0" @bind="_lockDurationMin" />
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Failed-attempt counter reset window (minutes)</label>
                    <input type="number" class="pam-input" style="width:180px" min="1" @bind="_lockWindowMin" />
                </div>
                <div style="margin-top:1rem">
                    <button class="pam-btn pam-btn-primary" @onclick="SaveLockoutPolicyAsync" disabled="@_lockSaving">
                        @if (_lockSaving) { <span class="pam-spinner-sm"></span> } Save
                    </button>
                </div>
            }
        </div>
    </div>
}

@if (_tab == "session")
{
    <div class="pam-card" style="max-width:600px">
        <div class="pam-card-header"><strong>Session Policy</strong></div>
        <div class="pam-card-body">
            @if (_sessLoading)
            {
                <div class="pam-loading-text">Loading...</div>
            }
            else
            {
                <div class="pam-form-group">
                    <label class="pam-label">Idle session timeout (minutes)</label>
                    <input type="number" class="pam-input" style="width:180px" min="1" @bind="_sessIdleMin" />
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Max concurrent sessions per user</label>
                    <input type="number" class="pam-input" style="width:180px" min="1" @bind="_sessMaxConcurrent" />
                </div>

                <hr style="margin:1.5rem 0" />
                <div style="font-weight:600;margin-bottom:1rem">SSH Command Filter</div>

                <div class="pam-form-group">
                    <label class="pam-label">Command filter mode</label>
                    <select class="pam-input" style="width:220px" @bind="_sessCommandFilterMode">
                        <option value="0">None (disabled)</option>
                        <option value="1">Whitelist (allow listed commands only)</option>
                        <option value="2">Blacklist (block listed commands)</option>
                    </select>
                </div>
                @if (_sessCommandFilterMode != 0)
                {
                    <div class="pam-form-group">
                        <label class="pam-label">Filter rules (JSON array of patterns)</label>
                        <textarea class="pam-input" rows="4" style="font-family:monospace;font-size:0.85rem"
                            @bind="_sessCommandFilterRules"
                            placeholder='["reload","write erase","rm -rf *"]'></textarea>
                        <div style="font-size:0.78rem;color:#888;margin-top:4px">Glob (*) or regex patterns. Use isRegex:true for regex objects.</div>
                    </div>
                }

                <hr style="margin:1.5rem 0" />
                <div style="font-weight:600;margin-bottom:1rem">SSH Double Confirmation</div>
                <div style="font-size:0.85rem;color:#888;margin-bottom:1rem">
                    When enabled, high-risk SSH commands require the user to type YES before execution.
                    The command is cancelled after 30 seconds with no response.
                </div>

                <div class="pam-form-group">
                    <label class="pam-label">Risk score threshold (0 = disabled, 1-10)</label>
                    <input type="number" class="pam-input" style="width:180px" min="0" max="10" step="0.5"
                        @bind="_sessDoubleConfirmThreshold" />
                    <div style="font-size:0.78rem;color:#888;margin-top:4px">
                        Commands scoring at or above this threshold require confirmation. Recommended: 7.
                    </div>
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Explicit command patterns (JSON array, optional)</label>
                    <textarea class="pam-input" rows="3" style="font-family:monospace;font-size:0.85rem"
                        @bind="_sessDoubleConfirmCommands"
                        placeholder='["reload","write erase","format *","shutdown"]'></textarea>
                    <div style="font-size:0.78rem;color:#888;margin-top:4px">
                        These commands always require confirmation regardless of risk score.
                    </div>
                </div>

                <div style="margin-top:1rem">
                    <button class="pam-btn pam-btn-primary" @onclick="@(() => SaveSessionPolicyAsync())" disabled="@_sessSaving">
                        @if (_sessSaving) { <span class="pam-spinner-sm"></span> } Save Session Policy
                    </button>
                </div>
            }
        </div>
    </div>
}

@if (_tab == "mfa")
{
    <div class="pam-card" style="max-width:480px">
        <div class="pam-card-header"><strong>MFA Enforcement Policy</strong></div>
        <div class="pam-card-body">
            @if (_mfaLoading)
            {
                <div class="pam-loading-text">Loading...</div>
            }
            else
            {
                <div class="pam-form-group">
                    <label class="pam-checkbox-label">
                        <input type="checkbox" @bind="_mfaRequired" />
                        <strong>Require MFA for all users</strong>
                    </label>
                    <span class="pam-hint">When enabled, users who have not enrolled in MFA will be prompted to set up their authenticator at next login.</span>
                </div>
                <div class="pam-form-group" style="margin-top:.75rem">
                    <label class="pam-checkbox-label">
                        <input type="checkbox" @bind="_emailOtpEnabled" />
                        <strong>Allow Email OTP as MFA method</strong>
                    </label>
                    <span class="pam-hint">When enabled, users can choose Email OTP (one-time code sent via email) as their MFA method instead of an authenticator app.</span>
                </div>
                <div style="margin-top:1rem">
                    <button class="pam-btn pam-btn-primary" @onclick="SaveMfaPolicyAsync" disabled="@_mfaSaving">
                        @if (_mfaSaving) { <span class="pam-spinner-sm"></span> } Save
                    </button>
                </div>
            }
        </div>
    </div>
}

@if (_tab == "watermark")
{
    <div class="pam-card" style="max-width:640px">
        <div class="pam-card-header"><strong>Session Watermark Policy</strong></div>
        <div class="pam-card-body">
            @if (_wmLoading)
            {
                <div class="pam-loading-text">Loading...</div>
            }
            else
            {
                <div class="pam-form-group">
                    <label class="pam-checkbox-label">
                        <input type="checkbox" @bind="_wmEnabled" />
                        <strong>Enable session watermarking</strong>
                    </label>
                    <span class="pam-hint">Embeds user identity and session metadata into recording files for legal accountability and tamper detection.</span>
                </div>

                <div class="pam-form-group" style="margin-top:1rem">
                    <label class="pam-label">Watermark template</label>
                    <input class="pam-input" style="width:100%;font-family:monospace" @bind="_wmTemplate"
                           placeholder="{username} | {ip} | {device} | {utc}" />
                    <span class="pam-hint">Supported variables: {username}, {ip}, {device}, {utc}, {sessionId}</span>
                </div>

                <div class="pam-form-group" style="margin-top:1rem">
                    <label class="pam-label">Marker interval (minutes)</label>
                    <input type="number" class="pam-input" style="width:140px" min="1" max="120" @bind="_wmMarkerIntervalMin" />
                    <span class="pam-hint">SSH recordings get a watermark marker line inserted every N minutes. Recommended: 15.</span>
                </div>

                <hr style="margin:1.5rem 0" />
                <div style="font-weight:600;margin-bottom:1rem">Protocol Coverage</div>
                <div style="display:flex;flex-wrap:wrap;gap:.5rem 1.5rem;margin-bottom:1rem">
                    <label class="pam-checkbox-label">
                        <input type="checkbox" @bind="_wmEnableSsh" /> SSH sessions
                    </label>
                    <label class="pam-checkbox-label">
                        <input type="checkbox" @bind="_wmEnableRdp" /> RDP sessions
                    </label>
                    <label class="pam-checkbox-label">
                        <input type="checkbox" @bind="_wmEnableVnc" /> VNC sessions
                    </label>
                </div>

                <div class="pam-alert pam-alert-info" style="font-size:0.85rem;margin-top:0.5rem">
                    <strong>How watermarking works:</strong><br />
                    SSH: watermark embedded in recording header title and as periodic marker events.<br />
                    RDP/VNC: user/IP/device metadata stored in binary recording header block.
                </div>

                <div style="margin-top:1.5rem">
                    <button class="pam-btn pam-btn-primary" @onclick="SaveWatermarkPolicyAsync" disabled="@_wmSaving">
                        @if (_wmSaving) { <span class="pam-spinner-sm"></span> } Save Watermark Policy
                    </button>
                </div>
            }
        </div>
    </div>
}

@if (_tab == "adaptive-mfa")
{
    <div class="pam-card" style="max-width:560px">
        <div class="pam-card-header"><strong>Adaptive MFA — Risk-Based Step-Up Authentication</strong></div>
        <div class="pam-card-body">
            @if (_amfaLoading)
            {
                <div class="pam-loading-text">Loading...</div>
            }
            else
            {
                <div class="pam-alert pam-alert-info" style="font-size:0.85rem;margin-bottom:1rem">
                    When enabled, the login risk score (calculated from known IPs, typical hours, and session frequency)
                    determines how much MFA is required. High-risk logins are forced through MFA even if MFA is not enabled for the user.
                </div>

                <div class="pam-form-group">
                    <label class="pam-checkbox-label">
                        <input type="checkbox" @bind="_amfaEnabled" />
                        <strong>Enable Adaptive MFA</strong>
                    </label>
                </div>

                @if (_amfaEnabled)
                {
                    <hr style="margin:1rem 0" />
                    <div style="font-weight:600;margin-bottom:.75rem">Risk Score Thresholds (0–100)</div>

                    <div class="pam-form-row">
                        <div class="pam-form-group" style="flex:1">
                            <label class="pam-label">Low → Medium threshold</label>
                            <input type="number" class="pam-input" style="width:100%" min="1" max="89" @bind="_amfaLow" />
                            <span class="pam-hint">Below this: normal login</span>
                        </div>
                        <div class="pam-form-group" style="flex:1">
                            <label class="pam-label">Medium → High threshold</label>
                            <input type="number" class="pam-input" style="width:100%" min="2" max="89" @bind="_amfaMedium" />
                            <span class="pam-hint">TOTP required</span>
                        </div>
                    </div>
                    <div class="pam-form-row">
                        <div class="pam-form-group" style="flex:1">
                            <label class="pam-label">High threshold (force MFA)</label>
                            <input type="number" class="pam-input" style="width:100%" min="3" max="99" @bind="_amfaHigh" />
                            <span class="pam-hint">MFA forced even if not enrolled</span>
                        </div>
                        <div class="pam-form-group" style="flex:1">
                            <label class="pam-label">Block threshold</label>
                            <input type="number" class="pam-input" style="width:100%" min="10" max="100" @bind="_amfaBlock" />
                            <span class="pam-hint">Login denied completely</span>
                        </div>
                    </div>

                    <div class="pam-alert" style="background:#161b22;border:1px solid #30363d;font-size:0.82rem;margin-top:.5rem">
                        <strong>Risk factors:</strong>
                        Unknown IP address (+30 pts) &bull;
                        Off-hours login (+20 pts) &bull;
                        Frequency spike &gt;5 sessions/hr (+25 pts)
                    </div>
                }

                <div style="margin-top:1rem">
                    <button class="pam-btn pam-btn-primary" @onclick="SaveAdaptiveMfaPolicyAsync" disabled="@_amfaSaving">
                        @if (_amfaSaving) { <span class="pam-spinner-sm"></span> } Save
                    </button>
                </div>
            }
        </div>
    </div>
}

@if (_showAdd)
{
    <div class="pam-modal-overlay" @onclick="CloseAddModal">
        <div class="pam-modal" @onclick:stopPropagation="true">
            <div class="pam-modal-header">
                <h3 class="pam-modal-title">New Policy</h3>
                <button class="pam-close-btn" @onclick="CloseAddModal">&#215;</button>
            </div>
            <div class="pam-modal-body">
                @if (_addError != null) { <div class="pam-alert pam-alert-danger">@_addError</div> }
                <div class="pam-form-group">
                    <label class="pam-label">Name *</label>
                    <input class="pam-input w-100-input" @bind="_fName" placeholder="e.g. Global Password Policy" />
                </div>
                <div class="pam-form-row">
                    <div class="pam-form-group" style="flex:1">
                        <label class="pam-label">Type *</label>
                        <select class="pam-input" style="width:100%" @bind="_fPolicyType">
                            <option value="Password">Password</option>
                            <option value="Session">Session</option>
                            <option value="Access">Access</option>
                            <option value="MFA">MFA</option>
                        </select>
                    </div>
                    <div class="pam-form-group" style="flex:1">
                        <label class="pam-label">Scope *</label>
                        <select class="pam-input" style="width:100%" @bind="_fScope">
                            <option value="0">Global</option>
                            <option value="2">Group</option>
                            <option value="1">User</option>
                        </select>
                    </div>
                    <div class="pam-form-group" style="width:80px">
                        <label class="pam-label">Priority</label>
                        <input class="pam-input" style="width:100%" type="number" @bind="_fPriority" min="0" max="100" />
                    </div>
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Policy JSON *</label>
                    <textarea class="pam-input w-100-input pam-textarea" rows="5"
                              @bind="_fPolicyJson" placeholder='{"minLength":12,"requireUppercase":true}'></textarea>
                    <span class="pam-hint">JSON configuration for this policy type.</span>
                </div>
            </div>
            <div class="pam-modal-footer">
                <button class="pam-btn pam-btn-secondary" @onclick="CloseAddModal">Cancel</button>
                <button class="pam-btn pam-btn-primary" @onclick="SubmitAddPolicyAsync" disabled="@_addSaving">
                    @if (_addSaving) { <span class="pam-spinner-sm"></span> }
                    Create Policy
                </button>
            </div>
        </div>
    </div>
}

@if (_deleteTarget != null)
{
    <div class="pam-modal-overlay" @onclick="CancelDelete">
        <div class="pam-modal pam-modal-sm" @onclick:stopPropagation="true">
            <div class="pam-modal-header">
                <h3 class="pam-modal-title">Delete Policy</h3>
                <button class="pam-close-btn" @onclick="CancelDelete">&#215;</button>
            </div>
            <div class="pam-modal-body">
                <p>Delete policy <strong>@_deleteTarget.Name</strong>?</p>
                <p class="pam-hint pam-hint-warn">This cannot be undone.</p>
            </div>
            <div class="pam-modal-footer">
                <button class="pam-btn pam-btn-secondary" @onclick="CancelDelete">Cancel</button>
                <button class="pam-btn pam-btn-danger" @onclick="ExecuteDeleteAsync">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private string _tab = "list";

    // Policy list
    private List<PolicyDto>? _policies;
    private bool    _loading    = false;
    private string? _error;
    private string? _successMsg;
    private string  _typeFilter = "";

    // Add modal
    private bool    _showAdd;
    private string? _addError;
    private bool    _addSaving;
    private string  _fName       = "";
    private string  _fPolicyType = "Password";
    private string  _fScope      = "0";
    private int     _fPriority   = 50;
    private string  _fPolicyJson = "{}";

    // Delete confirm
    private PolicyDto? _deleteTarget;

    // Password policy
    private bool _pwdLoading    = false;
    private bool _pwdSaving     = false;
    private int  _pwdMinLen     = 12;
    private int  _pwdMaxLen     = 128;
    private bool _pwdReqUpper   = true;
    private bool _pwdReqLower   = true;
    private bool _pwdReqDigit   = true;
    private bool _pwdReqSpecial = true;
    private int  _pwdExpiryDays = 90;
    private int  _pwdReuseCount = 12;
    private bool _pwdForceChange = true;

    // Lockout policy
    private bool _lockLoading     = false;
    private bool _lockSaving      = false;
    private int  _lockMaxAttempts = 5;
    private int  _lockDurationMin = 30;
    private int  _lockWindowMin   = 15;

    // Session policy
    private bool    _sessLoading                = false;
    private bool    _sessSaving                 = false;
    private int     _sessIdleMin                = 30;
    private int     _sessMaxConcurrent          = 3;
    private byte    _sessCommandFilterMode      = 0;
    private string  _sessCommandFilterRules     = "";
    private decimal _sessDoubleConfirmThreshold = 0;
    private string  _sessDoubleConfirmCommands  = "";

    // MFA policy
    private bool _mfaLoading      = false;
    private bool _mfaSaving       = false;
    private bool _mfaRequired     = false;
    private bool _emailOtpEnabled = false;

    // Watermark policy (#190)
    private bool   _wmLoading          = false;
    private bool   _wmSaving           = false;
    private bool   _wmEnabled          = false;
    private string _wmTemplate         = "{username} | {ip} | {device} | {utc}";
    private int    _wmMarkerIntervalMin = 15;
    private bool   _wmEnableSsh        = true;
    private bool   _wmEnableRdp        = true;
    private bool   _wmEnableVnc        = true;

    // Adaptive MFA policy (#205)
    private bool _amfaLoading = false;
    private bool _amfaSaving  = false;
    private bool _amfaEnabled = false;
    private int  _amfaLow     = 25;
    private int  _amfaMedium  = 50;
    private int  _amfaHigh    = 75;
    private int  _amfaBlock   = 90;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadPoliciesAsync();
    }

    private async Task SwitchTab(string tab)
    {
        _tab = tab; _error = null; _successMsg = null; StateHasChanged();
        switch (tab)
        {
            case "list":      await LoadPoliciesAsync();          break;
            case "password":  await LoadPasswordPolicyAsync();    break;
            case "lockout":   await LoadLockoutPolicyAsync();     break;
            case "session":   await LoadSessionPolicyAsync();     break;
            case "mfa":       await LoadMfaPolicyAsync();         break;
            case "watermark":    await LoadWatermarkPolicyAsync();        break;
            case "adaptive-mfa": await LoadAdaptiveMfaPolicyAsync();     break;
        }
    }

    private async Task LoadPoliciesAsync()
    {
        _loading = true; StateHasChanged();
        var result = await Api.GetPoliciesAsync(string.IsNullOrEmpty(_typeFilter) ? null : _typeFilter);
        _policies = result?.Data ?? [];
        if (result == null) _error = "Failed to load policies.";
        _loading = false; StateHasChanged();
    }

    private async Task ToggleAsync(string id, bool enable)
    {
        if (await Api.TogglePolicyAsync(id, enable))
        {
            _successMsg = enable ? "Policy enabled." : "Policy disabled.";
            await LoadPoliciesAsync();
            await Task.Delay(3000); _successMsg = null; StateHasChanged();
        }
        else { _error = "Failed to update policy."; StateHasChanged(); }
    }

    private void OpenAddModal()
    {
        _fName = ""; _fPolicyType = "Password"; _fScope = "0"; _fPriority = 50; _fPolicyJson = "{}";
        _addError = null; _showAdd = true;
    }
    private void CloseAddModal() { _showAdd = false; _addError = null; }

    private async Task SubmitAddPolicyAsync()
    {
        _addError = null;
        if (string.IsNullOrWhiteSpace(_fName))       { _addError = "Name is required."; return; }
        if (string.IsNullOrWhiteSpace(_fPolicyJson)) { _addError = "Policy JSON is required."; return; }
        _addSaving = true; StateHasChanged();
        var ok = await Api.CreatePolicyAsync(_fName.Trim(), _fPolicyType, int.Parse(_fScope), _fPolicyJson.Trim(), _fPriority);
        _addSaving = false;
        if (!ok) { _addError = "Failed to create policy."; StateHasChanged(); return; }
        CloseAddModal(); await LoadPoliciesAsync();
    }

    private void ConfirmDelete(PolicyDto p) { _deleteTarget = p; StateHasChanged(); }
    private void CancelDelete()             { _deleteTarget = null; StateHasChanged(); }

    private async Task ExecuteDeleteAsync()
    {
        if (_deleteTarget == null) return;
        var id = _deleteTarget.Id; _deleteTarget = null;
        if (!await Api.DeletePolicyAsync(id)) _error = "Failed to delete policy.";
        await LoadPoliciesAsync();
    }

    private async Task LoadPasswordPolicyAsync()
    {
        _pwdLoading = true; StateHasChanged();
        var s = await Api.GetPasswordPolicyAsync();
        if (s != null)
        {
            _pwdMinLen = s.MinLength; _pwdMaxLen = s.MaxLength;
            _pwdReqUpper = s.RequireUppercase; _pwdReqLower = s.RequireLowercase;
            _pwdReqDigit = s.RequireDigit;     _pwdReqSpecial = s.RequireSpecial;
            _pwdExpiryDays = s.ExpiryDays;     _pwdReuseCount = s.PreventReuseCount;
            _pwdForceChange = s.ForceChangeOnFirstLogin;
        }
        _pwdLoading = false; StateHasChanged();
    }

    private async Task SavePasswordPolicyAsync()
    {
        _pwdSaving = true; StateHasChanged();
        var ok = await Api.SavePasswordPolicyAsync(new PasswordPolicySettingsDto(
            _pwdMinLen, _pwdMaxLen,
            _pwdReqUpper, _pwdReqLower, _pwdReqDigit, _pwdReqSpecial,
            _pwdExpiryDays, _pwdReuseCount, _pwdForceChange));
        _pwdSaving = false;
        _successMsg = ok ? "Password policy saved." : null;
        if (!ok) _error = "Failed to save password policy.";
        StateHasChanged();
        if (ok) { await Task.Delay(3000); _successMsg = null; StateHasChanged(); }
    }

