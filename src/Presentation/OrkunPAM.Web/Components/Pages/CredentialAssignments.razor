@page "/credential-assignments"
@inject PamApiService Api

<PageTitle>Credential Assignments &#x2014; OrkunPAM</PageTitle>

<div class="pam-page-header">
    <h2 class="pam-page-title">Credential Assignments</h2>
    <p style="color:var(--pam-muted);font-size:0.85em;margin:4px 0 0">
        Assign vault credentials to users or groups (Kron PAM assigned_credential model).
    </p>
</div>

@if (_msg != null) { <div class="pam-alert pam-alert-info">@_msg</div> }
@if (_err != null) { <div class="pam-alert pam-alert-danger">@_err</div> }

<div style="display:flex;gap:8px;margin-bottom:16px">
    <button class="pam-btn pam-btn-primary" @onclick="@(() => ShowCreate())">+ New Assignment</button>
</div>

@if (_creating)
{
    <div class="pam-card" style="max-width:680px;margin-bottom:20px">
        <div class="pam-card-body">
            <strong>Create Credential Assignment</strong>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:12px">

                <div style="grid-column:1/-1">
                    <label class="pam-label">Credential *</label>
                    <select class="pam-input" @bind="_fCredentialId">
                        <option value="">-- select credential --</option>
                        @if (_allCreds != null)
                        {
                            @foreach (var c in _allCreds)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        }
                    </select>
                </div>

                <div>
                    <label class="pam-label">Principal Type *</label>
                    <select class="pam-input" value="@_fPrincipalType"
                            @onchange="@(e => OnPrincipalTypeChange(e.Value?.ToString()))">
                        <option value="User">User</option>
                        <option value="Group">Group</option>
                    </select>
                </div>

                <div>
                    @if (_fPrincipalType == "Group")
                    {
                        <label class="pam-label">Group *</label>
                        <select class="pam-input" @bind="_fPrincipalId">
                            <option value="">-- select group --</option>
                            @if (_allGroups != null)
                            {
                                @foreach (var g in _allGroups)
                                {
                                    <option value="@g.Id">@g.Name</option>
                                }
                            }
                        </select>
                    }
                    else
                    {
                        <label class="pam-label">User *</label>
                        <select class="pam-input" @bind="_fPrincipalId">
                            <option value="">-- select user --</option>
                            @if (_allUsers != null)
                            {
                                @foreach (var u in _allUsers)
                                {
                                    <option value="@u.Id">@(u.DisplayName ?? u.Username)</option>
                                }
                            }
                        </select>
                    }
                </div>

                <div style="grid-column:1/-1">
                    <label class="pam-label">Device Group Scope (optional — leave blank for all devices)</label>
                    <select class="pam-input" @bind="_fDeviceGroupId">
                        <option value="">-- all devices --</option>
                        @if (_allDeviceGroups != null)
                        {
                            @foreach (var dg in _allDeviceGroups)
                            {
                                <option value="@dg.Id">@dg.Name</option>
                            }
                        }
                    </select>
                </div>

                <div style="grid-column:1/-1">
                    <label class="pam-label">Notes</label>
                    <input class="pam-input" placeholder="Optional notes" @bind="_fNotes" />
                </div>
            </div>
            <div style="margin-top:14px;display:flex;gap:8px">
                <button class="pam-btn pam-btn-primary" @onclick="@(() => SaveAsync())" disabled="@_saving">
                    @(_saving ? "Saving..." : "Save")
                </button>
                <button class="pam-btn pam-btn-secondary" @onclick="@(() => CancelForm())">Cancel</button>
            </div>
        </div>
    </div>
}

@if (_assignments == null)
{
    <div class="pam-alert pam-alert-info">Loading...</div>
}
else if (_assignments.Count == 0)
{
    <div class="pam-alert pam-alert-info">No credential assignments yet. Create one to grant access.</div>
}
else
{
    <table class="pam-table pam-table-hover">
        <thead>
            <tr>
                <th>Credential</th>
                <th>Type</th>
                <th>Principal</th>
                <th>Device Group Scope</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in _assignments)
            {
                <tr>
                    <td>@a.CredentialName</td>
                    <td>
                        <span style="font-size:0.78em;background:#e5e7eb;padding:1px 5px;border-radius:3px">
                            @a.PrincipalType
                        </span>
                    </td>
                    <td>@GetPrincipalLabel(a.PrincipalType, a.PrincipalId)</td>
                    <td style="color:var(--pam-muted);font-size:0.85em">
                        @(a.DeviceGroupId != null ? GetDeviceGroupName(a.DeviceGroupId) : "All devices")
                    </td>
                    <td>
                        @if (a.IsEnabled)
                        {
                            <span style="color:#22c55e;font-size:0.8em">Active</span>
                        }
                        else
                        {
                            <span style="color:var(--pam-muted);font-size:0.8em">Disabled</span>
                        }
                    </td>
                    <td>
                        <div style="display:flex;gap:4px">
                            <button class="pam-btn pam-btn-secondary" style="font-size:0.78em"
                                    @onclick="@(() => ToggleAsync(a.Id))">
                                @(a.IsEnabled ? "Disable" : "Enable")
                            </button>
                            <button class="pam-btn pam-btn-danger" style="font-size:0.78em"
                                    @onclick="@(() => DeleteAsync(a.Id))">Delete</button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<AssignedCredentialDto>? _assignments;
    private List<CredentialDto>? _allCreds;
    private List<UserDto>? _allUsers;
    private List<GroupDto>? _allGroups;
    private List<DeviceGroupDto>? _allDeviceGroups;

    private Dictionary<string, string> _userNames      = new();
    private Dictionary<string, string> _groupNames     = new();
    private Dictionary<string, string> _devGroupNames  = new();

    private bool   _creating;
    private string _fCredentialId  = "";
    private string _fPrincipalType = "User";
    private string _fPrincipalId   = "";
    private string _fDeviceGroupId = "";
    private string _fNotes         = "";
    private bool   _saving;

    private string? _msg;
    private string? _err;

    protected override async Task OnInitializedAsync()
    {
        await LoadAllAsync();
    }

    private async Task LoadAllAsync()
    {
        var t1 = Api.GetAssignedCredentialsAsync();
        var t2 = Api.GetCredentialsAsync(pageSize: 500);
        var t3 = Api.GetUsersAsync(pageSize: 500);
        var t4 = Api.GetGroupsAsync();
        var t5 = Api.GetDeviceGroupsAsync();
        await Task.WhenAll(t1, t2, t3, t4, t5);

        _assignments     = t1.Result;
        _allCreds        = t2.Result?.Data;
        _allUsers        = t3.Result?.Data;
        _allGroups       = t4.Result;
        _allDeviceGroups = t5.Result;

        _userNames     = _allUsers?.ToDictionary(u => u.Id, u => u.DisplayName ?? u.Username) ?? new();
        _groupNames    = _allGroups?.ToDictionary(g => g.Id, g => g.Name) ?? new();
        _devGroupNames = _allDeviceGroups?.ToDictionary(d => d.Id, d => d.Name) ?? new();
    }

    private string GetPrincipalLabel(string principalType, string principalId)
    {
        if (principalType == "User")
            return _userNames.TryGetValue(principalId, out var n) ? n : principalId[..8];
        return _groupNames.TryGetValue(principalId, out var gn) ? gn : principalId[..8];
    }

    private string GetDeviceGroupName(string? dgId)
    {
        if (dgId == null) return "All devices";
        return _devGroupNames.TryGetValue(dgId, out var n) ? n : dgId[..8];
    }

    private void OnPrincipalTypeChange(string? newType)
    {
        _fPrincipalType = newType ?? "User";
        _fPrincipalId   = "";
    }

    private void ShowCreate()
    {
        _creating       = true;
        _fCredentialId  = "";
        _fPrincipalType = "User";
        _fPrincipalId   = "";
        _fDeviceGroupId = "";
        _fNotes         = "";
        _msg = null; _err = null;
    }

    private void CancelForm() => _creating = false;

    private async Task SaveAsync()
    {
        if (string.IsNullOrEmpty(_fCredentialId)) { _err = "Select a credential."; return; }
        if (string.IsNullOrEmpty(_fPrincipalId))  { _err = "Select a user or group."; return; }

        _saving = true; _err = null;
        var ok = await Api.CreateAssignedCredentialAsync(
            _fCredentialId, _fPrincipalType, _fPrincipalId,
            string.IsNullOrEmpty(_fDeviceGroupId) ? null : _fDeviceGroupId,
            string.IsNullOrEmpty(_fNotes) ? null : _fNotes);
        _saving = false;

        if (ok)
        {
            _msg = "Assignment created.";
            _creating = false;
            _assignments = await Api.GetAssignedCredentialsAsync();
        }
        else
        {
            _err = "Failed to create assignment.";
        }
    }

    private async Task ToggleAsync(string id)
    {
        _err = null;
        if (await Api.ToggleAssignedCredentialAsync(id))
            _assignments = await Api.GetAssignedCredentialsAsync();
        else
            _err = "Toggle failed.";
    }

    private async Task DeleteAsync(string id)
    {
        _err = null;
        if (await Api.DeleteAssignedCredentialAsync(id))
        {
            _msg = "Assignment deleted.";
            _assignments = await Api.GetAssignedCredentialsAsync();
        }
        else
        {
            _err = "Delete failed.";
        }
    }
}
