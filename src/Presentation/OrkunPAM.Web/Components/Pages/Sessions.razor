@page "/sessions"
@inject PamApiService Api
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Sessions — OrkunPAM</PageTitle>

<div class="pam-page-header" style="display:flex;align-items:center;justify-content:space-between;">
    <h2 class="pam-page-title">Sessions</h2>
    <div style="display:flex;gap:.5rem;align-items:center">
        @if (_pendingHandoffs != null && _pendingHandoffs.Count > 0)
        {
            <button class="pam-btn pam-btn-warning pam-btn-sm" @onclick="OpenPendingHandoffsPanel"
                    title="You have pending session handoff requests">
                &#x21C4; @_pendingHandoffs.Count Handoff Request@(_pendingHandoffs.Count == 1 ? "" : "s")
            </button>
        }
        @if (_activeTab == "sessions")
        {
            <button class="pam-btn pam-btn-secondary pam-btn-sm" @onclick="ExportCsvAsync">Export CSV</button>
        }
        @if (_activeTab == "compliance")
        {
            <button class="pam-btn pam-btn-secondary pam-btn-sm" @onclick="ExportComplianceCsvAsync">Export Compliance CSV</button>
        }
    </div>
</div>

<!-- Tab navigation -->
<div class="pam-tabs" style="margin-bottom:1rem">
    <button class="pam-tab @(_activeTab == "sessions" ? "active" : "")"
            @onclick="@(() => SwitchTab("sessions"))">Sessions</button>
    <button class="pam-tab @(_activeTab == "compliance" ? "active" : "")"
            @onclick="@(() => SwitchTab("compliance"))">Compliance</button>
    <button class="pam-tab @(_activeTab == "delegations" ? "active" : "")"
            @onclick="@(() => SwitchTab("delegations"))">Delegations</button>
</div>

@if (_error != null)
{
    <div class="pam-alert pam-alert-danger">@_error</div>
}

@* ── Sessions Tab ─────────────────────────────────────────────────────────────────────────────── *@
@if (_activeTab == "sessions")
{
    @* Restorable sessions banner *@
    @if (_restorableSessions != null && _restorableSessions.Count > 0)
    {
        <div class="pam-alert" style="background:#fff3cd;border:1px solid #ffc107;border-radius:6px;padding:.75rem 1rem;margin-bottom:.75rem;display:flex;align-items:center;justify-content:space-between;">
            <span>&#x26A0;&#xFE0F; <strong>@_restorableSessions.Count disconnected session@(_restorableSessions.Count == 1 ? "" : "s")</strong> can be restored within the next few minutes.</span>
            <button class="pam-btn pam-btn-warning pam-btn-sm" @onclick="OpenRestorePanel">Restore Sessions</button>
        </div>
    }

    <div class="pam-filters">
        <select class="pam-input pam-select" @bind="_statusFilter" @bind:after="LoadAsync">
            <option value="">All Sessions</option>
            <option value="Active">Active</option>
            <option value="Completed">Completed</option>
            <option value="Failed">Failed</option>
            <option value="Disconnected">Disconnected</option>
        </select>
    </div>

    <div class="pam-card">
        <div class="pam-card-body p-0">
            @if (_loading)
            {
                <div class="pam-loading-text p-4">Loading sessions&#x2026;</div>
            }
            else if (_sessions == null || _sessions.Count == 0)
            {
                <div class="pam-empty p-4">No sessions found.</div>
            }
            else
            {
                <table class="pam-table pam-table-hover">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Target</th>
                            <th>Port</th>
                            <th>Client</th>
                            <th>Status</th>
                            <th>Started</th>
                            <th>Duration</th>
                            <th>Tags</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _sessions)
                        {
                            <tr>
                                <td><span class="pam-badge">@s.SessionType</span></td>
                                <td>@(s.TargetIpAddress ?? "&#x2014;")</td>
                                <td>@(s.TargetPort?.ToString() ?? "&#x2014;")</td>
                                <td>@(s.ClientIpAddress ?? "&#x2014;")</td>
                                <td>
                                    <span class="pam-status @StatusClass(s.Status)">@s.Status</span>
                                </td>
                                <td>@s.StartedAtUtc.ToLocalTime().ToString("MM/dd HH:mm")</td>
                                <td>@Duration(s)</td>
                                <td style="max-width:160px">
                                    @if (!string.IsNullOrEmpty(s.Tags))
                                    {
                                        @foreach (var tag in s.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                        {
                                            <span class="pam-badge pam-badge-secondary" style="margin:1px;font-size:0.72em">@tag</span>
                                        }
                                    }
                                    <button class="pam-btn-icon" title="Edit tags"
                                            @onclick="@(() => OpenTagModal(s))">&#x1F3F7;</button>
                                </td>
                                <td style="display:flex;gap:4px;flex-wrap:wrap;">
                                    <button class="pam-btn pam-btn-secondary pam-btn-sm"
                                            @onclick="@(() => OpenAnnotationsPanel(s.Id.ToString()))">
                                        &#x1F4DD; Notes
                                    </button>
                                    @if (s.Status == "Active")
                                    {
                                        <button class="pam-btn pam-btn-primary pam-btn-sm"
                                                @onclick="@(() => Nav.NavigateTo("/live-monitor/" + s.Id))">
                                            &#x25CF; Live
                                        </button>
                                        <button class="pam-btn pam-btn-warning pam-btn-sm"
                                                @onclick="@(() => ShadowAsync(s.Id.ToString()))">
                                            &#x1F441; Shadow
                                        </button>
                                        <button class="pam-btn pam-btn-secondary pam-btn-sm"
                                                @onclick="@(() => OpenHandoffModal(s))">
                                            &#x21C4; Handoff
                                        </button>
                                    }
                                    @if (s.Status == "Disconnected")
                                    {
                                        <button class="pam-btn pam-btn-warning pam-btn-sm"
                                                @onclick="@(() => RestoreFromSessionAsync(Guid.Parse(s.Id)))"
                                                disabled="@_restoreBusy">
                                            &#x21BA; Restore
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (_meta != null && _meta.TotalCount > _pageSize)
                {
                    <div class="pam-pagination">
                        <button class="pam-btn pam-btn-secondary pam-btn-sm"
                                disabled="@(_page == 1)" @onclick="PrevPage">&#x2190; Prev</button>
                        <span class="pam-page-info">Page @_page of @TotalPages &#x2014; @_meta.TotalCount sessions</span>
                        <button class="pam-btn pam-btn-secondary pam-btn-sm"
                                disabled="@(_page >= TotalPages)" @onclick="NextPage">Next &#x2192;</button>
                    </div>
                }
            }
        </div>
    </div>
}

@* ── Compliance Tab ────────────────────────────────────────────────────────────────────────────── *@
@if (_activeTab == "compliance")
{
    <div class="pam-filters" style="margin-bottom:1rem">
        <label class="pam-label" style="margin-right:.5rem;align-self:center">Period:</label>
        <button class="pam-btn @(_complianceDays == 7  ? "pam-btn-primary" : "pam-btn-secondary") pam-btn-sm"
                @onclick="@(() => SetComplianceDays(7))">7d</button>
        <button class="pam-btn @(_complianceDays == 30 ? "pam-btn-primary" : "pam-btn-secondary") pam-btn-sm"
                @onclick="@(() => SetComplianceDays(30))">30d</button>
        <button class="pam-btn @(_complianceDays == 90 ? "pam-btn-primary" : "pam-btn-secondary") pam-btn-sm"
                @onclick="@(() => SetComplianceDays(90))">90d</button>
    </div>

    @if (_complianceLoading)
    {
        <div class="pam-loading-text">Loading compliance data&#x2026;</div>
    }
    else if (_compliance == null)
    {
        <div class="pam-empty">No compliance data available.</div>
    }
    else
    {
        <!-- Stat cards row -->
        <div class="pam-stat-row" style="margin-bottom:1.25rem">
            <div class="pam-stat-card pam-stat-green">
                <div class="pam-stat-icon">&#x2713;</div>
                <div class="pam-stat-body">
                    <div class="pam-stat-value">@_compliance.ComplianceRate%</div>
                    <div class="pam-stat-label">Compliance Rate</div>
                </div>
            </div>
            <div class="pam-stat-card pam-stat-blue">
                <div class="pam-stat-icon">&#x25BA;</div>
                <div class="pam-stat-body">
                    <div class="pam-stat-value">@_compliance.TotalSessions</div>
                    <div class="pam-stat-label">Total Sessions</div>
                </div>
            </div>
            <div class="pam-stat-card pam-stat-red">
                <div class="pam-stat-icon">&#x26A0;</div>
                <div class="pam-stat-body">
                    <div class="pam-stat-value">@_compliance.ViolatedSessions</div>
                    <div class="pam-stat-label">Violated Sessions</div>
                </div>
            </div>
            <div class="pam-stat-card pam-stat-orange">
                <div class="pam-stat-icon">&#x2717;</div>
                <div class="pam-stat-body">
                    <div class="pam-stat-value">@_compliance.BlockedCommands</div>
                    <div class="pam-stat-label">Blocked Commands</div>
                </div>
            </div>
            <div class="pam-stat-card pam-stat-red">
                <div class="pam-stat-icon">&#x23F9;</div>
                <div class="pam-stat-body">
                    <div class="pam-stat-value">@_compliance.AdminTerminated</div>
                    <div class="pam-stat-label">Admin Terminated</div>
                </div>
            </div>
        </div>

        <!-- Compliance rate progress bar -->
        <div class="pam-card" style="margin-bottom:1rem">
            <div class="pam-card-header">
                <h3 class="pam-card-title">Compliance Rate</h3>
                <span style="font-size:0.85em;color:#888">@_compliance.CleanSessions clean / @_compliance.TotalSessions total</span>
            </div>
            <div class="pam-card-body">
                <div style="background:#30363d;border-radius:8px;height:24px;overflow:hidden;position:relative">
                    <div style="background:@(_compliance.ComplianceRate >= 90 ? "#22c55e" : _compliance.ComplianceRate >= 70 ? "#f59e0b" : "#ef4444");height:100%;width:@(_compliance.ComplianceRate)%;transition:width .5s;border-radius:8px"></div>
                    <span style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);font-size:0.8em;font-weight:600">@_compliance.ComplianceRate%</span>
                </div>
            </div>
        </div>

        <div class="pam-row">
            <!-- Violation Types -->
            @if (_compliance.ViolationTypes != null && _compliance.ViolationTypes.Count > 0)
            {
                <div class="pam-card" style="flex:1;min-width:300px;margin-bottom:1rem">
                    <div class="pam-card-header">
                        <h3 class="pam-card-title">Violation Types</h3>
                    </div>
                    <div class="pam-card-body p-0">
                        <table class="pam-table">
                            <thead><tr><th>Type</th><th>Count</th></tr></thead>
                            <tbody>
                                @foreach (var vt in _compliance.ViolationTypes)
                                {
                                    <tr>
                                        <td><span class="pam-badge pam-badge-secondary" style="font-size:0.75em">@vt.Key</span></td>
                                        <td><strong style="color:#ef4444">@vt.Value</strong></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <!-- Top Violating Users -->
            @if (_compliance.TopViolatingUsers != null && _compliance.TopViolatingUsers.Count > 0)
            {
                <div class="pam-card" style="flex:1;min-width:280px;margin-bottom:1rem">
                    <div class="pam-card-header">
                        <h3 class="pam-card-title">Top Violating Users</h3>
                    </div>
                    <div class="pam-card-body p-0">
                        <table class="pam-table">
                            <thead><tr><th>User</th><th>Violations</th></tr></thead>
                            <tbody>
                                @foreach (var u in _compliance.TopViolatingUsers)
                                {
                                    <tr>
                                        <td>@u.Username</td>
                                        <td><span class="pam-badge" style="background:#ef4444;color:white">@u.ViolationCount</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <!-- Top Violating Devices -->
            @if (_compliance.TopViolatingDevices != null && _compliance.TopViolatingDevices.Count > 0)
            {
                <div class="pam-card" style="flex:1;min-width:280px;margin-bottom:1rem">
                    <div class="pam-card-header">
                        <h3 class="pam-card-title">Top Violating Devices</h3>
                    </div>
                    <div class="pam-card-body p-0">
                        <table class="pam-table">
                            <thead><tr><th>Device</th><th>Violations</th></tr></thead>
                            <tbody>
                                @foreach (var d in _compliance.TopViolatingDevices)
                                {
                                    <tr>
                                        <td>@d.Hostname</td>
                                        <td><span class="pam-badge" style="background:#ef4444;color:white">@d.ViolationCount</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        @if (_compliance.TopViolatingUsers == null || _compliance.TopViolatingUsers.Count == 0)
        {
            <div class="pam-empty" style="margin-top:1rem">No policy violations detected in this period.</div>
        }
    }
}

@* ── Delegations Tab ─────────────────────────────────────────────────────────────────────────────── *@
@if (_activeTab == "delegations")
{
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem">
        <h3 class="pam-section-title" style="margin:0">Session Delegations</h3>
        <button class="pam-btn pam-btn-primary pam-btn-sm" @onclick="OpenCreateDelegationModal">
            &#x2B; Grant Delegation
        </button>
    </div>

    @if (_delegationLoading)
    {
        <div class="pam-loading-text">Loading delegations&#x2026;</div>
    }
    else if (_delegations == null || _delegations.Count == 0)
    {
        <div class="pam-empty">No session delegations found.</div>
    }
    else
    {
        <div class="pam-card">
            <div class="pam-card-body p-0">
                <table class="pam-table">
                    <thead>
                        <tr>
                            <th>Delegator</th>
                            <th>Delegate</th>
                            <th>Target</th>
                            <th>Expires</th>
                            <th>Uses</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _delegations)
                        {
                            <tr>
                                <td>@(d.DelegatorUsername ?? "—")</td>
                                <td>@(d.DelegateUsername ?? "—")</td>
                                <td>
                                    @if (d.DeviceId.HasValue)
                                    {
                                        <span class="pam-badge pam-badge-info">Device</span>
                                    }
                                    else if (d.DeviceGroupId.HasValue)
                                    {
                                        <span class="pam-badge pam-badge-info">Group</span>
                                    }
                                    else
                                    {
                                        <span style="color:#888">—</span>
                                    }
                                </td>
                                <td style="font-size:0.85em">@d.ExpiresAtUtc.ToLocalTime().ToString("MM/dd HH:mm")</td>
                                <td>@d.UsageCount / @d.MaxSessionCount</td>
                                <td>
                                    <span class="pam-badge @DelegationStatusClass(d.Status)">@d.Status</span>
                                </td>
                                <td>
                                    @if (d.Status == "Active")
                                    {
                                        <button class="pam-btn pam-btn-danger pam-btn-sm"
                                                @onclick="@(() => RevokeDelegationAsync(d.Id))">
                                            Revoke
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@* Grant Delegation modal *@
@if (_showCreateDelegation)
{
    <div class="pam-modal-overlay" @onclick="CloseCreateDelegationModal">
        <div class="pam-modal" style="max-width:520px" @onclick:stopPropagation="true">
            <div class="pam-modal-header">
                <h3 class="pam-modal-title">&#x2B; Grant Session Delegation</h3>
                <button class="pam-close-btn" @onclick="CloseCreateDelegationModal">&#215;</button>
            </div>
            <div class="pam-modal-body">
                <div style="margin-bottom:.75rem;font-size:0.9em;color:#aaa">
                    Grant another admin temporary access to start sessions against a device or group.
                    No active session is transferred — this creates a new access right.
                </div>
                <label class="pam-label">Delegate (target admin)</label>
                <select class="pam-input pam-select" style="width:100%;margin-bottom:.75rem" @bind="_delegNewUserId">
                    <option value="">— Select admin —</option>
                    @if (_adminUsers != null)
                    {
                        @foreach (var u in _adminUsers)
                        {
                            <option value="@u.Id.ToString()">@(u.DisplayName ?? u.Username) (@u.Username)</option>
                        }
                    }
                </select>
                <label class="pam-label">Expires At (UTC)</label>
                <input type="datetime-local" class="pam-input" style="width:100%;margin-bottom:.75rem"
                       @bind="_delegExpires" />
                <label class="pam-label">Max Session Uses</label>
                <input type="number" class="pam-input" style="width:100%;margin-bottom:.75rem"
                       min="1" max="100" @bind="_delegMaxUses" />
                <label class="pam-label">Note (optional)</label>
                <textarea class="pam-input" rows="2" style="width:100%;margin-bottom:.75rem" @bind="_delegNote"
                          placeholder="e.g. Cover shift — DB maintenance only"></textarea>
                @if (_delegError != null)
                {
                    <div class="pam-alert pam-alert-danger">@_delegError</div>
                }
                @if (_delegSuccess != null)
                {
                    <div class="pam-alert pam-alert-success">@_delegSuccess</div>
                }
            </div>
            <div class="pam-modal-footer">
                <button class="pam-btn pam-btn-secondary" @onclick="CloseCreateDelegationModal">Cancel</button>
                <button class="pam-btn pam-btn-primary"
                        @onclick="SubmitCreateDelegationAsync"
                        disabled="@(_delegSaving || string.IsNullOrEmpty(_delegNewUserId))">
                    @if (_delegSaving) { <span class="pam-spinner-sm"></span> } Grant Access
                </button>
            </div>
        </div>
    </div>
}

@* Tag edit modal *@
@if (_tagSession != null)
{
    <div class="pam-modal-overlay" @onclick="CloseTagModal">
        <div class="pam-modal pam-modal-sm" @onclick:stopPropagation="true">
            <div class="pam-modal-header">
                <h3 class="pam-modal-title">Edit Session Tags</h3>
                <button class="pam-close-btn" @onclick="CloseTagModal">&#215;</button>
            </div>
            <div class="pam-modal-body">
                <label class="pam-label">Tags (comma-separated)</label>
                <input class="pam-input" style="width:100%" @bind="_tagInput"
                       placeholder="e.g. production, critical, change-123" />
                <div style="font-size:0.8em;color:#888;margin-top:4px">
                    Comma-separated keywords. Used for filtering and reporting.
                </div>
            </div>
            <div class="pam-modal-footer">
                <button class="pam-btn pam-btn-secondary" @onclick="CloseTagModal">Cancel</button>
                <button class="pam-btn pam-btn-primary" @onclick="SaveTagsAsync" disabled="@_tagSaving">
                    @if (_tagSaving) { <span class="pam-spinner-sm"></span> } Save
                </button>
            </div>
        </div>
    </div>
}

@* Annotations panel *@
@if (_annotSessionId != null)
{
    <div class="pam-modal-overlay" @onclick="CloseAnnotationsPanel">
        <div class="pam-modal" style="max-width:640px" @onclick:stopPropagation="true">
            <div class="pam-modal-header">
                <h3 class="pam-modal-title">Session Notes</h3>
                <button class="pam-close-btn" @onclick="CloseAnnotationsPanel">&#215;</button>
            </div>
            <div class="pam-modal-body">
                @if (_annotLoading)
                {
                    <div class="pam-loading-text">Loading notes&#x2026;</div>
                }
                else if (_annotations == null || _annotations.Count == 0)
                {
                    <div class="pam-empty" style="padding:.5rem 0">No notes yet.</div>
                }
                else
                {
                    @foreach (var a in _annotations)
                    {
                        <div style="border:1px solid #30363d;border-radius:6px;padding:.75rem;margin-bottom:.5rem">
                            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:.25rem">
                                <strong style="font-size:0.85em">@(a.AuthorUsername ?? "Unknown")</strong>
                                <span style="font-size:0.75em;color:#888">@a.CreatedAtUtc.ToLocalTime().ToString("MM/dd HH:mm")</span>
                            </div>
                            <div style="white-space:pre-wrap;font-size:0.9em">@a.Note</div>
                        </div>
                    }
                }

                <div style="margin-top:1rem">
                    <label class="pam-label">Add Note</label>
                    <textarea class="pam-input" rows="3" style="width:100%" @bind="_newAnnotation"
                              placeholder="Enter note&#x2026;"></textarea>
                    @if (_annotError != null) { <div class="pam-alert pam-alert-danger" style="margin-top:4px">@_annotError</div> }
                    <button class="pam-btn pam-btn-primary" style="margin-top:.5rem"
                            @onclick="AddAnnotationAsync" disabled="@_annotSaving">
                        @if (_annotSaving) { <span class="pam-spinner-sm"></span> } Add Note
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* Restore Sessions Panel *@
@if (_showRestorePanel && _restorableSessions != null && _restorableSessions.Count > 0)
{
    <div class="pam-modal-overlay" @onclick="@(() => { _showRestorePanel = false; StateHasChanged(); })">
        <div class="pam-modal pam-modal-sm" @onclick:stopPropagation="true">
            <div class="pam-modal-header">
                <h3 class="pam-modal-title">&#x21BA; Restore Disconnected Sessions</h3>
                <button class="pam-modal-close" @onclick="@(() => { _showRestorePanel = false; StateHasChanged(); })">&#x2715;</button>
            </div>
            <div class="pam-modal-body">
                @if (_restoreResult != null)
                {
                    <div class="pam-alert pam-alert-success" style="margin-bottom:.75rem">@_restoreResult</div>
                }
                <table class="pam-table" style="font-size:.9em">
                    <thead>
                        <tr>
                            <th>Protocol</th>
                            <th>Disconnected</th>
                            <th>Expires</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _restorableSessions)
                        {
                            <tr>
                                <td><span class="pam-badge">@t.Protocol</span></td>
                                <td>@t.CreatedAtUtc.ToLocalTime().ToString("HH:mm:ss")</td>
                                <td>@t.ExpiresAtUtc.ToLocalTime().ToString("HH:mm:ss")</td>
                                <td style="display:flex;gap:4px">
                                    <button class="pam-btn pam-btn-primary pam-btn-sm"
                                            @onclick="@(() => RestoreTokenAsync(t.Id))"
                                            disabled="@_restoreBusy">
                                        @if (_restoreBusy) { <span class="pam-spinner-sm"></span> } Restore
                                    </button>
                                    <button class="pam-btn pam-btn-secondary pam-btn-sm"
                                            @onclick="@(() => CancelRestoreTokenAsync(t.Id))"
                                            disabled="@_restoreBusy">
                                        Cancel
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@* Handoff request modal *@
@if (_handoffSession != null)
{
    <div class="pam-modal-overlay" @onclick="CloseHandoffModal">
        <div class="pam-modal pam-modal-sm" @onclick:stopPropagation="true">
            <div class="pam-modal-header">
                <h3 class="pam-modal-title">&#x21C4; Request Session Handoff</h3>
                <button class="pam-close-btn" @onclick="CloseHandoffModal">&#215;</button>
            </div>
            <div class="pam-modal-body">
                <div style="margin-bottom:.75rem;font-size:0.9em;color:#aaa">
                    Transfer ownership of this active session to another admin.
                    The recipient has 15 minutes to accept or decline.
                </div>
                <label class="pam-label">Target Admin</label>
                <select class="pam-input pam-select" style="width:100%;margin-bottom:.75rem" @bind="_handoffTargetUserId">
                    <option value="">— Select admin —</option>
                    @if (_adminUsers != null)
                    {
                        @foreach (var u in _adminUsers)
                        {
                            <option value="@u.Id.ToString()">@(u.DisplayName ?? u.Username) (@u.Username)</option>
                        }
                    }
                </select>
                <label class="pam-label">Transfer Notes (optional)</label>
                <textarea class="pam-input" rows="3" style="width:100%" @bind="_handoffNotes"
                          placeholder="e.g. Shift change — please monitor the rm command in progress"></textarea>
                @if (_handoffError != null)
                {
                    <div class="pam-alert pam-alert-danger" style="margin-top:.5rem">@_handoffError</div>
                }
                @if (_handoffSuccess != null)
                {
                    <div class="pam-alert pam-alert-success" style="margin-top:.5rem">@_handoffSuccess</div>
                }
            </div>
            <div class="pam-modal-footer">
                <button class="pam-btn pam-btn-secondary" @onclick="CloseHandoffModal">Cancel</button>
                <button class="pam-btn pam-btn-primary" @onclick="SendHandoffRequestAsync"
                        disabled="@(_handoffSending || string.IsNullOrEmpty(_handoffTargetUserId))">
                    @if (_handoffSending) { <span class="pam-spinner-sm"></span> } Send Request
                </button>
            </div>
        </div>
    </div>
}

@* Pending handoffs panel *@
@if (_showPendingHandoffs)
{
    <div class="pam-modal-overlay" @onclick="ClosePendingHandoffsPanel">
        <div class="pam-modal" style="max-width:640px" @onclick:stopPropagation="true">
            <div class="pam-modal-header">
                <h3 class="pam-modal-title">&#x21C4; Pending Handoff Requests</h3>
                <button class="pam-close-btn" @onclick="ClosePendingHandoffsPanel">&#215;</button>
            </div>
            <div class="pam-modal-body">
                @if (_pendingHandoffs == null || _pendingHandoffs.Count == 0)
                {
                    <div class="pam-empty">No pending handoff requests.</div>
                }
                else
                {
                    @foreach (var h in _pendingHandoffs)
                    {
                        <div style="border:1px solid #30363d;border-radius:6px;padding:.75rem;margin-bottom:.5rem">
                            <div style="display:flex;justify-content:space-between;align-items:flex-start">
                                <div>
                                    <div style="font-weight:600;margin-bottom:.25rem">
                                        Session transfer from <strong>@(h.RequestedByUsername ?? "admin")</strong>
                                    </div>
                                    @if (!string.IsNullOrEmpty(h.TransferNotes))
                                    {
                                        <div style="font-size:0.85em;color:#ccc;margin-bottom:.25rem">@h.TransferNotes</div>
                                    }
                                    <div style="font-size:0.75em;color:#888">
                                        Requested @h.RequestedAtUtc.ToLocalTime().ToString("MM/dd HH:mm") —
                                        Expires @h.ExpiresAtUtc.ToLocalTime().ToString("HH:mm")
                                    </div>
                                </div>
                                <div style="display:flex;gap:.5rem;flex-shrink:0;margin-left:1rem">
                                    <button class="pam-btn pam-btn-primary pam-btn-sm"
                                            @onclick="@(() => AcceptHandoffAsync(h))"
                                            disabled="@_handoffActionBusy">
                                        Accept
                                    </button>
                                    <button class="pam-btn pam-btn-secondary pam-btn-sm"
                                            @onclick="@(() => DeclineHandoffAsync(h))"
                                            disabled="@_handoffActionBusy">
                                        Decline
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
                @if (_handoffActionResult != null)
                {
                    <div class="pam-alert pam-alert-success" style="margin-top:.5rem">@_handoffActionResult</div>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<SessionDto>? _sessions;
    private PageMeta?         _meta;
    private bool              _loading      = true;
    private string?           _error;
    private string            _statusFilter = "";
    private int               _page         = 1;
    private const int         _pageSize     = 20;

    // Tabs
    private string _activeTab = "sessions";

    // Compliance
    private SessionComplianceSummaryDto? _compliance;
    private bool                         _complianceLoading = false;
    private int                          _complianceDays    = 30;

    // Tags
    private SessionDto? _tagSession;
    private string      _tagInput   = "";
    private bool        _tagSaving  = false;

    // Annotations
    private string?                    _annotSessionId;
    private List<SessionAnnotationDto>? _annotations;
    private bool                       _annotLoading = false;
    private string                     _newAnnotation = "";
    private bool                       _annotSaving   = false;
    private string?                    _annotError;

    // Delegations
    private List<SessionDelegationDto>? _delegations;
    private bool                        _delegationLoading   = false;
    private bool                        _showCreateDelegation = false;
    private string                      _delegNewUserId      = "";
    private DateTime                    _delegExpires        = DateTime.UtcNow.AddHours(8);
    private int                         _delegMaxUses        = 1;
    private string                      _delegNote           = "";
    private bool                        _delegSaving         = false;
    private string?                     _delegError;
    private string?                     _delegSuccess;

    // Handoff — send
    private SessionDto? _handoffSession;
    private List<UserDto>? _adminUsers;
    private string      _handoffTargetUserId = "";
    private string      _handoffNotes        = "";
    private bool        _handoffSending      = false;
    private string?     _handoffError;
    private string?     _handoffSuccess;

    // Handoff — pending (incoming)
    private List<PendingHandoffDto>? _pendingHandoffs;
    private bool                     _showPendingHandoffs = false;
    private bool                     _handoffActionBusy   = false;
    private string?                  _handoffActionResult;

    // Session Restoration (#279 RA #47)
    private List<RestorableSessionDto>? _restorableSessions;
    private bool                        _showRestorePanel = false;
    private bool                        _restoreBusy      = false;
    private string?                     _restoreResult;

    private int TotalPages => _meta == null ? 1 : (int)Math.Ceiling(_meta.TotalCount / (double)_pageSize);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await Task.WhenAll(LoadAsync(), LoadPendingHandoffsAsync(), LoadRestorableSessionsAsync());
    }

    private async Task SwitchTab(string tab)
    {
        _activeTab = tab;
        _error = null;
        StateHasChanged();
        if (tab == "compliance" && _compliance == null)
            await LoadComplianceAsync();
        if (tab == "delegations" && _delegations == null)
            await LoadDelegationsAsync();
    }

    private async Task SetComplianceDays(int days)
    {
        _complianceDays = days;
        await LoadComplianceAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _error = null; StateHasChanged();
        var result = await Api.GetSessionsAsync(status: _statusFilter, page: _page, pageSize: _pageSize);
        if (result == null) _error = "Failed to load sessions.";
        else { _sessions = result.Data; _meta = result.Meta; }
        _loading = false; StateHasChanged();
    }

    private async Task LoadComplianceAsync()
    {
        _complianceLoading = true; _error = null; StateHasChanged();
        _compliance = await Api.GetSessionComplianceSummaryAsync(_complianceDays);
        if (_compliance == null) _error = "Failed to load compliance data.";
        _complianceLoading = false; StateHasChanged();
    }

    private static string StatusClass(string s) => s switch
    {
        "Active"       => "pam-status-active",
        "Completed"    => "pam-status-done",
        "Disconnected" => "pam-status-warning",
        _              => "pam-status-error"
    };

    private static string Duration(SessionDto s)
    {
        var end = s.EndedAtUtc ?? DateTime.UtcNow;
        var dur = end - s.StartedAtUtc;
        return dur.TotalHours >= 1
            ? $"{(int)dur.TotalHours}h {dur.Minutes}m"
            : $"{dur.Minutes}m {dur.Seconds}s";
    }

    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }

    private void ShadowAsync(string sessionId)
    {
        Nav.NavigateTo("/shadow/" + sessionId);
    }

    private async Task LoadRestorableSessionsAsync()
    {
        _restorableSessions = await Api.GetRestorableSessionsAsync();
        StateHasChanged();
    }

    private void OpenRestorePanel() { _showRestorePanel = true; _restoreResult = null; StateHasChanged(); }

    private async Task RestoreFromSessionAsync(Guid sessionId)
    {
        var token = _restorableSessions?.FirstOrDefault(t => t.OriginalSessionId == sessionId);
        if (token == null)
        {
            // Try to find a matching token from the restorable list or just reload
            await LoadRestorableSessionsAsync();
            token = _restorableSessions?.FirstOrDefault(t => t.OriginalSessionId == sessionId);
        }
        if (token == null) { _error = "No active restore token found for this session."; StateHasChanged(); return; }
        await RestoreTokenAsync(token.Id);
    }

    private async Task RestoreTokenAsync(Guid tokenId)
    {
        _restoreBusy = true; _restoreResult = null; StateHasChanged();
        var result = await Api.RestoreSessionAsync(tokenId);
        if (result == null)
            _restoreResult = "Restore failed — token may have expired.";
        else
            _restoreResult = $"New session started: {result.Protocol} → {result.TargetIpAddress}:{result.TargetPort} (ID: {result.NewSessionId})";

        _restoreBusy = false;
        await LoadRestorableSessionsAsync();
        await LoadAsync();
    }

    private async Task CancelRestoreTokenAsync(Guid tokenId)
    {
        await Api.CancelRestoreTokenAsync(tokenId);
        await LoadRestorableSessionsAsync();
    }

    private async Task ExportCsvAsync()
    {
        var csv = await Api.GetSessionsExportCsvAsync();
        if (csv == null) { _error = "Export failed."; StateHasChanged(); return; }
        await JS.InvokeVoidAsync("downloadCsvFile",
            "sessions-" + DateTime.Now.ToString("yyyyMMdd") + ".csv", csv);
    }

    private async Task ExportComplianceCsvAsync()
    {
        if (_compliance == null) return;
        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Compliance Report — " + DateTime.Now.ToString("yyyy-MM-dd"));
        sb.AppendLine($"Period,{_complianceDays} days");
        sb.AppendLine($"Compliance Rate,{_compliance.ComplianceRate}%");
        sb.AppendLine($"Total Sessions,{_compliance.TotalSessions}");
        sb.AppendLine($"Violated Sessions,{_compliance.ViolatedSessions}");
        sb.AppendLine($"Blocked Commands,{_compliance.BlockedCommands}");
        sb.AppendLine($"Admin Terminated,{_compliance.AdminTerminated}");
        sb.AppendLine();
        sb.AppendLine("Violation Type,Count");
        if (_compliance.ViolationTypes != null)
            foreach (var vt in _compliance.ViolationTypes)
                sb.AppendLine($"{vt.Key},{vt.Value}");
        sb.AppendLine();
        sb.AppendLine("Top Violating Users");
        sb.AppendLine("Username,Violations");
        if (_compliance.TopViolatingUsers != null)
            foreach (var u in _compliance.TopViolatingUsers)
                sb.AppendLine($"{u.Username},{u.ViolationCount}");
        sb.AppendLine();
        sb.AppendLine("Top Violating Devices");
        sb.AppendLine("Hostname,Violations");
        if (_compliance.TopViolatingDevices != null)
            foreach (var d in _compliance.TopViolatingDevices)
                sb.AppendLine($"{d.Hostname},{d.ViolationCount}");
        await JS.InvokeVoidAsync("downloadCsvFile",
            "compliance-" + DateTime.Now.ToString("yyyyMMdd") + ".csv", sb.ToString());
    }

    // ── Tags ────────────────────────────────────────────────────────────────────────────────────
    private void OpenTagModal(SessionDto s)
    {
        _tagSession = s;
        _tagInput   = s.Tags ?? "";
        StateHasChanged();
    }
    private void CloseTagModal() { _tagSession = null; StateHasChanged(); }

    private async Task SaveTagsAsync()
    {
        if (_tagSession == null) return;
        _tagSaving = true; StateHasChanged();
        var ok = await Api.UpdateSessionTagsAsync(_tagSession.Id.ToString(), _tagInput.Trim());
        _tagSaving = false;
        if (ok) { CloseTagModal(); await LoadAsync(); }
        else { _error = "Failed to save tags."; StateHasChanged(); }
    }

    // ── Annotations ──────────────────────────────────────────────────────────────────────────────────────
    private async Task OpenAnnotationsPanel(string sessionId)
    {
        _annotSessionId = sessionId;
        _newAnnotation  = "";
        _annotError     = null;
        _annotations    = null;
        StateHasChanged();
        _annotLoading = true; StateHasChanged();
        _annotations  = await Api.GetSessionAnnotationsAsync(sessionId);
        _annotLoading = false; StateHasChanged();
    }
    private void CloseAnnotationsPanel() { _annotSessionId = null; _annotations = null; StateHasChanged(); }

    private async Task AddAnnotationAsync()
    {
        if (string.IsNullOrWhiteSpace(_newAnnotation))
        { _annotError = "Note cannot be empty."; StateHasChanged(); return; }
        _annotSaving = true; _annotError = null; StateHasChanged();
        var result = await Api.AddSessionAnnotationAsync(_annotSessionId!, _newAnnotation.Trim());
        _annotSaving = false;
        if (result != null)
        {
            _newAnnotation = "";
            _annotations   = await Api.GetSessionAnnotationsAsync(_annotSessionId!);
        }
        else { _annotError = "Failed to add note."; }
        StateHasChanged();
    }

    // ── Handoff ───────────────────────────────────────────────────────────────────────────────────────
    private async Task OpenHandoffModal(SessionDto s)
    {
        _handoffSession      = s;
        _handoffTargetUserId = "";
        _handoffNotes        = "";
        _handoffError        = null;
        _handoffSuccess      = null;
        if (_adminUsers == null)
        {
            var users = await Api.GetUsersAsync(page: 1, pageSize: 100);
            _adminUsers = users?.Data?.Where(u => u.Status == "Active" && !u.IsServiceAccount).ToList();
        }
        StateHasChanged();
    }

    private void CloseHandoffModal()
    {
        _handoffSession = null;
        StateHasChanged();
    }

    private async Task SendHandoffRequestAsync()
    {
        if (_handoffSession == null || string.IsNullOrEmpty(_handoffTargetUserId)) return;
        if (!Guid.TryParse(_handoffTargetUserId, out var targetId))
        { _handoffError = "Invalid target user."; StateHasChanged(); return; }

        _handoffSending = true; _handoffError = null; _handoffSuccess = null; StateHasChanged();
        var result = await Api.RequestHandoffAsync(_handoffSession.Id.ToString(), targetId, _handoffNotes.Trim());
        _handoffSending = false;
        if (result != null)
        {
            _handoffSuccess = "Handoff request sent. The recipient has 15 minutes to accept.";
        }
        else
        {
            _handoffError = "Failed to send handoff request.";
        }
        StateHasChanged();
    }

    private async Task LoadPendingHandoffsAsync()
    {
        _pendingHandoffs = await Api.GetPendingHandoffsAsync();
        StateHasChanged();
    }

    private async Task OpenPendingHandoffsPanel()
    {
        await LoadPendingHandoffsAsync();
        _showPendingHandoffs = true;
        _handoffActionResult = null;
        StateHasChanged();
    }

    private void ClosePendingHandoffsPanel()
    {
        _showPendingHandoffs = false;
        StateHasChanged();
    }

    private async Task AcceptHandoffAsync(PendingHandoffDto h)
    {
        _handoffActionBusy = true; _handoffActionResult = null; StateHasChanged();
        var ok = await Api.AcceptHandoffAsync(h.SessionId.ToString(), h.Id);
        _handoffActionBusy = false;
        if (ok)
        {
            _handoffActionResult = "Session ownership transferred to you successfully.";
            await LoadPendingHandoffsAsync();
            await LoadAsync();
        }
        else
        {
            _handoffActionResult = "Failed to accept handoff (expired or already resolved).";
        }
        StateHasChanged();
    }

    private async Task DeclineHandoffAsync(PendingHandoffDto h)
    {
        _handoffActionBusy = true; _handoffActionResult = null; StateHasChanged();
        var ok = await Api.DeclineHandoffAsync(h.SessionId.ToString(), h.Id);
        _handoffActionBusy = false;
        if (ok)
        {
            _handoffActionResult = "Handoff request declined.";
            await LoadPendingHandoffsAsync();
        }
        else
        {
            _handoffActionResult = "Failed to decline handoff.";
        }
        StateHasChanged();
    }

    // ── Delegations ───────────────────────────────────────────────────────────────────────────────────
    private async Task LoadDelegationsAsync()
    {
        _delegationLoading = true; StateHasChanged();
        _delegations = await Api.GetDelegationsAsync();
        _delegationLoading = false; StateHasChanged();
    }

    private async Task OpenCreateDelegationModal()
    {
        _delegNewUserId = "";
        _delegExpires   = DateTime.UtcNow.AddHours(8);
        _delegMaxUses   = 1;
        _delegNote      = "";
        _delegError     = null;
        _delegSuccess   = null;
        if (_adminUsers == null)
        {
            var users = await Api.GetUsersAsync(page: 1, pageSize: 100);
            _adminUsers = users?.Data?.Where(u => u.Status == "Active" && !u.IsServiceAccount).ToList();
        }
        _showCreateDelegation = true;
        StateHasChanged();
    }

    private void CloseCreateDelegationModal()
    {
        _showCreateDelegation = false;
        StateHasChanged();
    }

    private async Task SubmitCreateDelegationAsync()
    {
        if (!Guid.TryParse(_delegNewUserId, out var delegateId))
        { _delegError = "Invalid delegate user."; StateHasChanged(); return; }
        if (_delegExpires <= DateTime.UtcNow)
        { _delegError = "Expiry must be in the future."; StateHasChanged(); return; }

        _delegSaving = true; _delegError = null; _delegSuccess = null; StateHasChanged();
        var result = await Api.CreateDelegationAsync(
            delegateId, null, null, null,
            _delegExpires.ToUniversalTime(), _delegMaxUses, _delegNote.Trim());
        _delegSaving = false;
        if (result != null)
        {
            _delegSuccess = "Delegation granted successfully.";
            await LoadDelegationsAsync();
        }
        else
        {
            _delegError = "Failed to create delegation.";
        }
        StateHasChanged();
    }

    private async Task RevokeDelegationAsync(Guid id)
    {
        var ok = await Api.RevokeDelegationAsync(id);
        if (ok) await LoadDelegationsAsync();
        else { _error = "Failed to revoke delegation."; StateHasChanged(); }
    }

    private static string DelegationStatusClass(string s) => s switch
    {
        "Active"  => "pam-badge-success",
        "Expired" => "pam-badge-warning",
        "Revoked" => "pam-badge-danger",
        "Used"    => "pam-badge-info",
        _         => ""
    };
}
