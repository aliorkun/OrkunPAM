                else if (_smsProvider == "netgsm")
                {
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;max-width:600px;margin-top:8px">
                        <div>
                            <label class="pam-label">Username</label>
                            <input class="pam-input" @bind="_smsNetgsmUser" placeholder="NetGSM username" />
                        </div>
                        <div>
                            <label class="pam-label">Password</label>
                            <input class="pam-input" type="password" @bind="_smsNetgsmPassword"
                                   placeholder="@(_smsNetgsmPasswordSet ? "(set — leave blank to keep)" : "NetGSM password")" />
                        </div>
                        <div>
                            <label class="pam-label">Originator (Header)</label>
                            <input class="pam-input" @bind="_smsNetgsmOriginator" placeholder="OrkunPAM" />
