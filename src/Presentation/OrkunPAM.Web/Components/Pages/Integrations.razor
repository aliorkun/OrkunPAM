                    <label class="pam-label">Provider</label>
                    <select class="pam-select" @bind="_smsProvider" style="max-width:300px">
                        <option value="">— Select Provider —</option>
                        <option value="twilio">Twilio</option>
                        <option value="netgsm">NetGSM (Turkey)</option>
                        <option value="webhook">Custom Webhook</option>
                    </select>
                </div>

                @if (_smsProvider == "twilio")
                {
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;max-width:600px;margin-top:8px">
                        <div>
                            <label class="pam-label">Account SID</label>
                            <input class="pam-input" @bind="_smsAccountSid" placeholder="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" />
                        </div>
                        <div>
                            <label class="pam-label">Auth Token</label>
