@page "/integrations"
@inject PamApiService Api

<PageTitle>Integrations — OrkunPAM</PageTitle>

<div class="pam-page-header">
    <h2 class="pam-page-title">Integrations</h2>
</div>

<div style="display:flex;gap:4px;margin-bottom:16px;flex-wrap:wrap">
    <button class="pam-btn @(_tab == "ldap" ? "pam-btn-primary" : "pam-btn-secondary")"
            @onclick="@(() => SetTab("ldap"))">&#x1F517; LDAP / AD</button>
    <button class="pam-btn @(_tab == "siem" ? "pam-btn-primary" : "pam-btn-secondary")"
            @onclick="@(() => SetTab("siem"))">&#x1F4E1; SIEM / Syslog</button>
    <button class="pam-btn @(_tab == "winauth" ? "pam-btn-primary" : "pam-btn-secondary")"
            @onclick="@(() => SetTab("winauth"))">&#x1FA9F; Windows Auth</button>
    <button class="pam-btn @(_tab == "itsm" ? "pam-btn-primary" : "pam-btn-secondary")"
            @onclick="@(() => SetTab("itsm"))">&#x1F3AB; ITSM</button>
    <button class="pam-btn @(_tab == "pki" ? "pam-btn-primary" : "pam-btn-secondary")"
            @onclick="@(() => SetTab("pki"))">&#x1F4DC; PKI / Smart Card</button>
    <button class="pam-btn @(_tab == "soar" ? "pam-btn-primary" : "pam-btn-secondary")"
            @onclick="@(() => SetTab("soar"))">&#x26A1; SOAR</button>
</div>

@if (_tab == "ldap")
{
    @if (_error != null) { <div class="pam-alert pam-alert-danger">@_error</div> }
    @if (_syncMsg != null) { <div class="pam-alert pam-alert-info">@_syncMsg</div> }

    <div class="pam-card" style="margin-bottom:16px">
        <div class="pam-card-body">
            <strong>Add LDAP Configuration</strong>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px">
                <input class="pam-input" placeholder="Name" @bind="_newName" />
                <input class="pam-input" placeholder="Host (e.g. dc.corp.local)" @bind="_newHost" />
                <input class="pam-input" placeholder="Port (389 / 636)" type="number" @bind="_newPort" />
                <input class="pam-input" placeholder="Base DN (e.g. DC=corp,DC=local)" @bind="_newBaseDn" />
                <input class="pam-input" placeholder="Bind DN (optional)" @bind="_newBindDn" />
                <input class="pam-input" placeholder="Sync Interval (minutes)" type="number" @bind="_newInterval" />
            </div>
            <div style="margin-top:8px;display:flex;align-items:center;gap:8px">
                <label><input type="checkbox" @bind="_newUseSsl" /> Use SSL (LDAPS)</label>
                <button class="pam-btn pam-btn-primary pam-btn-sm" @onclick="AddConfigAsync"
                        disabled="@_saving">Save</button>
            </div>
        </div>
    </div>

    <div class="pam-card">
        <div class="pam-card-body p-0">
            @if (_loading)
            {
                <div class="pam-loading-text p-4">Loading configurations…</div>
            }
            else if (_configs == null || _configs.Count == 0)
            {
                <div class="pam-empty p-4">No LDAP configurations. Add one above to enable AD synchronization.</div>
            }
            else
            {
                <table class="pam-table pam-table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Host</th>
                            <th>Port</th>
                            <th>Base DN</th>
                            <th>Interval</th>
                            <th>Last Sync</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in _configs)
                        {
                            <tr>
                                <td>@c.Name</td>
                                <td>@c.Host</td>
                                <td>@c.Port</td>
                                <td style="font-size:0.8em;max-width:200px;overflow:hidden;text-overflow:ellipsis">@c.BaseDn</td>
                                <td>@c.SyncIntervalMinutes min</td>
                                <td>@(c.LastSyncAtUtc?.ToLocalTime().ToString("MM/dd HH:mm") ?? "—")</td>
                                <td><span class="pam-status @(c.IsEnabled ? "pam-status-active" : "pam-status-error")">@(c.IsEnabled ? "Enabled" : "Disabled")</span></td>
                                <td>
                                    <button class="pam-btn pam-btn-secondary pam-btn-sm"
                                            @onclick="@(() => SyncNowAsync(c.Id))"
                                            disabled="@(_syncing == c.Id)">
                                        @(_syncing == c.Id ? "Syncing…" : "Sync Now")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@if (_tab == "siem")
{
    @if (_siemError != null) { <div class="pam-alert pam-alert-danger">@_siemError</div> }
    @if (_siemMsg != null) { <div class="pam-alert pam-alert-info">@_siemMsg</div> }

    <div class="pam-card" style="margin-bottom:16px">
        <div class="pam-card-body">
            <strong>Add SIEM Target</strong>
            <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px;margin-top:8px">
                <input class="pam-input" placeholder="Name (e.g. Splunk)" @bind="_siemName" />
                <input class="pam-input" placeholder="Host / IP" @bind="_siemHost" />
                <input class="pam-input" placeholder="Port" type="number" @bind="_siemPort" />
                <select class="pam-input" @bind="_siemProtocol">
                    <option value="UDP">UDP</option>
                    <option value="TCP">TCP</option>
                    <option value="TLS">TLS</option>
                </select>
                <select class="pam-input" @bind="_siemFormat">
                    <option value="CEF">CEF (ArcSight)</option>
                    <option value="Syslog-KV">Syslog Key-Value (Splunk / QRadar)</option>
                </select>
                <input class="pam-input" placeholder="Facility (0-23, default 16=local0)" type="number" @bind="_siemFacility" />
            </div>
            <div style="margin-top:8px">
                <button class="pam-btn pam-btn-primary pam-btn-sm" @onclick="AddSiemTargetAsync"
                        disabled="@_siemSaving">Add Target</button>
            </div>
        </div>
    </div>

    <div class="pam-card">
        <div class="pam-card-body p-0">
            @if (_siemLoading)
            {
                <div class="pam-loading-text p-4">Loading SIEM targets…</div>
            }
            else if (_siemTargets == null || _siemTargets.Count == 0)
            {
                <div class="pam-empty p-4">No SIEM targets configured. Add a target above to start forwarding PAM events to your SIEM (Splunk, IBM QRadar, Microsoft Sentinel, etc.).</div>
            }
            else
            {
                <table class="pam-table pam-table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Host:Port</th>
                            <th>Protocol</th>
                            <th>Format</th>
                            <th>Status</th>
                            <th>Last Sent</th>
                            <th>Events Sent</th>
                            <th>Last Error</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _siemTargets)
                        {
                            <tr>
                                <td>@t.Name</td>
                                <td>@t.Host:@t.Port</td>
                                <td>@t.Protocol</td>
                                <td>@t.Format</td>
                                <td><span class="pam-status @(t.IsEnabled ? "pam-status-active" : "pam-status-warning")">@(t.IsEnabled ? "Enabled" : "Disabled")</span></td>
                                <td>@(t.LastSentAtUtc?.ToLocalTime().ToString("MM/dd HH:mm") ?? "—")</td>
                                <td>@t.TotalEventsSent</td>
                                <td style="font-size:0.75em;max-width:180px;overflow:hidden;text-overflow:ellipsis;color:var(--pam-danger)">@(t.LastError ?? "")</td>
                                <td style="white-space:nowrap">
                                    <button class="pam-btn pam-btn-secondary pam-btn-sm"
                                            @onclick="@(() => ToggleSiemAsync(t.Id))"
                                            style="margin-right:4px">
                                        @(t.IsEnabled ? "Disable" : "Enable")
                                    </button>
                                    <button class="pam-btn pam-btn-secondary pam-btn-sm"
                                            @onclick="@(() => TestSiemAsync(t.Id))"
                                            style="margin-right:4px"
                                            disabled="@(_siemTesting == t.Id)">
                                        @(_siemTesting == t.Id ? "Testing…" : "Test")
                                    </button>
                                    <button class="pam-btn pam-btn-danger pam-btn-sm"
                                            @onclick="@(() => DeleteSiemAsync(t.Id))">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@if (_tab == "winauth")
{
    @if (_winAuthMsg != null) { <div class="pam-alert pam-alert-info">@_winAuthMsg</div> }
    @if (_winAuthError != null) { <div class="pam-alert pam-alert-danger">@_winAuthError</div> }

    <div class="pam-card">
        <div class="pam-card-body">
            <strong>Windows / Kerberos Authentication</strong>
            <p style="color:var(--pam-muted);font-size:0.85em;margin:4px 0 12px">
                Allow domain-joined browsers to log in via Kerberos SSO or NTLM — no password prompt.
                Requires the PAM server to run on Windows (or Linux with GSSAPI/Kerberos configured).
                Login URL: <code>/api/v1/auth/windows</code>
            </p>

            @if (_winAuthLoading)
            {
                <div class="pam-loading-text">Loading…</div>
            }
            else
            {
                <div style="display:flex;flex-direction:column;gap:12px;max-width:500px">
                    <label style="display:flex;align-items:center;gap:8px">
                        <input type="checkbox" @bind="_winEnabled" />
                        <span>Enable Windows / Kerberos Authentication</span>
                    </label>
                    <label style="display:flex;align-items:center;gap:8px">
                        <input type="checkbox" @bind="_winAutoProvision" />
                        <span>Auto-provision users on first login (creates PAM account from Windows identity)</span>
                    </label>
                    <label style="display:flex;align-items:center;gap:8px">
                        <input type="checkbox" @bind="_winMfaBypass" />
                        <span>Bypass MFA for Kerberos-authenticated users (Kerberos = strong auth)</span>
                    </label>
                    <div>
                        <label style="display:block;margin-bottom:4px;font-size:0.85em">
                            Trusted Domains (comma-separated, leave blank to allow all):
                        </label>
                        <input class="pam-input" placeholder="CORP,SUBSIDIARY" @bind="_winTrustedDomains" />
                        <div style="font-size:0.75em;color:var(--pam-muted);margin-top:2px">
                            Example: CORP,SUBSIDIARY — only users from these NETBIOS domains can log in.
                        </div>
                    </div>
                    <div>
                        <button class="pam-btn pam-btn-primary" @onclick="SaveWinAuthAsync"
                                disabled="@_winSaving">
                            @(_winSaving ? "Saving…" : "Save")
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (_tab == "itsm")
{
    @if (_itsmError != null) { <div class="pam-alert pam-alert-danger">@_itsmError</div> }
    @if (_itsmMsg != null) { <div class="pam-alert pam-alert-info">@_itsmMsg</div> }

    <div class="pam-card" style="margin-bottom:16px">
        <div class="pam-card-body">
            <strong>Add ITSM Integration</strong>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px">
                <input class="pam-input" placeholder="Name (e.g. ServiceNow Prod)" @bind="_itsmName" />
                <select class="pam-input pam-select" @bind="_itsmProvider">
                    <option value="ServiceNow">ServiceNow</option>
                    <option value="OneDesk">OneDesk</option>
                    <option value="Jira">Jira Service Management</option>
                    <option value="BMC">BMC Remedy</option>
                    <option value="Generic">Generic REST</option>
                </select>
                <input class="pam-input" placeholder="Base URL (https://instance.service-now.com)" @bind="_itsmBaseUrl" />
                <input class="pam-input" placeholder="Username (optional)" @bind="_itsmUsername" />
                <input type="password" class="pam-input" placeholder="API Key / OAuth Token" @bind="_itsmApiKey" />
                <input type="password" class="pam-input" placeholder="Password (optional)" @bind="_itsmPassword" />
            </div>
            <div style="margin-top:8px;display:flex;align-items:center;gap:16px">
                <label><input type="checkbox" @bind="_itsmRequireTicket" /> Require ticket number for access requests</label>
                <label><input type="checkbox" @bind="_itsmValidateTicket" /> Validate ticket via API before approval</label>
                <button class="pam-btn pam-btn-primary pam-btn-sm" @onclick="AddItsmAsync" disabled="@_itsmSaving">
                    @(_itsmSaving ? "Saving…" : "Add")
                </button>
            </div>
            <div style="margin-top:12px;padding:10px;background:#f8f9fa;border-radius:4px;font-size:0.82em">
                <strong>Inbound Webhook URL</strong> (ServiceNow calls this to approve/deny):
                <code style="display:block;margin-top:4px">POST /api/v1/integrations/itsm/inbound-approve</code>
                <span style="color:var(--pam-muted)">Body: <code>{ "ticketNumber":"INC001", "action":"approve", "provider":"ServiceNow" }</code></span><br />
                <span style="color:var(--pam-muted)">Header: <code>X-Itsm-Signature: &lt;HMAC-SHA256 of ticketNumber:action:provider&gt;</code></span>
            </div>
        </div>
    </div>

    <div class="pam-card">
        <div class="pam-card-body p-0">
            @if (_itsmLoading)
            {
                <div class="pam-loading-text p-4">Loading…</div>
            }
            else if (_itsmConfigs == null || _itsmConfigs.Count == 0)
            {
                <div class="pam-empty p-4">No ITSM integrations configured. Add one above to enable ticket-based access approval.</div>
            }
            else
            {
                <table class="pam-table pam-table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Provider</th>
                            <th>Base URL</th>
                            <th>Require Ticket</th>
                            <th>Validate</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cfg in _itsmConfigs)
                        {
                            <tr>
                                <td>@cfg.Name</td>
                                <td>@cfg.Provider</td>
                                <td style="font-size:0.8em;max-width:180px;overflow:hidden;text-overflow:ellipsis">@cfg.BaseUrl</td>
                                <td>@(cfg.RequireTicket ? "Yes" : "No")</td>
                                <td>@(cfg.ValidateTicket ? "Yes" : "No")</td>
                                <td><span class="pam-status @(cfg.IsEnabled ? "pam-status-active" : "pam-status-warning")">@(cfg.IsEnabled ? "Enabled" : "Disabled")</span></td>
                                <td style="white-space:nowrap">
                                    <button class="pam-btn pam-btn-secondary pam-btn-sm"
                                            @onclick="@(() => TestItsmAsync(cfg.Id))"
                                            style="margin-right:4px"
                                            disabled="@(_itsmTesting == cfg.Id)">
                                        @(_itsmTesting == cfg.Id ? "Testing…" : "Test")
                                    </button>
                                    <button class="pam-btn pam-btn-secondary pam-btn-sm"
                                            @onclick="@(() => ToggleItsmAsync(cfg.Id))"
                                            style="margin-right:4px">
                                        @(cfg.IsEnabled ? "Disable" : "Enable")
                                    </button>
                                    <button class="pam-btn pam-btn-danger pam-btn-sm"
                                            @onclick="@(() => DeleteItsmAsync(cfg.Id))">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@if (_tab == "pki")
{
    @if (_pkiError != null) { <div class="pam-alert pam-alert-danger">@_pkiError</div> }
    @if (_pkiMsg != null) { <div class="pam-alert pam-alert-info">@_pkiMsg</div> }

    <div style="display:flex;gap:8px;margin-bottom:12px">
        <button class="pam-btn @(_pkiSubTab == "cas" ? "pam-btn-primary" : "pam-btn-secondary")"
                @onclick="@(() => { _pkiSubTab = "cas"; StateHasChanged(); })">Trusted CAs</button>
        <button class="pam-btn @(_pkiSubTab == "users" ? "pam-btn-primary" : "pam-btn-secondary")"
                @onclick="@(() => { _pkiSubTab = "users"; StateHasChanged(); })">User Certificates</button>
    </div>

    @if (_pkiSubTab == "cas")
    {
        <div class="pam-card" style="margin-bottom:16px">
            <div class="pam-card-body">
                <strong>Add Trusted CA Certificate</strong>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px">
                    <input class="pam-input" placeholder="CA Name (e.g. Corporate Root CA)" @bind="_caName" />
                    <input class="pam-input" placeholder="OCSP URL (optional)" @bind="_caOcspUrl" />
                    <input class="pam-input" placeholder="CRL Distribution URL (optional)" @bind="_caCrlUrl" />
                </div>
                <div style="margin-top:8px">
                    <label class="pam-label">CA Certificate (PEM format)</label>
                    <textarea class="pam-input" rows="6" style="font-family:monospace;font-size:0.78em"
                              placeholder="-----BEGIN CERTIFICATE-----&#10;…&#10;-----END CERTIFICATE-----"
                              @bind="_caPem"></textarea>
                </div>
                <div style="margin-top:8px;display:flex;align-items:center;gap:12px">
                    <label><input type="checkbox" @bind="_caCheckRevocation" /> Check revocation (OCSP/CRL)</label>
                    <button class="pam-btn pam-btn-primary pam-btn-sm" @onclick="AddTrustedCaAsync" disabled="@_pkiSaving">
                        @(_pkiSaving ? "Adding…" : "Add CA")
                    </button>
                </div>
            </div>
        </div>

        <div class="pam-card">
            <div class="pam-card-body p-0">
                @if (_pkiLoading)
                {
                    <div class="pam-loading-text p-4">Loading…</div>
                }
                else if (_trustedCas == null || _trustedCas.Count == 0)
                {
                    <div class="pam-empty p-4">No trusted CA certificates. Add a CA above to enable PKI / Smart Card authentication.</div>
                }
                else
                {
                    <table class="pam-table pam-table-hover">
                        <thead>
                            <tr><th>Name</th><th>Subject</th><th>Thumbprint</th><th>Valid Until</th><th>Status</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var ca in _trustedCas)
                            {
                                <tr>
                                    <td>@ca.Name</td>
                                    <td style="font-size:0.78em;max-width:200px;overflow:hidden;text-overflow:ellipsis">@ca.Subject</td>
                                    <td style="font-family:monospace;font-size:0.72em">@ca.Thumbprint[..16]…</td>
                                    <td>@ca.NotAfter.ToLocalTime().ToString("yyyy-MM-dd")</td>
                                    <td><span class="pam-status @(ca.IsEnabled ? "pam-status-active" : "pam-status-warning")">@(ca.IsEnabled ? "Enabled" : "Disabled")</span></td>
                                    <td style="white-space:nowrap">
                                        <button class="pam-btn pam-btn-secondary pam-btn-sm"
                                                @onclick="@(() => ToggleCaAsync(ca.Id))"
                                                style="margin-right:4px">
                                            @(ca.IsEnabled ? "Disable" : "Enable")
                                        </button>
                                        <button class="pam-btn pam-btn-danger pam-btn-sm"
                                                @onclick="@(() => DeleteCaAsync(ca.Id))">Delete</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }

    @if (_pkiSubTab == "users")
    {
        <div class="pam-card" style="margin-bottom:16px">
            <div class="pam-card-body">
                <strong>Map User to Certificate</strong>
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:8px">
                    <input class="pam-input" placeholder="User ID (UUID)" @bind="_pkiUserId" />
                </div>
                <div style="margin-top:8px">
                    <label class="pam-label">User Certificate (PEM format)</label>
                    <textarea class="pam-input" rows="6" style="font-family:monospace;font-size:0.78em"
                              placeholder="-----BEGIN CERTIFICATE-----&#10;…&#10;-----END CERTIFICATE-----"
                              @bind="_pkiUserPem"></textarea>
                </div>
                <div style="margin-top:8px;display:flex;align-items:center;gap:12px">
                    <label><input type="checkbox" @bind="_pkiRequireOnly" /> Require PKI-only login (disable password for this user)</label>
                    <button class="pam-btn pam-btn-primary pam-btn-sm" @onclick="MapUserCertAsync" disabled="@_pkiUserSaving">
                        @(_pkiUserSaving ? "Mapping…" : "Map Certificate")
                    </button>
                </div>
            </div>
        </div>

        <div class="pam-card">
            <div class="pam-card-body p-0">
                @if (_pkiUserLoading)
                {
                    <div class="pam-loading-text p-4">Loading…</div>
                }
                else if (_pkiUserCerts == null || _pkiUserCerts.Count == 0)
                {
                    <div class="pam-empty p-4">No user certificates mapped. Map a certificate above to allow PKI / Smart Card login.</div>
                }
                else
                {
                    <table class="pam-table pam-table-hover">
                        <thead>
                            <tr><th>Username</th><th>Subject DN</th><th>Thumbprint</th><th>Expires</th><th>PKI-Only</th><th>Last Used</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var uc in _pkiUserCerts)
                            {
                                <tr>
                                    <td>@uc.Username</td>
                                    <td style="font-size:0.78em;max-width:180px;overflow:hidden;text-overflow:ellipsis">@uc.SubjectDn</td>
                                    <td style="font-family:monospace;font-size:0.72em">@uc.CertThumbprint[..16]…</td>
                                    <td>@uc.ExpiresAtUtc.ToLocalTime().ToString("yyyy-MM-dd")</td>
                                    <td>@(uc.RequirePkiOnly ? "Yes" : "No")</td>
                                    <td>@(uc.LastUsedAtUtc?.ToLocalTime().ToString("MM/dd HH:mm") ?? "—")</td>
                                    <td>
                                        <button class="pam-btn pam-btn-danger pam-btn-sm"
                                                @onclick="@(() => DeleteUserCertAsync(uc.Id))">Remove</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
}

@if (_tab == "soar")
{
    @if (_soarError != null) { <div class="pam-alert pam-alert-danger">@_soarError</div> }
    @if (_soarMsg != null)   { <div class="pam-alert pam-alert-success">@_soarMsg</div> }

    <div class="pam-card" style="margin-bottom:1rem">
        <div class="pam-card-body">
            <p style="margin-bottom:1rem;font-size:0.9rem;color:#aaa">
                Configure SOAR providers (Splunk SOAR, Palo Alto XSOAR, Generic REST) for bi-directional PAM-SOC automation.
                Inbound SOAR actions require <code>X-Soar-Config-Id</code> and <code>X-Soar-Signature</code> headers (HMAC-SHA256).
            </p>
            <h4 style="margin-bottom:0.75rem">Add SOAR Provider</h4>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;max-width:600px">
                <input class="pam-input" @bind="_soarName" placeholder="Config name (e.g. Splunk SOAR Prod)" />
                <select class="pam-select" @bind="_soarProvider">
                    <option value="SplunkSOAR">Splunk SOAR</option>
                    <option value="PaloAltoXSOAR">Palo Alto XSOAR</option>
                    <option value="GenericREST">Generic REST</option>
                </select>
                <input class="pam-input" @bind="_soarWebhookUrl" placeholder="SOAR webhook URL (PAM → SOAR outbound)" />
                <input class="pam-input" @bind="_soarSecret" placeholder="HMAC signing secret (SOAR → PAM inbound)" type="password" />
            </div>
            <button class="pam-btn pam-btn-primary" style="margin-top:8px"
                    @onclick="AddSoarAsync" disabled="@_soarSaving">
                @(_soarSaving ? "Adding..." : "Add Provider")
            </button>
        </div>
    </div>

    <div class="pam-card">
        <div class="pam-card-body">
            @if (_soarLoading)
            {
                <div class="pam-loading-text">Loading SOAR configurations...</div>
            }
            else if (_soarConfigs == null || _soarConfigs.Count == 0)
            {
                <div class="pam-empty">No SOAR providers configured.</div>
            }
            else
            {
                <table class="pam-table">
                    <thead>
                        <tr><th>Name</th><th>Provider</th><th>Webhook URL</th><th>Status</th><th>Actions</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _soarConfigs)
                        {
                            <tr>
                                <td>@(s.Name ?? "—")</td>
                                <td>@(s.Provider ?? "—")</td>
                                <td style="font-size:0.8rem;max-width:200px;overflow:hidden;text-overflow:ellipsis">@(s.WebhookUrl ?? "—")</td>
                                <td>@((MarkupString)(s.IsEnabled ? "<span class=\"pam-badge pam-badge-green\">Enabled</span>" : "<span class=\"pam-badge pam-badge-gray\">Disabled</span>"))</td>
                                <td>
                                    <button class="pam-btn pam-btn-sm pam-btn-secondary"
                                            @onclick="@(() => ToggleSoarAsync(s.Id ?? ""))">
                                        @(s.IsEnabled ? "Disable" : "Enable")
                                    </button>
                                    <button class="pam-btn pam-btn-sm pam-btn-secondary"
                                            @onclick="@(() => TestSoarAsync(s.Id ?? ""))">Test</button>
                                    <button class="pam-btn pam-btn-sm pam-btn-danger"
                                            @onclick="@(() => DeleteSoarAsync(s.Id ?? ""))">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div style="margin-top:1.5rem;padding:1rem;background:#1a1a2e;border-radius:6px;font-size:0.85rem">
                    <strong>Inbound SOAR Action Endpoints:</strong>
                    <ul style="margin-top:0.5rem;color:#aaa;list-style:disc;padding-left:1.5rem">
                        <li><code>POST /api/v1/integrations/soar/terminate-session</code></li>
                        <li><code>POST /api/v1/integrations/soar/lock-account</code></li>
                        <li><code>POST /api/v1/integrations/soar/revoke-jit</code></li>
                        <li><code>POST /api/v1/integrations/soar/rotate-credential</code></li>
                        <li><code>GET /api/v1/integrations/soar/session-details/{id}</code></li>
                    </ul>
                    <div style="margin-top:0.5rem;color:#888">
                        Required headers: <code>X-Soar-Config-Id</code>, <code>X-Soar-Signature: sha256=...</code>, <code>X-Soar-Timestamp</code>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private string _tab = "ldap";
    private bool _loading = true;

    // SOAR state (#197)
    private List<SoarConfigDto>? _soarConfigs;
    private bool _soarLoading;
    private bool _soarSaving;
    private string? _soarError;
    private string? _soarMsg;
    private string _soarName = "";
    private string _soarProvider = "SplunkSOAR";
    private string _soarWebhookUrl = "";
    private string _soarSecret = "";

    // ITSM state
    private bool _itsmLoading;
    private bool _itsmSaving;
    private string? _itsmError;
    private string? _itsmMsg;
    private string? _itsmTesting;
    private List<ItsmConfigDto>? _itsmConfigs;
    private string _itsmName = "";
    private string _itsmProvider = "ServiceNow";
    private string _itsmBaseUrl = "";
    private string _itsmUsername = "";
    private string _itsmApiKey = "";
    private string _itsmPassword = "";
    private bool _itsmRequireTicket = true;
    private bool _itsmValidateTicket = true;

    // PKI state
    private bool _pkiLoading;
    private bool _pkiSaving;
    private bool _pkiUserLoading;
    private bool _pkiUserSaving;
    private string? _pkiError;
    private string? _pkiMsg;
    private string _pkiSubTab = "cas";
    private List<TrustedCaDto>? _trustedCas;
    private List<PkiUserCertDto>? _pkiUserCerts;
    private string _caName = "";
    private string _caPem = "";
    private string _caOcspUrl = "";
    private string _caCrlUrl = "";
    private bool _caCheckRevocation = true;
    private string _pkiUserId = "";
    private string _pkiUserPem = "";
    private bool _pkiRequireOnly;
    private bool _saving;
    private string? _error;
    private string? _syncMsg;
    private string? _syncing;
    private List<LdapConfigDto>? _configs;

    private string _newName = "";
    private string _newHost = "";
    private int _newPort = 389;
    private string _newBaseDn = "";
    private string _newBindDn = "";
    private int _newInterval = 60;
    private bool _newUseSsl = true;

    private bool _siemLoading;
    private bool _siemSaving;
    private string? _siemError;
    private string? _siemMsg;
    private string? _siemTesting;
    private List<SiemTargetDto>? _siemTargets;

    // Windows Auth state
    private bool _winAuthLoading;
    private bool _winSaving;
    private string? _winAuthError;
    private string? _winAuthMsg;
    private bool _winEnabled;
    private bool _winAutoProvision;
    private bool _winMfaBypass;
    private string _winTrustedDomains = "";

    private string _siemName = "";
    private string _siemHost = "";
    private int _siemPort = 514;
    private string _siemProtocol = "UDP";
    private string _siemFormat = "CEF";
    private int _siemFacility = 16;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAsync();
    }

    private async Task SetTab(string tab)
    {
        _tab = tab;
        if (tab == "siem" && _siemTargets == null)
            await LoadSiemAsync();
        if (tab == "winauth")
            await LoadWinAuthAsync();
        if (tab == "itsm" && _itsmConfigs == null)
            await LoadItsmAsync();
        if (tab == "pki" && _trustedCas == null)
            await LoadPkiAsync();
        if (tab == "soar" && _soarConfigs == null)
            await LoadSoarAsync();
    }

    // ── ITSM ────────────────────────────────────────────────────────────────────────────
    private async Task LoadItsmAsync()
    {
        _itsmLoading = true; _itsmError = null; StateHasChanged();
        _itsmConfigs = await Api.GetItsmConfigsAsync();
        _itsmLoading = false; StateHasChanged();
    }

    private async Task AddItsmAsync()
    {
        if (string.IsNullOrWhiteSpace(_itsmName) || string.IsNullOrWhiteSpace(_itsmBaseUrl))
        {
            _itsmError = "Name and Base URL are required.";
            StateHasChanged();
            return;
        }
        _itsmSaving = true; _itsmError = null; StateHasChanged();
        var ok = await Api.CreateItsmConfigAsync(_itsmName, _itsmProvider, _itsmBaseUrl,
            string.IsNullOrEmpty(_itsmUsername) ? null : _itsmUsername,
            string.IsNullOrEmpty(_itsmApiKey) ? null : _itsmApiKey,
            string.IsNullOrEmpty(_itsmPassword) ? null : _itsmPassword,
            _itsmRequireTicket, _itsmValidateTicket);
        _itsmSaving = false;
        if (ok)
        {
            _itsmName = _itsmBaseUrl = _itsmUsername = _itsmApiKey = _itsmPassword = "";
            _itsmMsg = "ITSM integration added.";
            await LoadItsmAsync();
        }
        else { _itsmError = "Failed to add ITSM integration."; StateHasChanged(); }
    }

    private async Task TestItsmAsync(string id)
    {
        _itsmTesting = id; _itsmMsg = null; _itsmError = null; StateHasChanged();
        var r = await Api.TestItsmConfigAsync(id);
        _itsmTesting = null;
        if (r != null)
            _itsmMsg = $"Connected to {r.Provider} ({r.BaseUrl}) — {r.ResponseTimeMs} ms. {r.Message}";
        else
            _itsmError = "Connection test failed.";
        StateHasChanged();
    }

    private async Task ToggleItsmAsync(string id)
    {
        _itsmMsg = null; _itsmError = null;
        var ok = await Api.ToggleItsmConfigAsync(id);
        if (ok) await LoadItsmAsync();
        else { _itsmError = "Failed to toggle."; StateHasChanged(); }
    }

    private async Task DeleteItsmAsync(string id)
    {
        _itsmMsg = null; _itsmError = null;
        var ok = await Api.DeleteItsmConfigAsync(id);
        if (ok) await LoadItsmAsync();
        else { _itsmError = "Failed to delete."; StateHasChanged(); }
    }

    // ── PKI ─────────────────────────────────────────────────────────────────────────────
    private async Task LoadPkiAsync()
    {
        _pkiLoading = true; _pkiUserLoading = true; _pkiError = null; StateHasChanged();
        _trustedCas = await Api.GetTrustedCasAsync();
        _pkiUserCerts = await Api.GetPkiUserCertsAsync();
        _pkiLoading = false; _pkiUserLoading = false; StateHasChanged();
    }

    private async Task AddTrustedCaAsync()
    {
        if (string.IsNullOrWhiteSpace(_caName) || string.IsNullOrWhiteSpace(_caPem))
        {
            _pkiError = "Name and PEM certificate are required.";
            StateHasChanged();
            return;
        }
        _pkiSaving = true; _pkiError = null; StateHasChanged();
        var ok = await Api.AddTrustedCaAsync(_caName, _caPem,
            string.IsNullOrEmpty(_caOcspUrl) ? null : _caOcspUrl,
            string.IsNullOrEmpty(_caCrlUrl) ? null : _caCrlUrl, _caCheckRevocation);
        _pkiSaving = false;
        if (ok)
        {
            _caName = _caPem = _caOcspUrl = _caCrlUrl = "";
            _pkiMsg = "Trusted CA added.";
            await LoadPkiAsync();
        }
        else { _pkiError = "Failed to add CA. Check PEM format."; StateHasChanged(); }
    }

    private async Task ToggleCaAsync(string id)
    {
        _pkiMsg = null; _pkiError = null;
        var ok = await Api.ToggleTrustedCaAsync(id);
        if (ok) await LoadPkiAsync();
        else { _pkiError = "Failed to toggle CA."; StateHasChanged(); }
    }

    private async Task DeleteCaAsync(string id)
    {
        _pkiMsg = null; _pkiError = null;
        var ok = await Api.DeleteTrustedCaAsync(id);
        if (ok) await LoadPkiAsync();
        else { _pkiError = "Failed to delete CA."; StateHasChanged(); }
    }

    private async Task MapUserCertAsync()
    {
        if (string.IsNullOrWhiteSpace(_pkiUserId) || string.IsNullOrWhiteSpace(_pkiUserPem))
        {
            _pkiError = "User ID and PEM certificate are required.";
            StateHasChanged();
            return;
        }
        if (!Guid.TryParse(_pkiUserId, out _))
        {
            _pkiError = "User ID must be a valid UUID.";
            StateHasChanged();
            return;
        }
        _pkiUserSaving = true; _pkiError = null; StateHasChanged();
        var ok = await Api.MapUserCertAsync(_pkiUserId, _pkiUserPem, _pkiRequireOnly);
        _pkiUserSaving = false;
        if (ok)
        {
            _pkiUserId = _pkiUserPem = "";
            _pkiMsg = "Certificate mapped to user.";
            await LoadPkiAsync();
        }
        else { _pkiError = "Failed to map certificate. Check User ID and PEM format."; StateHasChanged(); }
    }

    private async Task DeleteUserCertAsync(string id)
    {
        _pkiMsg = null; _pkiError = null;
        var ok = await Api.DeletePkiUserCertAsync(id);
        if (ok) await LoadPkiAsync();
        else { _pkiError = "Failed to remove certificate."; StateHasChanged(); }
    }

    private async Task LoadWinAuthAsync()
    {
        _winAuthLoading = true; _winAuthError = null; StateHasChanged();
        var s = await Api.GetWindowsAuthSettingsAsync();
        if (s != null)
        {
            _winEnabled = s.Enabled;
            _winAutoProvision = s.AutoProvision;
            _winMfaBypass = s.MfaBypass;
            _winTrustedDomains = s.TrustedDomains;
        }
        _winAuthLoading = false; StateHasChanged();
    }

    private async Task SaveWinAuthAsync()
    {
        _winSaving = true; _winAuthMsg = null; _winAuthError = null; StateHasChanged();
        var ok = await Api.SaveWindowsAuthSettingsAsync(_winEnabled, _winAutoProvision, _winMfaBypass, _winTrustedDomains);
        _winSaving = false;
        if (ok) _winAuthMsg = "Windows Auth settings saved.";
        else _winAuthError = "Failed to save settings.";
        StateHasChanged();
    }

    private async Task LoadAsync()
    {
        _loading = true; _error = null; StateHasChanged();
        _configs = await Api.GetLdapConfigsAsync();
        _loading = false; StateHasChanged();
    }

    private async Task LoadSiemAsync()
    {
        _siemLoading = true; _siemError = null; StateHasChanged();
        _siemTargets = await Api.GetSiemTargetsAsync();
        _siemLoading = false; StateHasChanged();
    }

    private async Task AddConfigAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(_newHost) || string.IsNullOrWhiteSpace(_newBaseDn))
        {
            _error = "Name, Host and Base DN are required.";
            StateHasChanged();
            return;
        }
        _saving = true; _error = null; StateHasChanged();
        var ok = await Api.CreateLdapConfigAsync(_newName, _newHost, _newPort, _newUseSsl,
            _newBaseDn, string.IsNullOrWhiteSpace(_newBindDn) ? null : _newBindDn, _newInterval);
        _saving = false;
        if (ok) { _newName = _newHost = _newBaseDn = _newBindDn = ""; await LoadAsync(); }
        else { _error = "Failed to create LDAP configuration."; StateHasChanged(); }
    }

    private async Task SyncNowAsync(string configId)
    {
        _syncing = configId; _syncMsg = null; _error = null; StateHasChanged();
        var result = await Api.SyncLdapNowAsync(configId);
        _syncing = null;
        if (result == null) { _error = "Sync request failed."; }
        else { _syncMsg = $"Sync complete — Created: {result.UsersAdded}, Updated: {result.UsersUpdated}, Disabled: {result.UsersDisabled}"; await LoadAsync(); }
        StateHasChanged();
    }

    private async Task AddSiemTargetAsync()
    {
        if (string.IsNullOrWhiteSpace(_siemName) || string.IsNullOrWhiteSpace(_siemHost))
        {
            _siemError = "Name and Host are required.";
            StateHasChanged();
            return;
        }
        _siemSaving = true; _siemError = null; StateHasChanged();
        var ok = await Api.CreateSiemTargetAsync(_siemName, _siemHost, _siemPort,
            _siemProtocol, _siemFormat, _siemFacility);
        _siemSaving = false;
        if (ok) { _siemName = _siemHost = ""; _siemPort = 514; await LoadSiemAsync(); }
        else { _siemError = "Failed to add SIEM target."; StateHasChanged(); }
    }

    private async Task ToggleSiemAsync(string id)
    {
        _siemMsg = null; _siemError = null;
        var ok = await Api.ToggleSiemTargetAsync(id);
        if (ok) await LoadSiemAsync();
        else { _siemError = "Failed to toggle SIEM target."; StateHasChanged(); }
    }

    private async Task TestSiemAsync(string id)
    {
        _siemTesting = id; _siemMsg = null; _siemError = null; StateHasChanged();
        var (success, error, ms) = await Api.TestSiemTargetAsync(id);
        _siemTesting = null;
        if (success) _siemMsg = "Test message sent successfully (" + ms + " ms)";
        else _siemError = "Test failed: " + (error ?? "unknown error");
        StateHasChanged();
    }

    private async Task DeleteSiemAsync(string id)
    {
        _siemMsg = null; _siemError = null;
        var ok = await Api.DeleteSiemTargetAsync(id);
        if (ok) await LoadSiemAsync();
        else { _siemError = "Failed to delete SIEM target."; StateHasChanged(); }
    }

    // SOAR methods (#197)
    private async Task LoadSoarAsync()
    {
        _soarLoading = true; StateHasChanged();
        _soarConfigs = await Api.GetSoarConfigsAsync();
        _soarLoading = false; StateHasChanged();
    }

    private async Task AddSoarAsync()
    {
        if (string.IsNullOrWhiteSpace(_soarName) || string.IsNullOrWhiteSpace(_soarSecret))
        { _soarError = "Name and HMAC secret are required."; return; }
        _soarSaving = true; _soarError = null; StateHasChanged();
        var ok = await Api.CreateSoarConfigAsync(_soarName, _soarProvider, _soarWebhookUrl, _soarSecret);
        _soarSaving = false;
        if (ok) { _soarMsg = "SOAR provider added."; _soarName = _soarWebhookUrl = _soarSecret = ""; await LoadSoarAsync(); }
        else { _soarError = "Failed to add SOAR provider."; StateHasChanged(); }
    }

    private async Task ToggleSoarAsync(string id)
    {
        _soarMsg = null; _soarError = null;
        var ok = await Api.ToggleSoarConfigAsync(id);
        if (ok) await LoadSoarAsync();
        else { _soarError = "Failed to toggle."; StateHasChanged(); }
    }

    private async Task TestSoarAsync(string id)
    {
        _soarMsg = null; _soarError = null;
        var ok = await Api.TestSoarConfigAsync(id);
        _soarMsg = ok ? "Test webhook sent successfully." : null;
        if (!ok) _soarError = "Test webhook delivery failed.";
        StateHasChanged();
    }

    private async Task DeleteSoarAsync(string id)
    {
        _soarMsg = null; _soarError = null;
        var ok = await Api.DeleteSoarConfigAsync(id);
        if (ok) { _soarMsg = "SOAR provider removed."; await LoadSoarAsync(); }
        else { _soarError = "Failed to delete."; StateHasChanged(); }
    }
}
