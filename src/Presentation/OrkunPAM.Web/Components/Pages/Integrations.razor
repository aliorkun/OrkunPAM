                else if (_smsProvider == "webhook")
                {
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;max-width:600px;margin-top:8px">
                        <div style="grid-column:1/-1">
                            <label class="pam-label">Webhook URL</label>
                            <input class="pam-input" @bind="_smsWebhookUrl" placeholder="https://your-sms-provider.com/send" />
                            <span class="pam-hint">POST JSON: { "to": "+1...", "message": "..." }</span>
                        </div>
                        <div>
                            <label class="pam-label">Signing Secret (optional)</label>
                            <input class="pam-input" type="password" @bind="_smsWebhookSecret"
                                   placeholder="@(_smsWebhookSecretSet ? "(set — leave blank to keep)" : "Optional HMAC secret")" />
                            <span class="pam-hint">Sent as X-OrkunPAM-Secret header</span>
                        </div>
                    </div>
                }

                <button class="pam-btn pam-btn-primary" style="margin-top:1rem"
                        @onclick="SaveSmsConfigAsync" disabled="@(_smsSaving || string.IsNullOrEmpty(_smsProvider))">
                    @(_smsSaving ? "Saving..." : "Save SMS Gateway")
                </button>
            }
        </div>
    </div>
}

@if (_tab == "hwtoken")
{
    @if (_hwtError != null) { <div class="pam-alert pam-alert-danger">@_hwtError</div> }
    @if (_hwtMsg != null)   { <div class="pam-alert pam-alert-success">@_hwtMsg</div> }

    <div class="pam-card" style="margin-bottom:16px">
        <div class="pam-card-header"><strong>Provision Hardware Token</strong></div>
        <div class="pam-card-body">
            <p style="color:#8b949e;font-size:.85rem;margin-bottom:12px">
                Register OATH HOTP/TOTP hardware tokens (RSA SecurID, YubiKey OTP, SafeNet eToken).
                The secret key is stored encrypted and never exposed after provisioning.
            </p>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;max-width:700px">
                <div>
                    <label class="pam-label">User ID (GUID)</label>
                    <input class="pam-input" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" @bind="_hwtUserId" />
                </div>
                <div>
                    <label class="pam-label">Serial Number</label>
                    <input class="pam-input" placeholder="e.g. SN123456789" @bind="_hwtSerial" />
                </div>
                <div>
                    <label class="pam-label">Secret Key (Base32)</label>
                    <input class="pam-input" type="password" placeholder="JBSWY3DPEHPK3PXP..." @bind="_hwtSecret" />
                </div>
                <div>
                    <label class="pam-label">Label (optional)</label>
                    <input class="pam-input" placeholder="e.g. RSA Token for VPN" @bind="_hwtLabel" />
                </div>
                <div>
                    <label class="pam-label">Token Type</label>
                    <select class="pam-select" @bind="_hwtTokenType">
                        <option value="Totp">TOTP (time-based)</option>
                        <option value="Hotp">HOTP (counter-based)</option>
                    </select>
                </div>
                <div>
                    <label class="pam-label">Algorithm</label>
                    <select class="pam-select" @bind="_hwtAlgorithm">
                        <option value="Sha1">SHA-1 (most common)</option>
                        <option value="Sha256">SHA-256</option>
                        <option value="Sha512">SHA-512</option>
                    </select>
                </div>
                <div>
                    <label class="pam-label">Digits</label>
                    <select class="pam-select" @bind="_hwtDigits">
                        <option value="6">6 digits</option>
                        <option value="8">8 digits</option>
                    </select>
                </div>
                <div>
                    <label class="pam-label">Period (seconds, TOTP only)</label>
                    <input class="pam-input" type="number" @bind="_hwtPeriod" min="30" max="60" step="30" />
                </div>
            </div>
            <button class="pam-btn pam-btn-primary" style="margin-top:12px"
                    @onclick="ProvisionTokenAsync" disabled="@_hwtSaving">
                @(_hwtSaving ? "Provisioning..." : "Provision Token")
            </button>
        </div>
    </div>

    <div class="pam-card">
        <div class="pam-card-header"><strong>Provisioned Tokens</strong></div>
        <div class="pam-card-body p-0">
            @if (_hwtLoading)
            {
                <div class="pam-loading-text p-4">Loading tokens...</div>
            }
            else if (_hwtTokens == null || _hwtTokens.Count == 0)
            {
                <div class="pam-empty p-4">No hardware tokens provisioned yet.</div>
            }
            else
            {
                <table class="pam-table pam-table-hover">
                    <thead>
                        <tr>
                            <th>Serial</th><th>Label</th><th>Type</th><th>Algorithm</th><th>Digits</th><th>Counter</th><th>User</th><th>Provisioned</th><th>Status</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in _hwtTokens)
                        {
                            <tr>
                                <td>@t.SerialNumber</td>
                                <td>@(t.Label ?? "—")</td>
                                <td>@t.TokenType</td>
                                <td>@t.Algorithm</td>
                                <td>@t.Digits</td>
                                <td>@(t.TokenType == "Hotp" ? t.CounterValue.ToString() : "—")</td>
                                <td style="font-size:.8em">@t.UserId</td>
                                <td>@t.ProvisionedAtUtc.ToLocalTime().ToString("MM/dd/yyyy HH:mm")</td>
                                <td><span class="pam-status @(t.IsActive ? "pam-status-active" : "pam-status-inactive")">@(t.IsActive ? "Active" : "Revoked")</span></td>
                                <td style="white-space:nowrap">
                                    @if (t.IsActive && t.TokenType == "Hotp")
                                    {
                                        <button class="pam-btn pam-btn-secondary pam-btn-sm"
                                                style="margin-right:4px"
                                                @onclick="@(() => OpenAdminResyncModal(t))">
                                            Resync
                                        </button>
                                    }
                                    @if (t.IsActive)
                                    {
                                        <button class="pam-btn pam-btn-danger pam-btn-sm"
                                                @onclick="@(() => RevokeTokenAsync(t.Id))">
                                            Revoke
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="pam-card" style="margin-top:16px">
        <div class="pam-card-header" style="display:flex;justify-content:space-between;align-items:center">
            <strong>Drift Report — Last 7 Days</strong>
            <button class="pam-btn pam-btn-secondary pam-btn-sm" @onclick="LoadDriftReportAsync">Refresh</button>
        </div>
        <div class="pam-card-body p-0">
            @if (_hwtDriftLoading)
            {
                <div class="pam-loading-text p-4">Loading...</div>
            }
            else if (_hwtDriftReport == null || _hwtDriftReport.Count == 0)
            {
                <div class="pam-empty p-4">No resync events in the last 7 days.</div>
            }
            else
            {
                <table class="pam-table pam-table-hover">
                    <thead>
                        <tr>
                            <th>Serial</th><th>User</th><th>Label</th><th>Counter</th>
                            <th>Resync Count</th><th>Last Event</th><th>Last Resync</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _hwtDriftReport)
                        {
                            <tr>
                                <td>@r.SerialNumber</td>
                                <td>@r.Username</td>
                                <td>@(r.Label ?? "—")</td>
                                <td>@r.CounterValue</td>
                                <td>@r.ResyncCount</td>
                                <td>
                                    @if (r.LastEvent == "HARDWARE_TOKEN_RESYNC_SUCCESS")
                                    { <span class="pam-badge pam-badge-green">Success</span> }
                                    else
                                    { <span class="pam-badge pam-badge-red">Failed</span> }
                                </td>
                                <td style="font-size:.82em">
                                    @(r.LastResyncAtUtc.HasValue
                                        ? r.LastResyncAtUtc.Value.ToLocalTime().ToString("MM/dd HH:mm")
                                        : "—")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@if (_tab == "oidc")
{
    @if (_oidcError != null) { <div class="pam-alert pam-alert-danger">@_oidcError</div> }
    @if (_oidcMsg != null)   { <div class="pam-alert pam-alert-success">@_oidcMsg</div> }

    <div class="pam-card" style="margin-bottom:16px">
        <div class="pam-card-header" style="display:flex;justify-content:space-between;align-items:center">
            <strong>OIDC Identity Providers</strong>
            <button class="pam-btn pam-btn-primary pam-btn-sm"
                    @onclick="@(() => { _oidcShowNew = true; _oidcEditId = null; ResetOidcForm(); })">
                + New Provider
            </button>
        </div>
        <div class="pam-card-body p-0">
            @if (_oidcLoading)
            {
                <div class="pam-loading-text p-4">Loading...</div>
            }
            else if (_oidcProviders == null || _oidcProviders.Count == 0)
            {
                <div class="pam-empty p-4">No OIDC providers configured. Add one to enable SSO with Azure AD, Okta, or Auth0.</div>
            }
            else
            {
                <table class="pam-table pam-table-hover">
                    <thead>
                        <tr><th>Name</th><th>Display Name</th><th>Authority</th><th>Auto-Provision</th><th>Status</th><th></th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in _oidcProviders)
                        {
                            <tr>
                                <td><code style="font-size:.8em">@p.Name</code></td>
                                <td>@p.DisplayName</td>
                                <td style="font-size:.8em;word-break:break-all">@p.Authority</td>
                                <td>@(p.AutoProvisionUsers ? "Yes" : "No")</td>
                                <td><span class="pam-status @(p.IsEnabled ? "pam-status-active" : "pam-status-inactive")">@(p.IsEnabled ? "Enabled" : "Disabled")</span></td>
                                <td style="white-space:nowrap">
                                    <button class="pam-btn pam-btn-secondary pam-btn-sm"
                                            @onclick="@(() => TestOidcAsync(p.Id))">Test</button>
                                    <button class="pam-btn pam-btn-secondary pam-btn-sm"
                                            @onclick="@(() => StartEditOidc(p))">Edit</button>
                                    <button class="pam-btn pam-btn-danger pam-btn-sm"
                                            @onclick="@(() => { _oidcDeleteId = p.Id; _oidcDeleteName = p.DisplayName; })">Delete</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    @if (_oidcTestResult != null)
    {
        <div class="pam-alert @(_oidcTestResult.Reachable ? "pam-alert-success" : "pam-alert-danger")" style="margin-bottom:12px">
            @if (_oidcTestResult.Reachable)
            {
                <strong>Discovery reachable.</strong> Issuer: @_oidcTestResult.Issuer<br />
                Auth endpoint: @_oidcTestResult.AuthorizationEndpoint<br />
                Token endpoint: @_oidcTestResult.TokenEndpoint
            }
            else
            {
                <strong>Discovery failed:</strong> @_oidcTestResult.Error
            }
        </div>
    }

    @if (_oidcShowNew || _oidcEditId.HasValue)
    {
        <div class="pam-card">
            <div class="pam-card-header"><strong>@(_oidcEditId.HasValue ? "Edit" : "New") OIDC Provider</strong></div>
            <div class="pam-card-body">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;max-width:700px">
                    <div>
                        <label class="pam-label">Name (slug, no spaces)</label>
                        <input class="pam-input" placeholder="azure-ad" @bind="_oidcName" disabled="@_oidcEditId.HasValue" />
                    </div>
                    <div>
                        <label class="pam-label">Display Name</label>
                        <input class="pam-input" placeholder="Sign in with Azure AD" @bind="_oidcDisplayName" />
                    </div>
                    <div style="grid-column:1/-1">
                        <label class="pam-label">Authority (Issuer URL)</label>
                        <input class="pam-input" placeholder="https://login.microsoftonline.com/{tenant}/v2.0" @bind="_oidcAuthority" />
                    </div>
                    <div>
                        <label class="pam-label">Client ID</label>
                        <input class="pam-input" @bind="_oidcClientId" />
                    </div>
                    <div>
                        <label class="pam-label">Client Secret @(_oidcEditId.HasValue ? "(leave blank to keep current)" : "")</label>
                        <input class="pam-input" type="password" @bind="_oidcClientSecret" />
                    </div>
                    <div>
                        <label class="pam-label">Scopes</label>
                        <input class="pam-input" placeholder="openid profile email" @bind="_oidcScopes" />
                    </div>
                    <div>
                        <label class="pam-label">Group Claim Type (optional)</label>
                        <input class="pam-input" placeholder="groups" @bind="_oidcGroupClaimType" />
                    </div>
                    <div>
                        <label class="pam-label">Default Role for New Users</label>
                        <select class="pam-select" @bind="_oidcDefaultRole">
                            <option value="Viewer">Viewer</option>
                            <option value="StandardUser">Standard User</option>
                            <option value="SessionAdmin">Session Admin</option>
                            <option value="VaultAdmin">Vault Admin</option>
                            <option value="GlobalAdmin">Global Admin</option>
                        </select>
                    </div>
                    <div style="display:flex;align-items:center;gap:.5rem;margin-top:8px">
                        <input type="checkbox" id="oidcAutoProvision" @bind="_oidcAutoProvision" />
                        <label for="oidcAutoProvision" class="pam-label" style="margin-bottom:0">Auto-Provision New Users</label>
                    </div>
                    <div style="display:flex;align-items:center;gap:.5rem;margin-top:8px">
                        <input type="checkbox" id="oidcEnabled" @bind="_oidcIsEnabled" />
                        <label for="oidcEnabled" class="pam-label" style="margin-bottom:0">Enabled</label>
                    </div>
                </div>
                <div style="display:flex;gap:8px;margin-top:12px">
                    <button class="pam-btn pam-btn-primary" @onclick="SaveOidcAsync" disabled="@_oidcSaving">
                        @(_oidcSaving ? "Saving..." : (_oidcEditId.HasValue ? "Update Provider" : "Create Provider"))
                    </button>
                    <button class="pam-btn pam-btn-secondary" @onclick="@(() => { _oidcShowNew = false; _oidcEditId = null; })">Cancel</button>
                </div>
            </div>
        </div>
    }

    @if (_oidcDeleteId.HasValue)
    {
        <div class="pam-modal-backdrop">
            <div class="pam-modal">
                <div class="pam-modal-header"><strong>Delete OIDC Provider</strong></div>
                <div class="pam-modal-body">
                    <p>Delete provider <strong>@_oidcDeleteName</strong>? Users provisioned via this provider will keep their accounts but cannot SSO until another provider is configured.</p>
                </div>
                <div class="pam-modal-footer">
                    <button class="pam-btn pam-btn-danger" @onclick="ConfirmDeleteOidcAsync">Delete</button>
                    <button class="pam-btn pam-btn-secondary" @onclick="@(() => _oidcDeleteId = null)">Cancel</button>
                </div>
            </div>
        </div>
    }
}

@* ===== EXTERNAL VAULTS TAB (#284) ===== *@
@if (_tab == "extvault")
{
    @if (_evError != null) { <div class="pam-alert pam-alert-danger">@_evError</div> }
    @if (_evMsg != null)   { <div class="pam-alert pam-alert-success">@_evMsg</div> }

    <div class="pam-card" style="margin-bottom:16px">
        <div class="pam-card-header" style="display:flex;justify-content:space-between;align-items:center">
            <strong>External Vault Connections</strong>
            <button class="pam-btn pam-btn-primary pam-btn-sm"
                    @onclick="@(() => { _evShowNew = true; _evEditId = null; ResetEvForm(); })">
                + New Connection
            </button>
        </div>
        <div class="pam-card-body p-0">
            @if (_evLoading)
            {
                <div class="pam-loading-text p-4">Loading…</div>
            }
            else if (_evVaults == null || _evVaults.Count == 0)
            {
                <div class="pam-empty p-4">No external vault connections. Connect HashiCorp Vault or Azure Key Vault to federate credentials.</div>
            }
            else
            {
                <table class="pam-table pam-table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Endpoint</th>
                            <th>Auth</th>
                            <th>Sync</th>
                            <th>Mappings</th>
                            <th>Last Sync</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var v in _evVaults)
                        {
                            <tr>
                                <td>@v.Name</td>
                                <td><span class="pam-badge @(v.VaultType == "HashiCorpVault" ? "pam-badge-info" : "pam-badge-primary")">@v.VaultType</span></td>
                                <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@v.Endpoint</td>
                                <td>@v.AuthMethod</td>
                                <td>@(v.SyncEnabled ? "Every " + v.SyncIntervalMinutes + "m" : "Off")</td>
                                <td>@v.MappingCount</td>
                                <td>@(v.LastSyncAtUtc.HasValue ? v.LastSyncAtUtc.Value.ToString("MM/dd HH:mm") : "—")</td>
                                <td>
                                    @if (!v.IsEnabled)
                                    { <span class="pam-badge pam-badge-secondary">Disabled</span> }
                                    else if (!string.IsNullOrEmpty(v.LastSyncError))
                                    { <span class="pam-badge pam-badge-danger">Error</span> }
                                    else
                                    { <span class="pam-badge pam-badge-success">OK</span> }
                                </td>
                                <td>
                                    <button class="pam-btn pam-btn-secondary pam-btn-xs"
                                            @onclick="@(() => TestEvAsync(v.Id))">Test</button>
                                    <button class="pam-btn pam-btn-secondary pam-btn-xs"
                                            @onclick="@(() => SyncEvAsync(v.Id))">Sync</button>
                                    <button class="pam-btn pam-btn-secondary pam-btn-xs"
                                            @onclick="@(() => OpenBrowseEvAsync(v.Id, v.Name))">Browse</button>
                                    <button class="pam-btn pam-btn-danger pam-btn-xs"
                                            @onclick="@(() => { _evDeleteId = v.Id; _evDeleteName = v.Name; })">Delete</button>
                                </td>
                            </tr>
                            @if (_evTestResults.TryGetValue(v.Id, out var testRes))
                            {
                                <tr>
                                    <td colspan="9" style="padding:4px 12px;background:#f8f9fa">
                                        <span class="pam-badge @(testRes.Success ? "pam-badge-success" : "pam-badge-danger")">
                                            @(testRes.Success ? "Connected" : "Failed") — @testRes.LatencyMs ms
                                        </span>
                                        @if (!string.IsNullOrEmpty(testRes.Error))
                                        { <span style="margin-left:8px;color:#dc3545">@testRes.Error</span> }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    @* New/Edit Connection Form *@
    @if (_evShowNew || _evEditId.HasValue)
    {
        <div class="pam-card" style="margin-bottom:16px">
            <div class="pam-card-header">
                <strong>@(_evEditId.HasValue ? "Edit" : "New") External Vault Connection</strong>
            </div>
            <div class="pam-card-body">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
                    <div class="pam-form-group">
                        <label class="pam-label">Name *</label>
                        <input class="pam-input" placeholder="hcv-prod" @bind="_evName" />
                    </div>
                    <div class="pam-form-group">
                        <label class="pam-label">Vault Type *</label>
                        <select class="pam-select" @bind="_evVaultType">
                            <option value="HashiCorpVault">HashiCorp Vault</option>
                            <option value="AzureKeyVault">Azure Key Vault</option>
                        </select>
                    </div>
                    <div class="pam-form-group" style="grid-column:span 2">
                        <label class="pam-label">Endpoint URL *</label>
                        <input class="pam-input" placeholder="@(_evVaultType == "AzureKeyVault" ? "https://myvault.vault.azure.net" : "https://vault.corp.com:8200")" @bind="_evEndpoint" />
                    </div>
                    <div class="pam-form-group">
                        <label class="pam-label">Auth Method *</label>
                        <select class="pam-select" @bind="_evAuthMethod">
                            @if (_evVaultType == "HashiCorpVault")
                            {
                                <option value="Token">Token</option>
                                <option value="AppRole">AppRole</option>
                            }
                            else
                            {
                                <option value="ServicePrincipal">Service Principal</option>
                                <option value="ManagedIdentity">Managed Identity</option>
                            }
                        </select>
                    </div>
                    <div class="pam-form-group">
                        <label class="pam-label">
                            @if (_evVaultType == "HashiCorpVault" && _evAuthMethod == "Token") { @("Vault Token") }
                            else if (_evVaultType == "HashiCorpVault" && _evAuthMethod == "AppRole") { @("role_id:secret_id") }
                            else if (_evAuthMethod == "ServicePrincipal") { @("Client Secret") }
                            else { @("Auth Secret (optional)") }
                            @if (_evEditId.HasValue) { <span class="pam-text-muted"> (blank = keep current)</span> }
                        </label>
                        <input class="pam-input" type="password" @bind="_evAuthSecret" />
                    </div>
                    @if (_evVaultType == "HashiCorpVault")
                    {
                        <div class="pam-form-group">
                            <label class="pam-label">Namespace (optional)</label>
                            <input class="pam-input" placeholder="admin/team1" @bind="_evNamespace" />
                        </div>
                        <div class="pam-form-group">
                            <label class="pam-label">Mount Path</label>
                            <input class="pam-input" placeholder="secret" @bind="_evMountPath" />
                        </div>
                    }
                    @if (_evVaultType == "AzureKeyVault")
                    {
                        <div class="pam-form-group">
                            <label class="pam-label">Key Vault Name</label>
                            <input class="pam-input" placeholder="myvault" @bind="_evKeyVaultName" />
                        </div>
                        <div class="pam-form-group">
                            <label class="pam-label">Tenant ID</label>
                            <input class="pam-input" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" @bind="_evTenantId" />
                        </div>
                        <div class="pam-form-group">
                            <label class="pam-label">Client ID</label>
                            <input class="pam-input" @bind="_evClientId" />
                        </div>
                    }
                    <div class="pam-form-group" style="display:flex;align-items:center;gap:12px;padding-top:20px">
                        <label><input type="checkbox" @bind="_evSyncEnabled" /> Enable Sync</label>
                        @if (_evSyncEnabled)
                        {
                            <label>Interval (min): <input class="pam-input" type="number" style="width:80px;display:inline" @bind="_evSyncInterval" /></label>
                        }
                    </div>
                </div>
                <div style="margin-top:12px">
                    <button class="pam-btn pam-btn-primary" @onclick="SaveEvAsync" disabled="@_evSaving">
                        @(_evSaving ? "Saving..." : (_evEditId.HasValue ? "Update" : "Create Connection"))
                    </button>
                    <button class="pam-btn pam-btn-secondary" style="margin-left:8px"
                            @onclick="@(() => { _evShowNew = false; _evEditId = null; })">Cancel</button>
                </div>
            </div>
        </div>
    }

    @* Secret Browser Modal *@
    @if (_evBrowseConnectionId.HasValue)
    {
        <div class="pam-modal-overlay" @onclick="@(() => _evBrowseConnectionId = null)">
            <div class="pam-modal" style="max-width:700px" @onclick:stopPropagation="true">
                <div class="pam-modal-header">Browse Secrets — @_evBrowseConnectionName</div>
                <div class="pam-modal-body">
                    @if (_evBrowseLoading)
                    {
                        <div class="pam-loading-text">Loading secrets…</div>
                    }
                    else if (_evBrowseSecrets == null || _evBrowseSecrets.Count == 0)
                    {
                        <div class="pam-empty">No secrets found at this path.</div>
                    }
                    else
                    {
                        <p class="pam-text-muted" style="margin-bottom:8px">Click a secret to add as a mapping.</p>
                        <ul style="list-style:none;padding:0;max-height:300px;overflow-y:auto">
                            @foreach (var s in _evBrowseSecrets)
                            {
                                <li style="padding:6px;border-bottom:1px solid #eee;display:flex;justify-content:space-between;align-items:center">
                                    <span style="font-family:monospace">@s</span>
                                    <button class="pam-btn pam-btn-secondary pam-btn-xs"
                                            @onclick="@(() => AddMappingAsync(_evBrowseConnectionId!.Value, s))">
                                        Add Mapping
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </div>
                <div class="pam-modal-footer">
                    <button class="pam-btn pam-btn-secondary" @onclick="@(() => _evBrowseConnectionId = null)">Close</button>
                </div>
            </div>
        </div>
    }

    @* Delete confirm *@
    @if (_evDeleteId.HasValue)
    {
        <div class="pam-modal-overlay" @onclick="@(() => _evDeleteId = null)">
            <div class="pam-modal" @onclick:stopPropagation="true">
                <div class="pam-modal-header">Delete Connection</div>
                <div class="pam-modal-body">
                    Delete <strong>@_evDeleteName</strong>? All mappings will be removed.
                </div>
                <div class="pam-modal-footer">
                    <button class="pam-btn pam-btn-danger" @onclick="ConfirmDeleteEvAsync">Delete</button>
                    <button class="pam-btn pam-btn-secondary" @onclick="@(() => _evDeleteId = null)">Cancel</button>
                </div>
            </div>
        </div>
    }
}

@* ===== ADMIN RESYNC MODAL (#277) ===== *@
@if (_hwtAdminResyncTarget != null)
{
    <div class="pam-modal-overlay" @onclick="@(() => _hwtAdminResyncTarget = null)">
        <div class="pam-modal" @onclick:stopPropagation="true">
            <div class="pam-modal-header">Admin Resync: @_hwtAdminResyncTarget.SerialNumber</div>
            <div class="pam-modal-body">
                @if (_hwtError != null) { <div class="pam-alert pam-alert-danger">@_hwtError</div> }
                <div class="pam-form-group">
                    <label class="pam-label">New Counter Value</label>
                    <input class="pam-input" type="number" min="0" @bind="_hwtNewCounter" />
                    <span class="pam-text-muted" style="font-size:.8em">
                        Current counter: @_hwtAdminResyncTarget.CounterValue
                    </span>
                </div>
            </div>
            <div class="pam-modal-footer">
                <button class="pam-btn pam-btn-primary" @onclick="DoAdminResyncAsync" disabled="@_hwtAdminResyncing">
                    @(_hwtAdminResyncing ? "Setting..." : "Set Counter")
                </button>
                <button class="pam-btn pam-btn-secondary" @onclick="@(() => _hwtAdminResyncTarget = null)">Cancel</button>
            </div>
        </div>
    </div>
