@page "/"
@inject PamApiService Api
@inject NavigationManager Nav

<PageTitle>Dashboard — OrkunPAM</PageTitle>

<div class="pam-page-header">
    <h2 class="pam-page-title">Dashboard</h2>
    <span class="pam-page-sub">@DateTime.Now.ToString("dddd, MMMM d yyyy")</span>
</div>

<!-- Stat Cards -->
<div class="pam-stat-row">
    <div class="pam-stat-card pam-stat-blue">
        <div class="pam-stat-icon">▶</div>
        <div class="pam-stat-body">
            <div class="pam-stat-value">@(_activeSessions?.ToString() ?? "—")</div>
            <div class="pam-stat-label">Active Sessions</div>
        </div>
    </div>
    <div class="pam-stat-card pam-stat-green">
        <div class="pam-stat-icon">👤</div>
        <div class="pam-stat-body">
            <div class="pam-stat-value">@(_totalUsers?.ToString() ?? "—")</div>
            <div class="pam-stat-label">Total Users</div>
        </div>
    </div>
    <div class="pam-stat-card pam-stat-purple">
        <div class="pam-stat-icon">🖵</div>
        <div class="pam-stat-body">
            <div class="pam-stat-value">@(_totalDevices?.ToString() ?? "—")</div>
            <div class="pam-stat-label">Managed Devices</div>
        </div>
    </div>
    <div class="pam-stat-card pam-stat-orange">
        <div class="pam-stat-icon">🔑</div>
        <div class="pam-stat-body">
            <div class="pam-stat-value">@(_totalCredentials?.ToString() ?? "—")</div>
            <div class="pam-stat-label">Vault Credentials</div>
        </div>
    </div>
    <div class="pam-stat-card pam-stat-red">
        <div class="pam-stat-icon">⏳</div>
        <div class="pam-stat-body">
            <div class="pam-stat-value">@(_pendingApprovals?.ToString() ?? "—")</div>
            <div class="pam-stat-label">Pending Approvals</div>
        </div>
    </div>
</div>

<div class="pam-row">
    <!-- Recent Sessions -->
    <div class="pam-card pam-card-lg">
        <div class="pam-card-header">
            <h3 class="pam-card-title">Recent Sessions</h3>
            <a href="/sessions" class="pam-link">View all →</a>
        </div>
        <div class="pam-card-body">
            @if (_sessions == null)
            {
                <div class="pam-loading-text">Loading...</div>
            }
            else if (_sessions.Count == 0)
            {
                <div class="pam-empty">No sessions yet.</div>
            }
            else
            {
                <table class="pam-table">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Target</th>
                            <th>Status</th>
                            <th>Started</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _sessions)
                        {
                            <tr>
                                <td><span class="pam-badge">@s.SessionType</span></td>
                                <td>@(s.TargetIpAddress ?? "—")</td>
                                <td>
                                    <span class="pam-status @StatusClass(s.Status)">@s.Status</span>
                                </td>
                                <td>@s.StartedAtUtc.ToLocalTime().ToString("MM/dd HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="pam-card pam-card-sm">
        <div class="pam-card-header">
            <h3 class="pam-card-title">Quick Actions</h3>
        </div>
        <div class="pam-card-body">
            <a href="/connect" class="pam-action-btn pam-action-ssh">
                <span>⌨</span> Start SSH Session
            </a>
            <a href="/devices" class="pam-action-btn pam-action-device">
                <span>🖵</span> Add Device
            </a>
            <a href="/users" class="pam-action-btn pam-action-user">
                <span>👤</span> Manage Users
            </a>
            <a href="/vault" class="pam-action-btn pam-action-vault">
                <span>🔑</span> Open Vault
            </a>
        </div>
        <div class="pam-card-header mt-3">
            <h3 class="pam-card-title">System Status</h3>
        </div>
        <div class="pam-card-body">
            <div class="pam-status-row">
                <span>SSH Proxy</span>
                <span class="pam-status pam-status-active">Online</span>
            </div>
            <div class="pam-status-row">
                <span>Vault Engine</span>
                <span class="pam-status pam-status-active">Online</span>
            </div>
            <div class="pam-status-row">
                <span>Audit Log</span>
                <span class="pam-status pam-status-active">Online</span>
            </div>
        </div>
    </div>
</div>

@code {
    private int? _activeSessions;
    private int? _totalUsers;
    private int? _totalDevices;
    private int? _totalCredentials;
    private int? _pendingApprovals;
    private List<SessionDto>? _sessions;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        var pendingTask = Task.Run(async () =>
        {
            _pendingApprovals = await Api.GetPendingApprovalCountAsync();
        });

        var tasks = new[]
        {
            LoadStatAsync("/api/v1/sessions?status=Active",  v => _activeSessions  = v),
            LoadStatAsync("/api/v1/users",                   v => _totalUsers      = v),
            LoadStatAsync("/api/v1/devices",                 v => _totalDevices    = v),
            LoadStatAsync("/api/v1/vault/credentials",       v => _totalCredentials = v),
        };
        await Task.WhenAll(tasks);
        await pendingTask;

        var sessions = await Api.GetSessionsAsync(pageSize: 5);
        _sessions = sessions?.Data ?? [];

        StateHasChanged();
    }

    private async Task LoadStatAsync(string path, Action<int> setter)
    {
        var count = await Api.GetTotalCountAsync(path);
        setter(count);
    }

    private static string StatusClass(string status) => status switch
    {
        "Active"    => "pam-status-active",
        "Completed" => "pam-status-done",
        "Failed"    => "pam-status-error",
        _           => "pam-status-done"
    };
}
