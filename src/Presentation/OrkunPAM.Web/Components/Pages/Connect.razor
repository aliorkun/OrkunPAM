@page "/connect"
@inject PamApiService Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Connect — OrkunPAM</PageTitle>

<div class="pam-page-header">
    <h2 class="pam-page-title">Connect to Device</h2>
</div>

<div class="pam-card" style="max-width:560px">
    <div class="pam-card-body">
        <div class="pam-form-group">
            <label class="pam-label">Device</label>
            <select class="pam-input" @bind="_deviceId" @bind:after="OnDeviceChanged">
                <option value="">— Select a device —</option>
                @foreach (var d in _devices)
                {
                    <option value="@d.Id">@d.Hostname (@(d.IpAddress ?? "")) — @d.Protocol</option>
                }
            </select>
        </div>

        @if (_creds.Count > 0)
        {
            <div class="pam-form-group">
                <label class="pam-label">Credential</label>
                <select class="pam-input" @bind="_credId">
                    <option value="">— Select credential —</option>
                    @foreach (var c in _creds)
                    {
                        <option value="@c.Id">@(c.Username ?? "unknown") (@c.Type)</option>
                    }
                </select>
            </div>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="pam-alert pam-alert-danger" style="margin-bottom:8px">@_error</div>
        }
        @if (!string.IsNullOrEmpty(_successMsg))
        {
            <div class="pam-alert pam-alert-success" style="margin-bottom:8px">@_successMsg</div>
        }

        @if (IsProtocol("Ssh"))
        {
            <button class="pam-btn pam-btn-primary"
                    disabled="@(string.IsNullOrEmpty(_deviceId) || string.IsNullOrEmpty(_credId))"
                    @onclick="@(() => LaunchSshTerminal())">
                &#9000; Open SSH Terminal
            </button>
        }

        @if (IsProtocol("Rdp"))
        {
            <button class="pam-btn pam-btn-primary"
                    disabled="@(string.IsNullOrEmpty(_deviceId) || string.IsNullOrEmpty(_credId))"
                    @onclick="@(() => LaunchRdpWebTerminal())">
                &#128444; Open RDP in Browser
            </button>
            <button class="pam-btn pam-btn-secondary"
                    style="margin-top:6px"
                    disabled="@(string.IsNullOrEmpty(_deviceId) || string.IsNullOrEmpty(_credId) || _launching)"
                    @onclick="@(() => LaunchRdpSessionAsync())">
                @(_launching ? "Preparing…" : "&#128187; Download .rdp File")
            </button>
            <p style="margin-top:8px;font-size:0.85em;color:#666;">
                <strong>Browser RDP</strong> opens a native session in this tab (no client install).<br />
                <strong>.rdp file</strong> requires Windows Remote Desktop client.
            </p>
        }

        @if (!IsProtocol("Ssh") && !IsProtocol("Rdp") && _selectedDevice != null)
        {
            <div class="pam-alert pam-alert-info" style="margin-top:8px">
                Protocol <strong>@_selectedDevice.Protocol</strong> session launch coming soon.
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? DeviceId { get; set; }

    private List<DeviceDto>     _devices       = [];
    private List<CredentialDto> _creds         = [];
    private DeviceDto?          _selectedDevice;
    private string              _deviceId      = "";
    private string              _credId        = "";
    private bool                _launching;
    private string?             _error;
    private string?             _successMsg;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var result = await Api.GetDevicesAsync(pageSize: 200);
        _devices = result?.Data ?? [];

        if (!string.IsNullOrEmpty(DeviceId))
        {
            _deviceId = DeviceId;
            _selectedDevice = _devices.FirstOrDefault(d => d.Id == _deviceId);
            await LoadCredsAsync();
        }
        StateHasChanged();
    }

    private async Task OnDeviceChanged()
    {
        _credId         = "";
        _creds          = [];
        _error          = null;
        _successMsg     = null;
        _selectedDevice = _devices.FirstOrDefault(d => d.Id == _deviceId);
        if (!string.IsNullOrEmpty(_deviceId))
            await LoadCredsAsync();
    }

    private async Task LoadCredsAsync()
    {
        var result = await Api.GetCredentialsAsync(deviceId: _deviceId, pageSize: 50);
        _creds = result?.Data ?? [];
        StateHasChanged();
    }

    private bool IsProtocol(string protocol) =>
        _selectedDevice?.Protocol?.Equals(protocol, StringComparison.OrdinalIgnoreCase) == true;

    private void LaunchSshTerminal()
    {
        if (!string.IsNullOrEmpty(_deviceId) && !string.IsNullOrEmpty(_credId))
            Nav.NavigateTo("/terminal/" + _deviceId + "/" + _credId);
    }

    private void LaunchRdpWebTerminal()
    {
        if (!string.IsNullOrEmpty(_deviceId) && !string.IsNullOrEmpty(_credId))
            Nav.NavigateTo("/rdp-terminal/" + _deviceId + "/" + _credId);
    }

    private async Task LaunchRdpSessionAsync()
    {
        if (string.IsNullOrEmpty(_deviceId) || string.IsNullOrEmpty(_credId)) return;
        _launching  = true;
        _error      = null;
        _successMsg = null;
        StateHasChanged();

        try
        {
            var result = await Api.LaunchRdpSessionAsync(_deviceId, _credId);
            if (result == null)
            {
                _error = "Failed to create RDP session. Check that the API is reachable.";
                return;
            }

            await JS.InvokeVoidAsync("downloadRdpFile",
                result.RdpFile.Filename, result.RdpFile.ContentBase64);

            _successMsg = "RDP session created. Open the downloaded .rdp file with Windows Remote Desktop.";
        }
        catch (Exception ex)
        {
            _error = "Error: " + ex.Message;
        }
        finally
        {
            _launching = false;
            StateHasChanged();
        }
    }
}
