@page "/forgot-password"
@page "/reset-password"
@inject PamApiService Api
@inject NavigationManager Nav
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>Password Reset — OrkunPAM</PageTitle>

<div class="pam-login-page">
    <div class="pam-login-card">
        <div class="pam-login-logo">🔑</div>
        <h1 class="pam-login-title">OrkunPAM</h1>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="pam-alert pam-alert-danger">@_error</div>
        }
        @if (!string.IsNullOrEmpty(_success))
        {
            <div class="pam-alert pam-alert-success">@_success</div>
        }

        @if (_mode == "forgot")
        {
            <p class="pam-login-sub">Enter your username and email to receive a password reset link.</p>

            @if (!_submitted)
            {
                <div class="pam-form-group">
                    <label class="pam-label">Username</label>
                    <input class="pam-input" type="text" placeholder="Your username" @bind="_username" disabled="@_loading" />
                </div>

                <div class="pam-form-group">
                    <label class="pam-label">Email Address</label>
                    <input class="pam-input" type="email" placeholder="your.email@company.com" @bind="_email" disabled="@_loading" />
                </div>

                <button class="pam-btn pam-btn-primary w-100" @onclick="HandleForgotAsync" disabled="@_loading">
                    @if (_loading) { <span class="pam-spinner-sm"></span> } Send Reset Link
                </button>
            }
            else
            {
                <p style="color:#8b949e;text-align:center;padding:1rem 0">
                    If an account with that username and email exists, a password reset link has been sent.
                    Check your email inbox.
                </p>
            }

            <div style="text-align:center;margin-top:1rem">
                <a href="/login" style="color:#58a6ff;font-size:.9rem;text-decoration:none">Back to Sign In</a>
            </div>
        }
        else if (_mode == "reset")
        {
            <p class="pam-login-sub">Set your new password.</p>

            @if (!_resetDone)
            {
                <div class="pam-form-group">
                    <label class="pam-label">New Password</label>
                    <input class="pam-input" type="password" placeholder="New password" @bind="_newPassword" disabled="@_loading" />
                </div>

                <div class="pam-form-group">
                    <label class="pam-label">Confirm Password</label>
                    <input class="pam-input" type="password" placeholder="Confirm password" @bind="_confirmPassword" disabled="@_loading" />
                </div>

                <button class="pam-btn pam-btn-primary w-100" @onclick="HandleResetAsync" disabled="@_loading">
                    @if (_loading) { <span class="pam-spinner-sm"></span> } Reset Password
                </button>
            }
            else
            {
                <p style="color:#3fb950;text-align:center;padding:1rem 0">
                    Your password has been reset successfully. You can now sign in.
                </p>
                <button class="pam-btn pam-btn-primary w-100" @onclick="@(() => Nav.NavigateTo("/login"))">
                    Go to Sign In
                </button>
            }
        }

        <p class="pam-login-footer">
            &copy; @DateTime.Now.Year OrkunPAM — Enterprise PAM
        </p>
    </div>
</div>

@code {
    private string _mode = "forgot";
    private bool _loading;
    private bool _submitted;
    private bool _resetDone;
    private string? _error;
    private string? _success;

    // Forgot password
    private string _username = string.Empty;
    private string _email = string.Empty;

    // Reset password
    private string? _resetToken;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (uri.AbsolutePath.Contains("reset-password", StringComparison.OrdinalIgnoreCase))
        {
            if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("token", out var tokenVal))
            {
                _resetToken = tokenVal.ToString();
                _mode = "reset";
            }
        }
    }

    private async Task HandleForgotAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_email))
        { _error = "Username and email are required."; return; }

        _loading = true;
        StateHasChanged();

        await Api.ForgotPasswordAsync(_username.Trim(), _email.Trim());

        _loading = false;
        _submitted = true;
        StateHasChanged();
    }

    private async Task HandleResetAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_newPassword))
        { _error = "Password is required."; return; }
        if (_newPassword != _confirmPassword)
        { _error = "Passwords do not match."; return; }
        if (string.IsNullOrEmpty(_resetToken))
        { _error = "Invalid reset link."; return; }

        _loading = true;
        StateHasChanged();

        var (success, message) = await Api.ResetPasswordAsync(_resetToken, _newPassword);
        _loading = false;

        if (success)
        {
            _resetDone = true;
            _success = message ?? "Password reset successfully.";
        }
        else
        {
            _error = message ?? "Failed to reset password. The link may have expired.";
        }
        StateHasChanged();
    }
}
