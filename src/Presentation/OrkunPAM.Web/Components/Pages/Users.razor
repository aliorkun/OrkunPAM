@page "/users"
@inject PamApiService Api
@inject NavigationManager Nav

<PageTitle>Users — OrkunPAM</PageTitle>

<div class="pam-page-header">
    <h2 class="pam-page-title">Users</h2>
    <div style="display:flex;gap:.5rem">
        <button class="pam-btn pam-btn-secondary" @onclick="OpenImportModal">&#8679; Bulk Import</button>
        <button class="pam-btn pam-btn-primary" @onclick="OpenAddModal">+ Add User</button>
    </div>
</div>

<!-- Filters -->
<div class="pam-filters">
    <input class="pam-input pam-search" type="search" placeholder="Search by name, username or email…"
           @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
    <select class="pam-input pam-select" @bind="_statusFilter" @bind:after="LoadAsync">
        <option value="">All Statuses</option>
        <option value="Active">Active</option>
        <option value="Locked">Locked</option>
        <option value="Disabled">Disabled</option>
    </select>
    <button class="pam-btn pam-btn-secondary" @onclick="LoadAsync">Search</button>
</div>

@if (_error != null)
{
    <div class="pam-alert pam-alert-danger">@_error</div>
}

<div class="pam-card">
    <div class="pam-card-body p-0">
        @if (_loading)
        {
            <div class="pam-loading-text p-4">Loading users…</div>
        }
        else if (_users == null || _users.Count == 0)
        {
            <div class="pam-empty p-4">No users found.</div>
        }
        else
        {
            <table class="pam-table pam-table-hover">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Display Name</th>
                        <th>Email</th>
                        <th>Source</th>
                        <th>Status</th>
                        <th>MFA</th>
                        <th>Last Login</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in _users)
                    {
                        <tr>
                            <td><strong>@u.Username</strong></td>
                            <td>@(u.DisplayName ?? "—")</td>
                            <td>@(u.Email ?? "—")</td>
                            <td><span class="pam-badge pam-badge-secondary">@u.AuthSource</span></td>
                            <td>
                                <span class="pam-status @(u.Status == "Active" ? "pam-status-active" : "pam-status-error")">
                                    @u.Status
                                </span>
                            </td>
                            <td>
                                @if (u.MfaEnabled)
                                {
                                    <span class="pam-status pam-status-active">✅ On</span>
                                    <button class="pam-btn-icon" title="Reset MFA"
                                            @onclick="@(() => ResetMfaAsync(u.Id, u.Username))">&#x1F504;</button>
                                }
                                else
                                {
                                    <span class="pam-status pam-status-done">Off</span>
                                    <button class="pam-btn-icon" title="Send MFA Setup Link"
                                            @onclick="@(() => SendMfaSetupAsync(u.Id))">&#x1F511;</button>
                                }
                            </td>
                            <td>@(u.LastLoginAtUtc?.ToLocalTime().ToString("MM/dd/yy HH:mm") ?? "Never")</td>
                            <td>
                                <div class="pam-actions">
                                    <button class="pam-btn-icon" title="Edit user"
                                            @onclick="() => OpenEditModal(u)">&#9998;</button>
                                    @if (u.Status == "Active")
                                    {
                                        <button class="pam-btn-icon" title="Lock user"
                                                @onclick="@(() => SetStatusAsync(u.Id, "Locked"))">&#x1F512;</button>
                                    }
                                    else
                                    {
                                        <button class="pam-btn-icon" title="Activate user"
                                                @onclick="@(() => SetStatusAsync(u.Id, "Active"))">&#10003;</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <!-- Pagination -->
            @if (_meta != null && _meta.TotalCount > _pageSize)
            {
                <div class="pam-pagination">
                    <button class="pam-btn pam-btn-secondary pam-btn-sm"
                            disabled="@(_page == 1)" @onclick="PrevPage">&#8592; Prev</button>
                    <span class="pam-page-info">
                        Page @_page of @TotalPages &#8212; @_meta.TotalCount users
                    </span>
                    <button class="pam-btn pam-btn-secondary pam-btn-sm"
                            disabled="@(_page >= TotalPages)" @onclick="NextPage">Next &#8594;</button>
                </div>
            }
        }
    </div>
</div>

<!-- Add User Modal -->
@if (_showAdd)
{
    <div class="pam-modal-overlay" @onclick="CloseModal">
        <div class="pam-modal" @onclick:stopPropagation="true">
            <div class="pam-modal-header">
                <h3 class="pam-modal-title">Add User</h3>
                <button class="pam-close-btn" @onclick="CloseModal">&#215;</button>
            </div>
            <div class="pam-modal-body">
                @if (_formError != null)
                {
                    <div class="pam-alert pam-alert-danger">@_formError</div>
                }
                <div class="pam-form-group">
                    <label class="pam-label">Username *</label>
                    <input class="pam-input w-100-input" @bind="_fUsername" placeholder="e.g. john.doe" />
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Display Name</label>
                    <input class="pam-input w-100-input" @bind="_fDisplayName" placeholder="e.g. John Doe" />
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Email</label>
                    <input class="pam-input w-100-input" type="email" @bind="_fEmail" placeholder="user@company.com" />
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Password *</label>
                    <input class="pam-input w-100-input" type="password" @bind="_fPassword" />
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Confirm Password *</label>
                    <input class="pam-input w-100-input" type="password" @bind="_fPasswordConfirm" />
                </div>
            </div>
            <div class="pam-modal-footer">
                <button class="pam-btn pam-btn-secondary" @onclick="CloseModal">Cancel</button>
                <button class="pam-btn pam-btn-primary" @onclick="SubmitAddUserAsync" disabled="@_formSaving">
                    @if (_formSaving) { <span class="pam-spinner-sm"></span> }
                    Create User
                </button>
            </div>
        </div>
    </div>
}

<!-- Edit User Modal -->
@if (_showEdit)
{
    <div class="pam-modal-overlay" @onclick="CloseEditModal">
        <div class="pam-modal" @onclick:stopPropagation="true">
            <div class="pam-modal-header">
                <h3 class="pam-modal-title">Edit User</h3>
                <button class="pam-close-btn" @onclick="CloseEditModal">&#215;</button>
            </div>
            <div class="pam-modal-body">
                @if (_editError != null)
                {
                    <div class="pam-alert pam-alert-danger">@_editError</div>
                }
                <div class="pam-form-group">
                    <label class="pam-label">Username</label>
                    <input class="pam-input w-100-input" value="@_eUsername" disabled />
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Display Name</label>
                    <input class="pam-input w-100-input" @bind="_eDisplayName" placeholder="e.g. John Doe" />
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Email</label>
                    <input class="pam-input w-100-input" type="email" @bind="_eEmail" placeholder="user@company.com" />
                </div>
            </div>
            <div class="pam-modal-footer">
                <button class="pam-btn pam-btn-secondary" @onclick="CloseEditModal">Cancel</button>
                <button class="pam-btn pam-btn-primary" @onclick="SubmitEditUserAsync" disabled="@_editSaving">
                    @if (_editSaving) { <span class="pam-spinner-sm"></span> }
                    Save Changes
                </button>
            </div>
        </div>
    </div>
}

<!-- MFA Setup Link Modal -->
@if (_mfaSetupToken != null)
{
    <div class="pam-modal-overlay" @onclick="CloseMfaModal">
        <div class="pam-modal" @onclick:stopPropagation="true">
            <div class="pam-modal-header">
                <h3 class="pam-modal-title">MFA Setup Link Generated</h3>
                <button class="pam-close-btn" @onclick="CloseMfaModal">&#215;</button>
            </div>
            <div class="pam-modal-body">
                <p class="pam-text-muted" style="font-size:.85rem">Share this link with the user. It is valid for 24 hours and can only be used once.</p>
                <div class="pam-form-group">
                    <label class="pam-label">Enrollment Link</label>
                    <code style="display:block;background:#0d1117;padding:.5rem;border-radius:4px;word-break:break-all;font-size:.8rem;color:#79c0ff">
                        @(Nav.BaseUri.TrimEnd('/') + "/mfa-setup?token=" + _mfaSetupToken)
                    </code>
                </div>
                <p class="pam-text-muted" style="font-size:.8rem">Expires: @(_mfaSetupExpiry?.ToString("yyyy-MM-dd HH:mm") ?? "24h from now") UTC</p>
            </div>
            <div class="pam-modal-footer">
                <button class="pam-btn pam-btn-primary" @onclick="CloseMfaModal">Close</button>
            </div>
        </div>
    </div>
}

<!-- Bulk Import Modal -->
@if (_showImport)
{
    <div class="pam-modal-overlay" @onclick="CloseImportModal">
        <div class="pam-modal" @onclick:stopPropagation="true" style="max-width:520px">
            <div class="pam-modal-header">
                <h3 class="pam-modal-title">Bulk User Import (CSV)</h3>
                <button class="pam-close-btn" @onclick="CloseImportModal">&#215;</button>
            </div>
            <div class="pam-modal-body">
                <p class="pam-text-muted" style="font-size:.85rem">
                    Upload a CSV file. Max 5 MB. Imported users will be required to change their password on first login.
                </p>
                <div class="pam-form-group">
                    <a href="/api/v1/users/import/template" download="users-import-template.csv"
                       class="pam-btn pam-btn-secondary pam-btn-sm" style="font-size:.8rem">
                        &#8595; Download Template
                    </a>
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">CSV File</label>
                    <InputFile OnChange="OnImportFileSelected" accept=".csv" class="pam-input" />
                </div>
                @if (_importError != null)
                {
                    <div class="pam-alert pam-alert-error">@_importError</div>
                }
                @if (_importResult != null)
                {
                    <div class="pam-alert @(_importResult.Failed == 0 ? "pam-alert-success" : "pam-alert-warning")" style="margin-top:.5rem">
                        Imported @_importResult.Imported users. @(_importResult.Failed > 0 ? $"{_importResult.Failed} failed." : "")
                    </div>
                    @if (_importResult.Errors.Count > 0)
                    {
                        <table class="pam-table" style="font-size:.8rem;margin-top:.5rem">
                            <thead><tr><th>Row</th><th>Username</th><th>Reason</th></tr></thead>
                            <tbody>
                                @foreach (var e in _importResult.Errors)
                                {
                                    <tr><td>@e.Row</td><td>@e.Username</td><td>@e.Reason</td></tr>
                                }
                            </tbody>
                        </table>
                    }
                }
            </div>
            <div class="pam-modal-footer">
                <button class="pam-btn pam-btn-secondary" @onclick="CloseImportModal">Close</button>
                <button class="pam-btn pam-btn-primary" @onclick="SubmitImportAsync"
                        disabled="@(_importFile == null || _importSaving)">
                    @(_importSaving ? "Importing…" : "Import")
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<UserDto>? _users;
    private PageMeta?      _meta;
    private bool           _loading      = true;
    private string?        _error;
    private string         _search       = "";
    private string         _statusFilter = "";
    private int            _page         = 1;
    private const int      _pageSize     = 20;

    // Add modal state
    private bool    _showAdd;
    private string? _formError;
    private bool    _formSaving;
    private string  _fUsername        = "";
    private string  _fDisplayName     = "";
    private string  _fEmail           = "";
    private string  _fPassword        = "";
    private string  _fPasswordConfirm = "";

    // MFA modal state
    private string?   _mfaSetupToken;
    private DateTime? _mfaSetupExpiry;

    // Import modal state
    private bool                    _showImport;
    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? _importFile;
    private bool                    _importSaving;
    private string?                 _importError;
    private ImportResultDto?        _importResult;

    // Edit modal state
    private bool    _showEdit;
    private string  _eUserId      = "";
    private string  _eUsername    = "";
    private string  _eDisplayName = "";
    private string  _eEmail       = "";
    private string? _editError;
    private bool    _editSaving;

    private int TotalPages => _meta == null ? 1 : (int)Math.Ceiling(_meta.TotalCount / (double)_pageSize);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error   = null;
        StateHasChanged();

        var result = await Api.GetUsersAsync(_search, _statusFilter, _page, _pageSize);
        if (result == null)
            _error = "Failed to load users — check API connection.";
        else
        {
            _users = result.Data;
            _meta  = result.Meta;
        }

        _loading = false;
        StateHasChanged();
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { _page = 1; await LoadAsync(); }
    }

    private async Task SetStatusAsync(string userId, string status)
    {
        await Api.SetUserStatusAsync(userId, status);
        await LoadAsync();
    }

    private void OpenAddModal()
    {
        _fUsername = _fDisplayName = _fEmail = _fPassword = _fPasswordConfirm = "";
        _formError = null;
        _showAdd   = true;
    }

    private void CloseModal() { _showAdd = false; _formError = null; }

    private async Task SubmitAddUserAsync()
    {
        _formError = null;
        if (string.IsNullOrWhiteSpace(_fUsername))   { _formError = "Username is required."; return; }
        if (string.IsNullOrWhiteSpace(_fPassword))   { _formError = "Password is required."; return; }
        if (_fPassword != _fPasswordConfirm)          { _formError = "Passwords do not match."; return; }

        _formSaving = true;
        StateHasChanged();

        var ok = await Api.CreateUserAsync(
            _fUsername.Trim(),
            string.IsNullOrWhiteSpace(_fDisplayName) ? null : _fDisplayName.Trim(),
            string.IsNullOrWhiteSpace(_fEmail)       ? null : _fEmail.Trim(),
            _fPassword);

        _formSaving = false;

        if (!ok)
        {
            _formError = "Failed to create user — check username uniqueness and password policy.";
            StateHasChanged();
            return;
        }

        CloseModal();
        _page = 1;
        await LoadAsync();
    }

    private void OpenEditModal(UserDto u)
    {
        _eUserId      = u.Id;
        _eUsername    = u.Username;
        _eDisplayName = u.DisplayName ?? "";
        _eEmail       = u.Email ?? "";
        _editError    = null;
        _showEdit     = true;
    }

    private void CloseEditModal() { _showEdit = false; _editError = null; }

    private async Task SubmitEditUserAsync()
    {
        _editError  = null;
        _editSaving = true;
        StateHasChanged();

        var ok = await Api.UpdateUserAsync(
            _eUserId,
            string.IsNullOrWhiteSpace(_eDisplayName) ? null : _eDisplayName.Trim(),
            string.IsNullOrWhiteSpace(_eEmail)        ? null : _eEmail.Trim());

        _editSaving = false;

        if (!ok)
        {
            _editError = "Failed to save changes — please try again.";
            StateHasChanged();
            return;
        }

        CloseEditModal();
        await LoadAsync();
    }

    private async Task ResetMfaAsync(string userId, string username)
    {
        _error = null;
        var ok = await Api.ResetUserMfaAsync(userId);
        if (ok) await LoadAsync();
        else _error = $"Failed to reset MFA for {username}.";
    }

    private async Task SendMfaSetupAsync(string userId)
    {
        _error = null;
        var result = await Api.GenerateMfaSetupLinkAsync(userId);
        if (result == null) { _error = "Failed to generate MFA setup link."; return; }
        _mfaSetupToken  = result.EnrollmentToken;
        _mfaSetupExpiry = result.ExpiresAt;
        StateHasChanged();
    }

    private void CloseMfaModal() { _mfaSetupToken = null; _mfaSetupExpiry = null; }

    private void OpenImportModal()
    {
        _importFile   = null;
        _importError  = null;
        _importResult = null;
        _showImport   = true;
    }

    private void CloseImportModal() { _showImport = false; }

    private void OnImportFileSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        _importFile  = e.File;
        _importError = null;
        _importResult = null;
    }

    private async Task SubmitImportAsync()
    {
        if (_importFile == null) return;
        _importSaving = true;
        _importError  = null;
        _importResult = null;
        StateHasChanged();

        var result = await Api.BulkImportUsersAsync(_importFile);
        _importSaving = false;

        if (result == null)
            _importError = "Import failed — please check the file format and try again.";
        else
            _importResult = result;

        if (_importResult?.Failed == 0 && _importResult?.Imported > 0)
            await LoadAsync();

        StateHasChanged();
    }

    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }
}
