@page "/portal"
@inject PamApiService Api
@inject AuthStateService Auth
@inject NavigationManager Nav

<PageTitle>My Portal — OrkunPAM</PageTitle>

<div class="pam-page-header">
    <h2 class="pam-page-title">Self-Service Portal</h2>
    <span class="pam-page-sub">Your devices, credentials and access requests in one place</span>
</div>

@if (_error != null) { <div class="pam-alert pam-alert-danger">@_error</div> }
@if (_success != null) { <div class="pam-alert pam-alert-success">@_success</div> }

<div class="pam-tabs">
    <button class="pam-tab @(_tab == "devices" ? "active" : "")" @onclick="@(() => SetTab("devices"))">
        My Devices
        @if (_devices != null) { <span class="pam-badge-count">@_devices.Count</span> }
    </button>
    <button class="pam-tab @(_tab == "vault" ? "active" : "")" @onclick="@(() => SetTab("vault"))">
        My Vault
        @if (_credentials != null) { <span class="pam-badge-count">@_credentials.Count</span> }
    </button>
    <button class="pam-tab @(_tab == "requests" ? "active" : "")" @onclick="@(() => SetTab("requests"))">
        My Requests
        @if (_activeJit > 0) { <span class="pam-badge-count" style="background:#c00">@_activeJit</span> }
    </button>
    <button class="pam-tab @(_tab == "sessions" ? "active" : "")" @onclick="@(() => SetTab("sessions"))">
        My Sessions
        @if (_mySessions != null) { <span class="pam-badge-count">@_mySessions.Count</span> }
    </button>
    <button class="pam-tab @(_tab == "jit" ? "active" : "")" @onclick="@(() => SetTab("jit"))">+ Request Access</button>
    <button class="pam-tab @(_tab == "profile" ? "active" : "")" @onclick="@(() => SetTab("profile"))">My Profile</button>
    <button class="pam-tab @(_tab == "security" ? "active" : "")" @onclick="@(() => SetTab("security"))">Security</button>
    <button class="pam-tab @(_tab == "trusted" ? "active" : "")" @onclick="@(() => SetTab("trusted"))">Trusted Devices</button>
</div>

@* ===== MY DEVICES ===== *@
@if (_tab == "devices")
{
    <div class="pam-card">
        <div class="pam-card-header">
            <span>Accessible Devices</span>
            <input class="pam-input pam-input-sm" style="max-width:240px" placeholder="Filter by hostname..." @bind="_deviceFilter" @bind:event="oninput" />
        </div>
        <div class="pam-card-body">
            @if (_loading) { <div class="pam-loading-text">Loading devices...</div> }
            else if (_devices == null || _devices.Count == 0) { <div class="pam-empty">No devices assigned to you.</div> }
            else
            {
                var filtered = string.IsNullOrWhiteSpace(_deviceFilter)
                    ? _devices
                    : _devices.Where(d => d.Hostname.Contains(_deviceFilter, StringComparison.OrdinalIgnoreCase)).ToList();
                <table class="pam-table">
                    <thead><tr><th>Hostname</th><th>IP Address</th><th>Type</th><th>Protocol</th><th>OS</th><th>Status</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var d in filtered)
                        {
                            <tr>
                                <td><strong>@d.Hostname</strong>@(d.Fqdn != null ? " (" + d.Fqdn + ")" : "")</td>
                                <td><code>@(d.IpAddress ?? "—")</code></td>
                                <td>@d.Type</td>
                                <td><span class="pam-badge pam-badge-blue">@d.Protocol</span></td>
                                <td>@(d.OperatingSystem ?? "—")</td>
                                <td>
                                    @if (d.IsReachable == true)
                                    { <span class="pam-badge pam-badge-green">Online</span> }
                                    else
                                    { <span class="pam-badge pam-badge-gray">Offline</span> }
                                </td>
                                <td>
                                    @if (d.Protocol == "SSH" || d.Protocol == "ssh")
                                    {
                                        <button class="pam-btn pam-btn-xs pam-btn-primary" @onclick="@(() => ConnectSsh(d))">SSH Connect</button>
                                    }
                                    else if (d.Protocol == "RDP" || d.Protocol == "rdp")
                                    {
                                        <button class="pam-btn pam-btn-xs pam-btn-info" @onclick="@(() => ConnectRdp(d))">RDP Connect</button>
                                    }
                                    else
                                    {
                                        <button class="pam-btn pam-btn-xs pam-btn-secondary" @onclick="@(() => Nav.NavigateTo("/connect"))">Connect</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@* ===== MY VAULT ===== *@
@if (_tab == "vault")
{
    <div class="pam-card">
        <div class="pam-card-header">
            <span>My Credentials</span>
            <input class="pam-input pam-input-sm" style="max-width:240px" placeholder="Filter by name..." @bind="_credFilter" @bind:event="oninput" />
        </div>
        <div class="pam-card-body">
            @if (_loading) { <div class="pam-loading-text">Loading credentials...</div> }
            else if (_credentials == null || _credentials.Count == 0) { <div class="pam-empty">No credentials accessible to you.</div> }
            else
            {
                var filtered = string.IsNullOrWhiteSpace(_credFilter)
                    ? _credentials
                    : _credentials.Where(c => c.Name.Contains(_credFilter, StringComparison.OrdinalIgnoreCase)).ToList();
                <table class="pam-table">
                    <thead><tr><th>Name</th><th>Username</th><th>Type</th><th>Status</th><th>Last Rotated</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var c in filtered)
                        {
                            <tr>
                                <td><strong>@c.Name</strong>@(c.Description != null ? " — " + c.Description : "")</td>
                                <td><code>@(c.Username ?? "—")</code></td>
                                <td>@c.Type</td>
                                <td>
                                    @if (c.IsCheckedOut)
                                    { <span class="pam-badge pam-badge-yellow">Checked Out</span> }
                                    else
                                    { <span class="pam-badge pam-badge-green">Available</span> }
                                </td>
                                <td>@(c.LastRotatedAtUtc.HasValue ? c.LastRotatedAtUtc.Value.ToString("MM/dd/yyyy") : "Never")</td>
                                <td>
                                    @if (!c.IsCheckedOut)
                                    {
                                        <button class="pam-btn pam-btn-xs pam-btn-primary" @onclick="@(() => ShowCheckoutDialog(c))">Check Out</button>
                                    }
                                    else if (c.CheckedOutByUserId == _myUserId)
                                    {
                                        <button class="pam-btn pam-btn-xs pam-btn-warning" @onclick="@(() => CheckinAsync(c.Id))">Check In</button>
                                    }
                                    else
                                    {
                                        <span class="pam-text-muted">In use</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    @if (_checkedOutCred != null)
    {
        <div class="pam-card" style="max-width:520px;border-left:4px solid #28a745">
            <div class="pam-card-header">Credential: @_checkedOutCred.Name</div>
            <div class="pam-card-body">
                <div class="pam-form-group">
                    <label class="pam-label">Username</label>
                    <code class="pam-copyable">@(_checkedOutCred.Username ?? "—")</code>
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Password</label>
                    @if (_showPassword)
                    {
                        <code class="pam-copyable">@_checkedOutCred.Password</code>
                        <button class="pam-btn pam-btn-xs pam-btn-secondary" style="margin-left:8px" @onclick="@(() => _showPassword = false)">Hide</button>
                    }
                    else
                    {
                        <span class="pam-text-muted">••••••••</span>
                        <button class="pam-btn pam-btn-xs pam-btn-secondary" style="margin-left:8px" @onclick="@(() => _showPassword = true)">Reveal</button>
                    }
                </div>
                @if (_checkedOutCred.ExpiresAt.HasValue)
                {
                    <div class="pam-form-group">
                        <label class="pam-label">Expires</label>
                        <span>@_checkedOutCred.ExpiresAt.Value.ToString("MM/dd/yyyy HH:mm") UTC</span>
                    </div>
                }
                <button class="pam-btn pam-btn-secondary pam-btn-sm" @onclick="@(() => { _checkedOutCred = null; _showPassword = false; })">Close</button>
            </div>
        </div>
    }
}

@* ===== CHECKOUT DIALOG ===== *@
@if (_checkoutTarget != null)
{
    <div class="pam-modal-overlay" @onclick="@(() => _checkoutTarget = null)">
        <div class="pam-modal" @onclick:stopPropagation="true">
            <div class="pam-modal-header">Check Out: @_checkoutTarget.Name</div>
            <div class="pam-modal-body">
                <div class="pam-form-group">
                    <label class="pam-label">Reason</label>
                    <textarea class="pam-input" rows="3" placeholder="Business justification (min 5 chars)..." @bind="_checkoutReason"></textarea>
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Duration</label>
                    <select class="pam-select" @bind="_checkoutDuration">
                        <option value="30">30 minutes</option>
                        <option value="60">1 hour</option>
                        <option value="120">2 hours</option>
                        <option value="240">4 hours</option>
                        <option value="480">8 hours</option>
                    </select>
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Ticket # (optional)</label>
                    <input class="pam-input" placeholder="e.g. INC0012345" @bind="_checkoutTicket" />
                </div>
            </div>
            <div class="pam-modal-footer">
                <button class="pam-btn pam-btn-primary" @onclick="DoCheckoutAsync" disabled="@_submitting">
                    @(_submitting ? "Checking out..." : "Check Out")
                </button>
                <button class="pam-btn pam-btn-secondary" @onclick="@(() => _checkoutTarget = null)">Cancel</button>
            </div>
        </div>
    </div>
}

@* ===== MY SESSIONS ===== *@
@if (_tab == "sessions")
{
    <div class="pam-card">
        <div class="pam-card-header">
            <span>My Active Sessions</span>
        </div>
        <div class="pam-card-body">
            @if (_loading) { <div class="pam-loading-text">Loading sessions...</div> }
            else if (_mySessions == null || _mySessions.Count == 0) { <div class="pam-empty">No sessions found.</div> }
            else
            {
                <table class="pam-table">
                    <thead><tr><th>Target</th><th>Protocol</th><th>Started</th><th>Duration</th><th>Status</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var s in _mySessions)
                        {
                            <tr>
                                <td><code>@(s.TargetIpAddress ?? "---")@(s.TargetPort.HasValue ? ":" + s.TargetPort : "")</code></td>
                                <td><span class="pam-badge pam-badge-blue">@s.Type</span></td>
                                <td>@s.StartedAtUtc.ToString("MM/dd HH:mm")</td>
                                <td>@s.DurationMinutes min</td>
                                <td>
                                    @if (s.Status == "Active")
                                    { <span class="pam-badge pam-badge-green">Active</span> }
                                    else if (s.Status == "Completed")
                                    { <span class="pam-badge pam-badge-gray">Completed</span> }
                                    else if (s.Status == "Terminated")
                                    { <span class="pam-badge pam-badge-red">Terminated</span> }
                                    else
                                    { <span class="pam-badge">@s.Status</span> }
                                </td>
                                <td>
                                    @if (s.Status == "Active")
                                    {
                                        <button class="pam-btn pam-btn-xs pam-btn-danger"
                                                @onclick="@(() => EndMySessionAsync(s.Id))"
                                                disabled="@_submitting">
                                            End Session
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@* ===== MY REQUESTS ===== *@
@if (_tab == "requests")
{
    <div class="pam-card">
        <div class="pam-card-header">My JIT Access Requests</div>
        <div class="pam-card-body">
            @if (_loading) { <div class="pam-loading-text">Loading your requests...</div> }
            else if (_myRequests == null || _myRequests.Count == 0) { <div class="pam-empty">You have no JIT access requests.</div> }
            else
            {
                <table class="pam-table">
                    <thead><tr><th>Status</th><th>Resource</th><th>Duration</th><th>Reason</th><th>Created</th><th>Expires</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var r in _myRequests)
                        {
                            <tr>
                                <td><span class="pam-badge @JitStatusClass(r.Status)">@r.Status</span></td>
                                <td>@r.ResourceType@(r.ResourceName != null ? ": " + r.ResourceName : "")</td>
                                <td>@r.RequestedDurationMinutes min</td>
                                <td title="@r.Reason">@Truncate(r.Reason, 40)</td>
                                <td>@r.CreatedAtUtc.ToString("MM/dd HH:mm")</td>
                                <td>@(r.ExpiresAtUtc.HasValue ? r.ExpiresAtUtc.Value.ToString("MM/dd HH:mm") : "—")</td>
                                <td>
                                    @if (r.Status == "Active" && !r.ExtensionRequested)
                                    {
                                        <button class="pam-btn pam-btn-xs pam-btn-info" @onclick="@(() => RequestExtensionAsync(r.Id))">Extend</button>
                                    }
                                    else if (r.ExtensionRequested)
                                    {
                                        <span class="pam-text-muted">Extension pending</span>
                                    }
                                    @if (r.Status == "Denied" && r.DenyReason != null)
                                    {
                                        <span class="pam-text-muted" title="@r.DenyReason">Denied: @Truncate(r.DenyReason, 25)</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@* ===== REQUEST ACCESS (JIT) ===== *@
@if (_tab == "jit")
{
    <div class="pam-card" style="max-width:600px">
        <div class="pam-card-header">Request Privileged Access</div>
        <div class="pam-card-body">
            <div class="pam-form-group">
                <label class="pam-label">Resource Type</label>
                <select class="pam-select" @bind="_jitResourceType">
                    <option value="Device">Device</option>
                    <option value="Credential">Credential</option>
                    <option value="System">System</option>
                    <option value="Database">Database</option>
                </select>
            </div>
            <div class="pam-form-group">
                <label class="pam-label">Resource Name (optional)</label>
                <input class="pam-input" placeholder="e.g. prod-db-01" @bind="_jitResourceName" />
            </div>
            <div class="pam-form-group">
                <label class="pam-label">Duration</label>
                <select class="pam-select" @bind="_jitDuration">
                    <option value="30">30 minutes</option>
                    <option value="60">1 hour</option>
                    <option value="120">2 hours</option>
                    <option value="240">4 hours</option>
                    <option value="480">8 hours</option>
                </select>
            </div>
            <div class="pam-form-group">
                <label class="pam-label">Business Justification</label>
                <textarea class="pam-input" rows="4" placeholder="Explain why you need this access (min 10 chars)..." @bind="_jitReason"></textarea>
            </div>
            <button class="pam-btn pam-btn-primary" @onclick="SubmitJitAsync" disabled="@_submitting">
                @(_submitting ? "Submitting..." : "Submit Request")
            </button>
        </div>
    </div>
}

@* ===== MY PROFILE ===== *@
@if (_tab == "profile")
{
    <div style="display:flex;gap:24px;flex-wrap:wrap;align-items:flex-start">
        @* --- Account Info Card --- *@
        <div class="pam-card" style="flex:1;min-width:280px;max-width:440px">
            <div class="pam-card-header">Account Information</div>
            <div class="pam-card-body">
                @if (_loading)
                {
                    <div class="pam-loading-text">Loading profile...</div>
                }
                else if (_profile == null)
                {
                    <div class="pam-empty">Could not load profile.</div>
                }
                else
                {
                    <table class="pam-table pam-table-compact">
                        <tbody>
                            <tr><td style="color:var(--pam-muted);width:140px">Username</td><td><strong>@_profile.Username</strong></td></tr>
                            <tr><td style="color:var(--pam-muted)">Display Name</td><td>@(_profile.DisplayName ?? "—")</td></tr>
                            <tr><td style="color:var(--pam-muted)">Email</td><td>@(_profile.Email ?? "—")</td></tr>
                            <tr><td style="color:var(--pam-muted)">Auth Source</td><td><span class="pam-badge pam-badge-blue">@_profile.AuthSource</span></td></tr>
                            <tr><td style="color:var(--pam-muted)">Status</td><td>
                                @if (_profile.Status == "Active")
                                { <span class="pam-badge pam-badge-green">Active</span> }
                                else
                                { <span class="pam-badge pam-badge-gray">@_profile.Status</span> }
                            </td></tr>
                            <tr><td style="color:var(--pam-muted)">Roles</td><td>
                                @if (_profile.Roles != null)
                                { @foreach (var r in _profile.Roles) { <span class="pam-badge pam-badge-purple" style="margin-right:4px">@r</span> } }
                                else { <span class="pam-text-muted">—</span> }
                            </td></tr>
                            <tr><td style="color:var(--pam-muted)">MFA</td><td>
                                @if (_profile.MfaEnabled)
                                { <span class="pam-badge pam-badge-green">Enabled (@_profile.MfaType)</span> }
                                else
                                { <span class="pam-badge pam-badge-yellow">Disabled</span> }
                            </td></tr>
                            <tr><td style="color:var(--pam-muted)">Last Login</td><td>@(_profile.LastLoginAtUtc.HasValue ? _profile.LastLoginAtUtc.Value.ToString("yyyy-MM-dd HH:mm") + " UTC" : "—")</td></tr>
                            <tr><td style="color:var(--pam-muted)">Password Changed</td><td>@(_profile.PasswordLastChanged.HasValue ? _profile.PasswordLastChanged.Value.ToString("yyyy-MM-dd") : "Never")</td></tr>
                            <tr><td style="color:var(--pam-muted)">Password Expires</td><td>@(_profile.PasswordExpiresAt.HasValue ? _profile.PasswordExpiresAt.Value.ToString("yyyy-MM-dd") : "Never")</td></tr>
                            <tr><td style="color:var(--pam-muted)">Timezone</td><td>@_profile.Timezone</td></tr>
                            <tr><td style="color:var(--pam-muted)">Language</td><td>@_profile.Language</td></tr>
                        </tbody>
                    </table>
                    @if (_profile.MustChangePassword)
                    {
                        <div class="pam-alert pam-alert-warning" style="margin-top:12px">You must change your password before continuing.</div>
                    }
                }
            </div>
        </div>

        @* --- Change Password Card --- *@
        <div class="pam-card" style="flex:1;min-width:280px;max-width:380px">
            <div class="pam-card-header">Change Password</div>
            <div class="pam-card-body">
                @if (_profile != null && _profile.AuthSource != "Local")
                {
                    <div class="pam-empty">Password change is only available for local accounts. Your account uses <strong>@_profile.AuthSource</strong> authentication.</div>
                }
                else
                {
                    <div class="pam-form-group">
                        <label class="pam-label">Current Password</label>
                        <input type="password" class="pam-input" @bind="_pwCurrent" autocomplete="current-password" />
                    </div>
                    <div class="pam-form-group">
                        <label class="pam-label">New Password</label>
                        <input type="password" class="pam-input" @bind="_pwNew" autocomplete="new-password" />
                        <span class="pam-text-muted" style="font-size:0.8em">Min 12 chars, include uppercase, lowercase, number and special character.</span>
                    </div>
                    <div class="pam-form-group">
                        <label class="pam-label">Confirm New Password</label>
                        <input type="password" class="pam-input" @bind="_pwConfirm" autocomplete="new-password" />
                    </div>
                    <button class="pam-btn pam-btn-primary" @onclick="DoChangePasswordAsync" disabled="@_submitting">
                        @(_submitting ? "Saving..." : "Change Password")
                    </button>
                }
            </div>
        </div>
    </div>
}

@* ===== SECURITY (MFA DEVICES) ===== *@
@if (_tab == "security")
{
    <div class="pam-card">
        <div class="pam-card-header">
            <span>My MFA Methods</span>
            <span class="pam-text-muted" style="font-size:.85rem">Enrolled second-factor authentication methods</span>
        </div>
        <div class="pam-card-body">
            @if (_loadingSecurity)
            {
                <div class="pam-loading-text">Loading MFA methods...</div>
            }
            else if (_mfaDevices == null || _mfaDevices.Count == 0)
            {
                <div class="pam-empty">
                    No MFA methods enrolled. Enable MFA from
                    <a href="/mfa-setup" style="color:#58a6ff">MFA Setup</a>.
                </div>
            }
            else
            {
                <table class="pam-table">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Device / Method</th>
                            <th>Status</th>
                            <th>Details</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _mfaDevices)
                        {
                            <tr>
                                <td>
                                    @switch (d.Type)
                                    {
                                        case "totp":
                                            <span class="pam-badge pam-badge-blue">TOTP</span>
                                            break;
                                        case "email_otp":
                                            <span class="pam-badge pam-badge-blue">Email OTP</span>
                                            break;
                                        case "sms":
                                            <span class="pam-badge pam-badge-blue">SMS OTP</span>
                                            break;
                                        case "fido2":
                                            <span class="pam-badge pam-badge-purple">FIDO2</span>
                                            break;
                                        case "push":
                                            <span class="pam-badge pam-badge-green">Push</span>
                                            break;
                                        default:
                                            <span class="pam-badge">@d.Type</span>
                                            break;
                                    }
                                </td>
                                <td><strong>@d.Name</strong></td>
                                <td><span class="pam-badge pam-badge-green">@d.Status</span></td>
                                <td><span class="pam-text-muted">@(d.Detail ?? "—")</span></td>
                                <td>
                                    @if (d.Type == "totp" || d.Type == "email_otp" || d.Type == "sms")
                                    {
                                        <button class="pam-btn pam-btn-xs pam-btn-danger"
                                                @onclick="@(() => RevokeByTypeAsync(d.Type))"
                                                disabled="@_submitting">
                                            Revoke
                                        </button>
                                    }
                                    else if (d.Type == "fido2" && d.DeviceId != null)
                                    {
                                        <button class="pam-btn pam-btn-xs pam-btn-danger"
                                                @onclick="@(() => RevokeFido2Async(d.DeviceId))"
                                                disabled="@_submitting">
                                            Revoke
                                        </button>
                                    }
                                    else if (d.Type == "push" && d.DeviceId != null)
                                    {
                                        <button class="pam-btn pam-btn-xs pam-btn-danger"
                                                @onclick="@(() => RevokePushAsync(d.DeviceId))"
                                                disabled="@_submitting">
                                            Revoke
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            <div style="margin-top:16px;display:flex;gap:8px;flex-wrap:wrap">
                <a href="/mfa-setup" class="pam-btn pam-btn-secondary pam-btn-sm">Manage TOTP</a>
                <a href="/security-keys" class="pam-btn pam-btn-secondary pam-btn-sm">Manage Security Keys</a>
                <button class="pam-btn pam-btn-secondary pam-btn-sm"
                        @onclick="@(() => RegisterBiometricPasskeyAsync())"
                        disabled="@_submitting">
                    🔐 Add Biometric Passkey
                </button>
                <a href="/push-devices" class="pam-btn pam-btn-secondary pam-btn-sm">Manage Push Devices</a>
            </div>
            @if (!string.IsNullOrEmpty(_biometricMsg))
            {
                <div class="@(_biometricSuccess ? "pam-alert pam-alert-success" : "pam-alert pam-alert-danger")" style="margin-top:8px">
                    @_biometricMsg
                </div>
            }
        </div>
    </div>

    @if (_hwTokens != null && _hwTokens.Any(t => t.TokenType == "Hotp" && t.IsActive))
    {
        <div class="pam-card" style="margin-top:16px">
            <div class="pam-card-header">
                <span>Hardware HOTP Tokens</span>
                <span class="pam-text-muted" style="font-size:.85rem">Resynchronize counter-based tokens</span>
            </div>
            <div class="pam-card-body">
                @if (_loadingHwTokens)
                {
                    <div class="pam-loading-text">Loading...</div>
                }
                else
                {
                    <table class="pam-table">
                        <thead>
                            <tr><th>Serial</th><th>Label</th><th>Status</th><th>Actions</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var hwt in _hwTokens.Where(t => t.TokenType == "Hotp" && t.IsActive))
                            {
                                <tr>
                                    <td><code>@hwt.SerialNumber</code></td>
                                    <td>@(hwt.Label ?? "—")</td>
                                    <td><span class="pam-badge pam-badge-green">Active</span></td>
                                    <td>
                                        <button class="pam-btn pam-btn-xs pam-btn-secondary"
                                                @onclick="@(() => OpenResyncModal(hwt))">
                                            Resync
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }

    @* ── Backup Codes (#289 — MFA #21) ── *@
    <div class="pam-card" style="margin-top:16px">
        <div class="pam-card-header">
            <span>Backup Codes</span>
            <span class="pam-text-muted" style="font-size:.85rem">One-time emergency codes when your MFA device is unavailable</span>
        </div>
        <div class="pam-card-body">
            @if (_loadingBackupCodes)
            {
                <div class="pam-loading-text">Loading backup code status...</div>
            }
            else if (_backupCodeStatus == null)
            {
                <div class="pam-empty">Enable MFA to use backup codes.</div>
            }
            else if (!_backupCodeStatus.MfaEnabled)
            {
                <div class="pam-empty">Backup codes require MFA to be enabled. <a href="/mfa-setup" style="color:#58a6ff">Enable MFA</a>.</div>
            }
            else
            {
                <div style="display:flex;gap:24px;align-items:center;flex-wrap:wrap;margin-bottom:16px">
                    <div>
                        <span style="font-size:2rem;font-weight:bold;color:@(_backupCodeStatus.Remaining < 3 ? "var(--pam-danger)" : "var(--pam-success)")">
                            @_backupCodeStatus.Remaining
                        </span>
                        <span class="pam-text-muted"> / 10 codes remaining</span>
                        @if (_backupCodeStatus.Remaining < 3)
                        {
                            <span class="pam-badge pam-badge-red" style="margin-left:8px">Low — Regenerate Now</span>
                        }
                    </div>
                    @if (_backupCodeStatus.GeneratedAtUtc.HasValue)
                    {
                        <div class="pam-text-muted" style="font-size:.85rem">
                            Last generated: @_backupCodeStatus.GeneratedAtUtc.Value.ToString("yyyy-MM-dd HH:mm") UTC
                        </div>
                    }
                    else
                    {
                        <div class="pam-text-muted" style="font-size:.85rem">No backup codes generated yet.</div>
                    }
                </div>
                <div style="display:flex;gap:8px;flex-wrap:wrap">
                    <button class="pam-btn pam-btn-secondary pam-btn-sm"
                            @onclick="@(() => OpenGenerateBackupCodesModal())"
                            disabled="@_submitting">
                        Generate New Codes
                    </button>
                </div>
                <p class="pam-text-muted" style="font-size:.82rem;margin-top:12px">
                    Backup codes are single-use. Generating a new set invalidates all previous codes. Store them in a safe, offline location.
                </p>
            }
        </div>
    </div>

    @* Generate Backup Codes Modal *@
    @if (_showGenerateBackupCodesModal)
    {
        <div class="pam-modal-overlay">
            <div class="pam-modal">
                <div class="pam-modal-header">
                    <span>@(_generatedCodes == null ? "Generate New Backup Codes" : "Your New Backup Codes")</span>
                    <button class="pam-modal-close" @onclick="@(() => CloseGenerateBackupCodesModal())">x</button>
                </div>
                <div class="pam-modal-body">
                    @if (_generatedCodes == null)
                    {
                        <div class="pam-alert pam-alert-warning" style="margin-bottom:12px">
                            <strong>Warning:</strong> Generating new codes will permanently invalidate all existing backup codes.
                        </div>
                        <p>10 new one-time backup codes will be generated. Make sure to save them — they will only be shown once.</p>
                        <div style="display:flex;gap:8px;margin-top:16px">
                            <button class="pam-btn pam-btn-primary" @onclick="@(() => GenerateBackupCodesAsync())" disabled="@_submitting">
                                @(_submitting ? "Generating..." : "Generate Codes")
                            </button>
                            <button class="pam-btn pam-btn-secondary" @onclick="@(() => CloseGenerateBackupCodesModal())" disabled="@_submitting">Cancel</button>
                        </div>
                    }
                    else
                    {
                        <div class="pam-alert pam-alert-success" style="margin-bottom:12px">
                            10 backup codes generated. Save them securely — they will <strong>not</strong> be shown again.
                        </div>
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;font-family:monospace;font-size:1.1rem;margin-bottom:16px">
                            @foreach (var c in _generatedCodes)
                            {
                                <div style="background:var(--pam-surface-alt,#161b22);padding:6px 12px;border-radius:4px;text-align:center">
                                    @c[..4]-@c[4..]
                                </div>
                            }
                        </div>
                        <button class="pam-btn pam-btn-primary" @onclick="@(() => CloseGenerateBackupCodesModal())">Done</button>
                    }
                    @if (!string.IsNullOrEmpty(_backupCodesError))
                    {
                        <div class="pam-alert pam-alert-danger" style="margin-top:8px">@_backupCodesError</div>
                    }
                </div>
            </div>
        </div>
    }
}

@* ===== TRUSTED DEVICES (#257) ===== *@
@if (_tab == "trusted")
{
    <div class="pam-card">
        <div class="pam-card-header">
            <span>Trusted Browsers / Devices</span>
            <span class="pam-text-muted" style="font-size:.85rem">Browsers that skip MFA verification</span>
        </div>
        <div class="pam-card-body">
            @if (_loadingTrusted)
            {
                <div class="pam-loading-text">Loading trusted devices...</div>
            }
            else if (_trustedSessions == null || _trustedSessions.Count == 0)
            {
                <div class="pam-empty">No trusted browsers registered. Enable MFA trust in policy settings and check "Trust this browser" during login.</div>
            }
            else
            {
                <table class="pam-table">
                    <thead><tr><th>Label</th><th>Granted From</th><th>Granted</th><th>Last Used</th><th>Expires</th><th>Actions</th></tr></thead>
                    <tbody>
                        @foreach (var s in _trustedSessions)
                        {
                            <tr>
                                <td><strong>@(s.DeviceLabel ?? "Browser")</strong></td>
                                <td><code>@(s.GrantedFromIp ?? "—")</code></td>
                                <td style="font-size:.82rem">@s.GrantedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td style="font-size:.82rem">@(s.LastUsedAtUtc.HasValue ? s.LastUsedAtUtc.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : "Never")</td>
                                <td>
                                    @if (s.TrustExpiresAtUtc > DateTime.UtcNow)
                                    { <span class="pam-badge pam-badge-green">@s.TrustExpiresAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</span> }
                                    else
                                    { <span class="pam-badge pam-badge-gray">Expired</span> }
                                </td>
                                <td>
                                    <button class="pam-btn pam-btn-xs pam-btn-danger" @onclick="@(() => RevokeTrustedSessionAsync(s.Id))" disabled="@_submitting">Revoke</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@* ===== HOTP RESYNC MODAL (#277) ===== *@
@if (_resyncTarget != null)
{
    <div class="pam-modal-overlay" @onclick="@(() => CloseResyncModal())">
        <div class="pam-modal" @onclick:stopPropagation="true">
            <div class="pam-modal-header">Resync Token: @_resyncTarget.SerialNumber</div>
            <div class="pam-modal-body">
                @if (_resyncError != null) { <div class="pam-alert pam-alert-danger">@_resyncError</div> }
                <p class="pam-text-muted" style="font-size:.85rem;margin-bottom:12px">
                    Press your token twice in sequence and enter both OTPs below.
                </p>
                <div class="pam-form-group">
                    <label class="pam-label">First OTP</label>
                    <input class="pam-input" maxlength="8" placeholder="e.g. 123456"
                           @bind="_resyncOtp1" autocomplete="one-time-code" />
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Second OTP (next press)</label>
                    <input class="pam-input" maxlength="8" placeholder="e.g. 789012"
                           @bind="_resyncOtp2" autocomplete="one-time-code" />
                </div>
            </div>
            <div class="pam-modal-footer">
                <button class="pam-btn pam-btn-primary" @onclick="SubmitResyncAsync" disabled="@_resyncSaving">
                    @(_resyncSaving ? "Resyncing..." : "Resync Token")
                </button>
                <button class="pam-btn pam-btn-secondary" @onclick="@(() => CloseResyncModal())">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private string _tab = "devices";
    private bool _loading;
    private bool _submitting;
    private string? _error;
    private string? _success;
    private string? _myUserId;
    private string? _biometricMsg;
    private bool    _biometricSuccess;

    private List<DeviceDto>? _devices;
    private string _deviceFilter = string.Empty;

    private List<CredentialDto>? _credentials;
    private string _credFilter = string.Empty;
    private CredentialDto? _checkoutTarget;
    private string _checkoutReason = string.Empty;
    private string? _checkoutTicket;
    private int _checkoutDuration = 60;
    private CheckoutResultDto? _checkedOutCred;
    private bool _showPassword;

    private List<JitRequestDto>? _myRequests;
    private int _activeJit;

    private List<MySessionDto>? _mySessions;

    private string _jitResourceType = "Device";
    private string? _jitResourceName;
    private int _jitDuration = 60;
    private string _jitReason = string.Empty;

    private UserProfileDto? _profile;
    private string _pwCurrent  = string.Empty;
    private string _pwNew      = string.Empty;
    private string _pwConfirm  = string.Empty;

    private List<MfaDeviceDto>? _mfaDevices;
    private bool _loadingSecurity;

    private List<MfaTrustedSessionDto>? _trustedSessions;
    private bool _loadingTrusted;

    // HOTP Resync (#277)
    private List<HardwareTokenDto>? _hwTokens;
    private bool _loadingHwTokens;
    private HardwareTokenDto? _resyncTarget;
    private string _resyncOtp1 = string.Empty;
    private string _resyncOtp2 = string.Empty;
    private bool _resyncSaving;
    private string? _resyncError;

    // Backup Codes (#289 — MFA #21)
    private BackupCodeStatusDto? _backupCodeStatus;
    private bool _loadingBackupCodes;
    private bool _showGenerateBackupCodesModal;
    private string[]? _generatedCodes;
    private string? _backupCodesError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var user = await Auth.GetUserAsync();
        _myUserId = user?.UserId;
        await LoadDevicesAsync();
        StateHasChanged();
    }

    private async Task SetTab(string tab)
    {
        _tab = tab; _error = null; _success = null;
        if (tab == "devices") await LoadDevicesAsync();
        else if (tab == "vault") await LoadCredentialsAsync();
        else if (tab == "sessions") await LoadMySessionsAsync();
        else if (tab == "requests") await LoadMyRequestsAsync();
        else if (tab == "profile") await LoadProfileAsync();
        else if (tab == "security") { await LoadMfaDevicesAsync(); await LoadMyHwTokensAsync(); await LoadBackupCodeStatusAsync(); }
        else if (tab == "trusted") await LoadTrustedSessionsAsync();
    }

    private async Task LoadDevicesAsync()
    {
        _loading = true;
        var result = await Api.GetDevicesAsync();
        _devices = result?.Data ?? [];
        _loading = false;
    }

    private async Task LoadCredentialsAsync()
    {
        _loading = true;
        var result = await Api.GetCredentialsAsync();
        _credentials = result?.Data ?? [];
        _loading = false;
    }

    private async Task LoadMyRequestsAsync()
    {
        _loading = true;
        _myRequests = await Api.GetMyJitRequestsAsync();
        _activeJit = _myRequests?.Count(r => r.Status == "Active") ?? 0;
        _loading = false;
    }

    private void ConnectSsh(DeviceDto d)
    {
        var ip = d.IpAddress ?? d.Hostname;
        var port = d.ConnectionPort ?? 22;
        Nav.NavigateTo($"/connect?host={Uri.EscapeDataString(ip)}&port={port}&protocol=SSH");
    }

    private void ConnectRdp(DeviceDto d)
    {
        var ip = d.IpAddress ?? d.Hostname;
        var port = d.ConnectionPort ?? 3389;
        Nav.NavigateTo($"/connect?host={Uri.EscapeDataString(ip)}&port={port}&protocol=RDP");
    }

    private void ShowCheckoutDialog(CredentialDto c)
    {
        _checkoutTarget = c;
        _checkoutReason = string.Empty;
        _checkoutTicket = null;
        _checkoutDuration = 60;
        _error = null;
    }

    private async Task DoCheckoutAsync()
    {
        if (_checkoutTarget == null) return;
        if (string.IsNullOrWhiteSpace(_checkoutReason) || _checkoutReason.Trim().Length < 5)
        { _error = "Reason must be at least 5 characters."; return; }

        _submitting = true;
        var result = await Api.CheckoutCredentialAsync(_checkoutTarget.Id, _checkoutReason.Trim(), _checkoutTicket, _checkoutDuration);
        _submitting = false;

        _checkoutTarget = null;
        if (result != null)
        {
            _success = "Credential checked out successfully.";
            _checkedOutCred = result;
            _showPassword = false;
            await LoadCredentialsAsync();
        }
        else
        {
            _error = "Checkout failed. You may not have permission or the credential is unavailable.";
        }
    }

    private async Task CheckinAsync(string credId)
    {
        _error = null; _success = null;
        var ok = await Api.CheckinCredentialAsync(credId);
        if (ok) { _success = "Credential checked in."; _checkedOutCred = null; await LoadCredentialsAsync(); }
        else _error = "Failed to check in credential.";
    }

    private async Task RequestExtensionAsync(string id)
    {
        _error = null; _success = null;
        var ok = await Api.RequestJitExtensionAsync(id, 60, "Need more time");
        if (ok) { _success = "Extension request submitted."; await LoadMyRequestsAsync(); }
        else _error = "Failed to submit extension request.";
    }

    private async Task SubmitJitAsync()
    {
        _error = null; _success = null;
        if (string.IsNullOrWhiteSpace(_jitReason) || _jitReason.Trim().Length < 10)
        { _error = "Justification must be at least 10 characters."; return; }

        _submitting = true;
        var ok = await Api.SubmitJitRequestAsync(_jitResourceType, _jitResourceName, _jitReason.Trim(), _jitDuration);
        _submitting = false;

        if (ok)
        {
            _success = "JIT access request submitted. Awaiting admin approval.";
            _jitReason = string.Empty; _jitResourceName = null;
            _tab = "requests"; await LoadMyRequestsAsync();
        }
        else _error = "Failed to submit request.";
    }

    private async Task LoadMySessionsAsync()
    {
        _loading = true;
        _mySessions = await Api.GetMySessionsAsync();
        _loading = false;
    }

    private async Task EndMySessionAsync(string sessionId)
    {
        _error = null; _success = null; _submitting = true;
        var ok = await Api.EndMySessionAsync(sessionId);
        _submitting = false;
        if (ok) { _success = "Session ended."; await LoadMySessionsAsync(); }
        else _error = "Failed to end session.";
    }

    private async Task LoadProfileAsync()
    {
        _loading = true;
        _profile = await Api.GetMyProfileAsync();
        _loading = false;
    }

    private async Task LoadMfaDevicesAsync()
    {
        _loadingSecurity = true;
        _mfaDevices = await Api.GetMyMfaDevicesAsync();
        _loadingSecurity = false;
    }

    private async Task LoadBackupCodeStatusAsync()
    {
        _loadingBackupCodes = true;
        _backupCodeStatus = await Api.GetBackupCodeStatusAsync();
        _loadingBackupCodes = false;
    }

    private void OpenGenerateBackupCodesModal()
    {
        _generatedCodes = null;
        _backupCodesError = null;
        _showGenerateBackupCodesModal = true;
    }

    private void CloseGenerateBackupCodesModal()
    {
        _showGenerateBackupCodesModal = false;
        _generatedCodes = null;
        _backupCodesError = null;
        _ = LoadBackupCodeStatusAsync().ContinueWith(_ => InvokeAsync(StateHasChanged));
    }

    private async Task GenerateBackupCodesAsync()
    {
        _backupCodesError = null;
        _submitting = true;
        var codes = await Api.GenerateBackupCodesAsync();
        _submitting = false;
        if (codes == null || codes.Length == 0)
            _backupCodesError = "Failed to generate backup codes. Ensure MFA is enabled.";
        else
            _generatedCodes = codes;
    }

    private async Task LoadTrustedSessionsAsync()
    {
        _loadingTrusted = true;
        _trustedSessions = await Api.GetTrustedSessionsAsync();
        _loadingTrusted = false;
    }

    private async Task RevokeTrustedSessionAsync(Guid id)
    {
        _error = null; _success = null; _submitting = true;
        var ok = await Api.RevokeTrustedSessionAsync(id);
        _submitting = false;
        if (ok) { _success = "Trusted session revoked."; await LoadTrustedSessionsAsync(); }
        else _error = "Failed to revoke trusted session.";
    }

    private async Task RevokeByTypeAsync(string type)
    {
        _error = null; _success = null; _submitting = true;
        var ok = await Api.RevokeMfaDeviceByTypeAsync(type);
        _submitting = false;
        if (ok) { _success = "MFA method revoked."; await LoadMfaDevicesAsync(); }
        else _error = "Failed to revoke MFA method.";
    }

    private async Task RevokeFido2Async(string? credId)
    {
        if (credId == null) return;
        _error = null; _success = null; _submitting = true;
        var ok = await Api.RevokeFido2DeviceAsync(credId);
        _submitting = false;
        if (ok) { _success = "Security key revoked."; await LoadMfaDevicesAsync(); }
        else _error = "Failed to revoke security key.";
    }

    private async Task RegisterBiometricPasskeyAsync()
    {
        _biometricMsg = null; _submitting = true;
        var options = await Api.BeginFido2RegistrationAsync("platform");
        _submitting = false;
        if (options == null)
        {
            _biometricMsg = "Could not start biometric registration. Check browser support.";
            _biometricSuccess = false;
        }
        else
        {
            _biometricMsg = "Biometric passkey registration started. Complete it in the browser security dialog, then call the /api/v1/auth/fido2/register/complete endpoint.";
            _biometricSuccess = true;
        }
    }

    private async Task RevokePushAsync(string? deviceId)
    {
        if (deviceId == null) return;
        _error = null; _success = null; _submitting = true;
        var ok = await Api.RevokePushDeviceAsync(deviceId);
        _submitting = false;
        if (ok) { _success = "Push device revoked."; await LoadMfaDevicesAsync(); }
        else _error = "Failed to revoke push device.";
    }

    private async Task DoChangePasswordAsync()
    {
        _error = null; _success = null;
        if (string.IsNullOrWhiteSpace(_pwCurrent))
        { _error = "Current password is required."; return; }
        if (string.IsNullOrWhiteSpace(_pwNew) || _pwNew.Length < 8)
        { _error = "New password must be at least 8 characters."; return; }
        if (_pwNew != _pwConfirm)
        { _error = "New passwords do not match."; return; }

        _submitting = true;
        var (ok, err) = await Api.ChangePasswordAsync(_pwCurrent, _pwNew);
        _submitting = false;

        if (ok)
        {
            _success = "Password changed successfully.";
            _pwCurrent = _pwNew = _pwConfirm = string.Empty;
            await LoadProfileAsync();
        }
        else
        {
            _error = err ?? "Password change failed.";
        }
    }

    // HOTP Resync (#277)
    private async Task LoadMyHwTokensAsync()
    {
        _loadingHwTokens = true;
        _hwTokens = await Api.GetMyHardwareTokensAsync();
        _loadingHwTokens = false;
    }

    private void OpenResyncModal(HardwareTokenDto t)
    {
        _resyncTarget = t;
        _resyncOtp1 = _resyncOtp2 = string.Empty;
        _resyncError = null;
    }

    private void CloseResyncModal()
    {
        _resyncTarget = null;
        _resyncError = null;
    }

    private async Task SubmitResyncAsync()
    {
        if (_resyncTarget == null) return;
        if (string.IsNullOrWhiteSpace(_resyncOtp1) || string.IsNullOrWhiteSpace(_resyncOtp2))
        { _resyncError = "Both OTP values are required."; return; }

        _resyncSaving = true; _resyncError = null;
        var (ok, err) = await Api.ResyncHardwareTokenAsync(_resyncTarget.Id, _resyncOtp1.Trim(), _resyncOtp2.Trim());
        _resyncSaving = false;

        if (ok)
        {
            _success = "Token resynchronized successfully.";
            CloseResyncModal();
        }
        else
        {
            _resyncError = err ?? "Resync failed.";
        }
    }

    private static string JitStatusClass(string status) => status switch
    {
        "Active"  => "pam-badge-green",
        "Pending" => "pam-badge-yellow",
        "Expired" => "pam-badge-gray",
        "Revoked" => "pam-badge-gray",
        "Denied"  => "pam-badge-red",
        _         => ""
    };

    private static string Truncate(string? s, int max)
    {
        if (s == null) return "";
        return s.Length <= max ? s : s[..max] + "…";
    }
}
