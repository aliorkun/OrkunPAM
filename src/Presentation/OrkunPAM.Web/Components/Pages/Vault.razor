@page "/vault"
@inject PamApiService Api
@inject NavigationManager Nav

<PageTitle>Vault — OrkunPAM</PageTitle>

<div class="pam-page-header">
    <h2 class="pam-page-title">Vault</h2>
    @if (_tab == "credentials")
    {
        <button class="pam-btn pam-btn-primary" @onclick="OpenAddModal">+ Add Credential</button>
    }
    else if (_tab == "rotation-scripts")
    {
        <button class="pam-btn pam-btn-primary" @onclick="OpenNewScriptModal">+ New Script</button>
    }
    else if (_tab == "templates")
    {
        <button class="pam-btn pam-btn-primary" @onclick="OpenNewTemplateModal">+ New Template</button>
    }
</div>

<div class="pam-tabs" style="margin-bottom:1.5rem">
    <button class="pam-tab @(_tab=="credentials"?"pam-tab-active":"")"       @onclick="@(() => SwitchTab("credentials"))">Credentials</button>
    <button class="pam-tab @(_tab=="rotation-scripts"?"pam-tab-active":"")"  @onclick="@(() => SwitchTab("rotation-scripts"))">Rotation Scripts</button>
    <button class="pam-tab @(_tab=="templates"?"pam-tab-active":"")"         @onclick="@(() => SwitchTab("templates"))">Templates</button>
</div>
