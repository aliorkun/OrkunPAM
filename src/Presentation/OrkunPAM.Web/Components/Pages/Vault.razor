@page "/vault"
@inject PamApiService Api
@inject NavigationManager Nav

<PageTitle>Vault — OrkunPAM</PageTitle>

<div class="pam-page-header">
    <h2 class="pam-page-title">Vault</h2>
    <button class="pam-btn pam-btn-primary" @onclick="OpenAddModal">+ Add Credential</button>
</div>

@if (_error != null)
{
    <div class="pam-alert pam-alert-danger">@_error</div>
}

@if (_checkoutBlocked)
{
    <div class="pam-alert" style="background:#fff3cd;border-color:#ffc107;color:#856404;margin-bottom:1rem">
        <strong>Separation of Duties:</strong> Your administrator role does not allow direct password viewing (RFP Vault §26).
        To checkout credentials, another admin must assign you the <code>PasswordViewer</code> role.
    </div>
}

<div class="pam-card pam-vault-layout">
    <!-- Folder Sidebar -->
    <aside class="pam-vault-sidebar">
        <div class="pam-vault-folder-item @(_selectedFolderId == null ? "active" : "")"
             @onclick="() => SelectFolderAsync(null)">
            <span>📁</span>
            <span class="pam-vault-folder-name">All Credentials</span>
            @if (_allTotal > 0)
            {
                <span class="pam-vault-folder-count">@_allTotal</span>
            }
        </div>

        @if (_folders != null)
        {
            @foreach (var root in _folders.Where(f => f.ParentFolderId == null).OrderBy(f => f.Name))
            {
                <div class="pam-vault-folder-item @(_selectedFolderId == root.Id ? "active" : "")"
                     @onclick="() => SelectFolderAsync(root.Id)">
                    <span>📁</span>
                    <span class="pam-vault-folder-name">@root.Name</span>
                    <span class="pam-vault-folder-count">@root.CredentialCount</span>
                </div>
                @foreach (var child in _folders.Where(f => f.ParentFolderId == root.Id).OrderBy(f => f.Name))
                {
                    <div class="pam-vault-folder-item child @(_selectedFolderId == child.Id ? "active" : "")"
                         @onclick="() => SelectFolderAsync(child.Id)">
                        <span>📁</span>
                        <span class="pam-vault-folder-name">@child.Name</span>
                        <span class="pam-vault-folder-count">@child.CredentialCount</span>
                    </div>
                }
            }
        }

        <div style="padding:8px">
            <button class="pam-btn pam-btn-secondary pam-btn-sm" style="width:100%" @onclick="OpenFolderModal">+ New Folder</button>
        </div>
    </aside>

    <!-- Credential Table -->
    <div class="pam-vault-main">
        <div class="pam-vault-search-bar">
            <input class="pam-input pam-search" type="search" placeholder="Search credentials…"
                   @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
            <button class="pam-btn pam-btn-secondary" @onclick="LoadAsync">Search</button>
        </div>

        <div class="pam-card-body p-0">
            @if (_loading)
            {
                <div class="pam-loading-text p-4">Loading credentials…</div>
            }
            else if (_creds == null || _creds.Count == 0)
            {
                <div class="pam-empty p-4">No credentials in this vault location.</div>
            }
            else
            {
                <table class="pam-table pam-table-hover">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Username</th>
                            <th>Type</th>
                            <th>Risk</th>
                            <th>Status</th>
                            <th>Checkout Expires</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in _creds)
                        {
                            var isCheckedOut = c.IsCheckedOut || c.CheckedOutByUserId != null;
                            var isMyCheckout = c.CheckedOutByUserId != null
                                && c.CheckedOutByUserId == _currentUserId;
                            <tr>
                                <td>
                                    <strong>@c.Name</strong>
                                    @if (c.RequiresApproval)
                                    {
                                        <span class="pam-badge pam-badge-secondary" style="margin-left:6px" title="Requires approval">✋</span>
                                    }
                                    @if (!string.IsNullOrEmpty(c.Description))
                                    {
                                        <div class="pam-sub-text">@c.Description</div>
                                    }
                                </td>
                                <td>@(c.Username ?? "—")</td>
                                <td><span class="pam-badge">@c.Type</span></td>
                                <td>
                                    @{
                                        var riskColor = c.RiskLevel switch {
                                            "Critical" => "#6b21a8",
                                            "High"     => "#dc2626",
                                            "Medium"   => "#d97706",
                                            _          => "#16a34a"
                                        };
                                    }
                                    <span class="pam-badge" style="background:@riskColor;color:white;font-size:0.72em"
                                          title="Risk score: @c.RiskScore">@c.RiskLevel</span>
                                </td>
                                <td>
                                    @if (isCheckedOut)
                                    {
                                        <span class="pam-status pam-status-warning">Checked Out</span>
                                    }
                                    else
                                    {
                                        <span class="pam-status @(c.Status == "Active" ? "pam-status-active" : "pam-status-done")">@c.Status</span>
                                    }
                                </td>
                                <td>
                                    @if (isCheckedOut && c.CheckOutExpiresUtc.HasValue)
                                    {
                                        var expired = c.CheckOutExpiresUtc.Value < DateTime.UtcNow;
                                        <span class="@(expired ? "pam-status pam-status-error" : "")">
                                            @c.CheckOutExpiresUtc.Value.ToLocalTime().ToString("MM/dd HH:mm")
                                        </span>
                                    }
                                    else
                                    {
                                        @:—
                                    }
                                </td>
                                <td>
                                    <div class="pam-actions">
                                        @if (!isCheckedOut)
                                        {
                                            @if (_checkoutBlocked)
                                            {
                                                <button class="pam-btn-icon" disabled
                                                        title="Separation of Duties: Admin role cannot view passwords. Ask another admin to assign the 'PasswordViewer' role to you."
                                                        style="opacity:0.4;cursor:not-allowed">↗</button>
                                            }
                                            else
                                            {
                                                @if (c.RequiresApproval)
                                                {
                                                    <button class="pam-btn-icon" title="Request access approval"
                                                            @onclick="@(() => OpenRequestAccess(c.Id, c.Name))">&#x1F4CB;</button>
                                                }
                                                <button class="pam-btn-icon" title="Checkout credential"
                                                        @onclick="@(() => OpenCheckout(c.Id, c.Name))">&#x2197;</button>
                                            }
                                        }
                                        @if (isMyCheckout)
                                        {
                                            <button class="pam-btn-icon" title="Check in"
                                                    @onclick="@(() => CheckinAsync(c.Id))">&#x2199;</button>
                                        }
                                        @if (c.Type == "UserPassword")
                                        {
                                            <button class="pam-btn-icon pam-btn-rotate" title="Rotate password"
                                                    @onclick="@(() => OpenRotateModal(c.Id, c.Name))">&#x21BB;</button>
                                        }
                                        @if (!string.IsNullOrEmpty(c.DeviceId))
                                        {
                                            <button class="pam-btn-icon pam-btn-connect" title="SSH connect"
                                                    @onclick='@(() => Nav.NavigateTo("/connect?deviceId=" + c.DeviceId))'>&#x2328;</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (_meta != null && _meta.TotalCount > _pageSize)
                {
                    <div class="pam-pagination">
                        <button class="pam-btn pam-btn-secondary pam-btn-sm"
                                disabled="@(_page == 1)" @onclick="PrevPage">← Prev</button>
                        <span class="pam-page-info">
                            Page @_page of @TotalPages — @_meta.TotalCount credentials
                        </span>
                        <button class="pam-btn pam-btn-secondary pam-btn-sm"
                                disabled="@(_page >= TotalPages)" @onclick="NextPage">Next →</button>
                    </div>
                }
            }
        </div>
    </div>
</div>

<!-- Checkout Modal -->
@if (_showCheckout)
{
    <div class="pam-modal-overlay" @onclick="() => _showCheckout = false">
        <div class="pam-modal" @onclick:stopPropagation="true">
            <div class="pam-modal-header">
                <h3 class="pam-modal-title">Checkout — @_coCredName</h3>
                <button class="pam-close-btn" @onclick="() => _showCheckout = false">×</button>
            </div>
            <div class="pam-modal-body">
                @if (_coError != null)
                {
                    <div class="pam-alert pam-alert-danger">@_coError</div>
                }
                <div class="pam-form-group">
                    <label class="pam-label">Reason</label>
                    <input class="pam-input w-100-input" @bind="_coReason"
                           placeholder="e.g. Planned maintenance — INC-1234" />
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Ticket Number</label>
                    <input class="pam-input w-100-input" @bind="_coTicket"
                           placeholder="e.g. INC-1234 or CHG-5678" />
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Duration (minutes)</label>
                    <input class="pam-input" style="width:120px" type="number"
                           min="1" max="1440" @bind="_coDuration" />
                </div>
            </div>
            <div class="pam-modal-footer">
                <button class="pam-btn pam-btn-secondary" @onclick="() => _showCheckout = false">Cancel</button>
                <button class="pam-btn pam-btn-primary" @onclick="SubmitCheckoutAsync" disabled="@_coSaving">
                    @if (_coSaving) { <span class="pam-spinner-sm"></span> }
                    Checkout
                </button>
            </div>
        </div>
    </div>
}

<!-- Request Access Modal -->
@if (_showRequestAccess)
{
    <div class="pam-modal-overlay" @onclick="() => _showRequestAccess = false">
        <div class="pam-modal" @onclick:stopPropagation="true">
            <div class="pam-modal-header">
                <h3 class="pam-modal-title">Request Access — @_raCredName</h3>
                <button class="pam-close-btn" @onclick="() => _showRequestAccess = false">×</button>
            </div>
            <div class="pam-modal-body">
                @if (_raError != null)
                {
                    <div class="pam-alert pam-alert-danger">@_raError</div>
                }
                @if (_raSuccess != null)
                {
                    <div class="pam-alert pam-alert-success">@_raSuccess</div>
                }
                @if (_raSuccess == null)
                {
                    <div class="pam-alert pam-alert-warning" style="margin-bottom:12px">
                        This credential requires approval before checkout. Submit a request and an administrator will grant access.
                    </div>
                    <div class="pam-form-group">
                        <label class="pam-label">Reason <span style="color:var(--pam-danger)">*</span></label>
                        <input class="pam-input w-100-input" @bind="_raReason"
                               placeholder="e.g. Planned maintenance — INC-1234" />
                    </div>
                    <div class="pam-form-group">
                        <label class="pam-label">Ticket Number</label>
                        <input class="pam-input w-100-input" @bind="_raTicket"
                               placeholder="e.g. INC-1234 or CHG-5678" />
                    </div>
                }
            </div>
            <div class="pam-modal-footer">
                <button class="pam-btn pam-btn-secondary" @onclick="() => _showRequestAccess = false">Close</button>
                @if (_raSuccess == null)
                {
                    <button class="pam-btn pam-btn-primary" @onclick="SubmitRequestAccessAsync" disabled="@_raSaving">
                        @if (_raSaving) { <span class="pam-spinner-sm"></span> }
                        Submit Request
                    </button>
                }
            </div>
        </div>
    </div>
}

<!-- Password Reveal Modal -->
@if (_showReveal)
{
    <div class="pam-modal-overlay" @onclick="CloseReveal">
        <div class="pam-modal" @onclick:stopPropagation="true">
            <div class="pam-modal-header">
                <h3 class="pam-modal-title">Credential Revealed — @_revealName</h3>
                <button class="pam-close-btn" @onclick="CloseReveal">×</button>
            </div>
            <div class="pam-modal-body">
                <div class="pam-alert pam-alert-warning">
                    Copy this credential now. It will be cleared when you close this dialog.
                </div>
                @if (_revealUser != null)
                {
                    <div class="pam-form-group">
                        <label class="pam-label">Username</label>
                        <div class="pam-reveal-field">@_revealUser</div>
                    </div>
                }
                @if (_revealPrivKey != null)
                {
                    <div class="pam-form-group">
                        <label class="pam-label">Private Key (PEM)</label>
                        <textarea class="pam-input w-100-input" rows="8" readonly
                                  style="font-size:0.75em;font-family:monospace">@(new string(_revealPrivKey))</textarea>
                    </div>
                }
                else
                {
                    <div class="pam-form-group">
                        <label class="pam-label">Password</label>
                        <div class="pam-reveal-box">
                            @if (_passVisible)
                            {
                                <div class="pam-reveal-password">@(_revealPass != null ? new string(_revealPass) : "")</div>
                            }
                            else
                            {
                                <div class="pam-reveal-password pam-reveal-masked">••••••••••••••••</div>
                            }
                            <button class="pam-btn pam-btn-secondary pam-btn-sm" style="align-self:flex-start"
                                    @onclick="() => _passVisible = !_passVisible">
                                @(_passVisible ? "Hide" : "Reveal")
                            </button>
                        </div>
                    </div>
                }
                @if (_revealExpiry.HasValue)
                {
                    <div class="pam-form-group">
                        <label class="pam-label">Checkout expires</label>
                        <div>@_revealExpiry.Value.ToString("MM/dd/yyyy HH:mm")</div>
                    </div>
                }
            </div>
            <div class="pam-modal-footer">
                <button class="pam-btn pam-btn-primary" @onclick="CloseReveal">Done</button>
            </div>
        </div>
    </div>
}

<!-- Add Credential Modal -->
@if (_showAdd)
{
    <div class="pam-modal-overlay" @onclick="() => _showAdd = false">
        <div class="pam-modal" @onclick:stopPropagation="true">
            <div class="pam-modal-header">
                <h3 class="pam-modal-title">Add Credential</h3>
                <button class="pam-close-btn" @onclick="() => _showAdd = false">×</button>
            </div>
            <div class="pam-modal-body">
                @if (_addError != null)
                {
                    <div class="pam-alert pam-alert-danger">@_addError</div>
                }
                <div class="pam-form-group">
                    <label class="pam-label">Name *</label>
                    <input class="pam-input w-100-input" @bind="_addName" placeholder="e.g. prod-server root" />
                </div>
                <div class="pam-form-row">
                    <div class="pam-form-group" style="flex:1">
                        <label class="pam-label">Type *</label>
                        <select class="pam-input" style="width:100%" @bind="_addType">
                            <option value="0">User Password</option>
                            <option value="1">SSH Key</option>
                            <option value="2">API Key</option>
                            <option value="3">Certificate</option>
                            <option value="4">Connection String</option>
                            <option value="5">Custom</option>
                        </select>
                    </div>
                    <div class="pam-form-group" style="flex:1">
                        <label class="pam-label">Folder *</label>
                        <select class="pam-input" style="width:100%" @bind="_addFolderId">
                            @if (_folders != null)
                            {
                                @foreach (var f in _folders.OrderBy(f => f.Name))
                                {
                                    <option value="@f.Id">@f.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Username</label>
                    <input class="pam-input w-100-input" @bind="_addUsername" placeholder="e.g. root, admin, sa" />
                </div>
                @if (_addType != 1)
                {
                    <div class="pam-form-group">
                        <label class="pam-label">Password</label>
                        <input class="pam-input w-100-input" type="password" @bind="_addPassword" />
                    </div>
                }
                @if (_addType == 1)
                {
                    <div class="pam-form-group">
                        <label class="pam-label">Private Key (PEM)</label>
                        <textarea class="pam-input w-100-input" rows="6" @bind="_addPrivateKey"
                                  style="font-size:0.75em;font-family:monospace"
                                  placeholder="Paste RSA private key PEM, or click Generate below"></textarea>
                    </div>
                    <div class="pam-form-group">
                        <button class="pam-btn pam-btn-secondary pam-btn-sm" type="button"
                                @onclick="GenerateKeyPairAsync" disabled="@_genSaving">
                            @if (_genSaving) { <span class="pam-spinner-sm"></span> }
                            Generate RSA 4096 Key Pair
                        </button>
                    </div>
                    @if (_genPubKey != null)
                    {
                        <div class="pam-form-group">
                            <label class="pam-label" style="color:#059669">Public Key — copy to ~/.ssh/authorized_keys on target</label>
                            <textarea class="pam-input w-100-input" rows="3" readonly
                                      style="font-size:0.75em;font-family:monospace">@_genPubKey</textarea>
                        </div>
                    }
                }
                <div class="pam-form-group">
                    <label class="pam-label">Description</label>
                    <input class="pam-input w-100-input" @bind="_addDesc" placeholder="Optional description" />
                </div>
                <div class="pam-form-row">
                    <div class="pam-form-group" style="flex:1">
                        <label class="pam-label">Max Checkout (min)</label>
                        <input class="pam-input" style="width:100%" type="number" min="1" @bind="_addMaxMins" />
                    </div>
                    <div class="pam-form-group" style="flex:1; justify-content:flex-end; margin-top:28px">
                        <label style="display:flex; align-items:center; gap:8px; cursor:pointer; font-size:13px">
                            <input type="checkbox" @bind="_addApproval" /> Requires Approval
                        </label>
                    </div>
                </div>
            </div>
            <div class="pam-modal-footer">
                <button class="pam-btn pam-btn-secondary" @onclick="() => _showAdd = false">Cancel</button>
                <button class="pam-btn pam-btn-primary" @onclick="SubmitAddAsync" disabled="@_addSaving">
                    @if (_addSaving) { <span class="pam-spinner-sm"></span> }
                    Add Credential
                </button>
            </div>
        </div>
    </div>
}

<!-- Rotate Password Modal -->
@if (_showRotate)
{
    <div class="pam-modal-overlay" @onclick="@(() => _showRotate = false)">
        <div class="pam-modal" @onclick:stopPropagation="true">
            <div class="pam-modal-header">
                <h3 class="pam-modal-title">Rotate Password — @_rotCredName</h3>
                <button class="pam-close-btn" @onclick="@(() => _showRotate = false)">×</button>
            </div>
            <div class="pam-modal-body">
                @if (_rotError != null)
                {
                    <div class="pam-alert pam-alert-danger">@_rotError</div>
                }
                @if (_rotSuccess != null)
                {
                    <div class="pam-alert pam-alert-success">@_rotSuccess</div>
                }
                <div class="pam-alert pam-alert-warning">
                    A new random password will be generated and pushed to the target system.
                    The vault will be updated automatically on success.
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Connector *</label>
                    <select class="pam-input" style="width:100%" @bind="_rotConnector">
                        <option value="Ssh">SSH (Linux/Unix)</option>
                        <option value="WinRm">WinRM (Windows Local Admin)</option>
                        <option value="Ldap">LDAP / Active Directory</option>
                        <option value="SqlServer">SQL Server</option>
                        <option value="MySql">MySQL</option>
                        <option value="PostgreSql">PostgreSQL</option>
                    </select>
                </div>
                <div class="pam-form-row">
                    <div class="pam-form-group" style="flex:2">
                        <label class="pam-label">Host (leave blank to use device)</label>
                        <input class="pam-input" style="width:100%" @bind="_rotHost"
                               placeholder="192.168.1.10 or server.domain.com" />
                    </div>
                    <div class="pam-form-group" style="flex:1">
                        <label class="pam-label">Port</label>
                        <input class="pam-input" style="width:100%" type="number"
                               min="1" max="65535" @bind="_rotPort" placeholder="default" />
                    </div>
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Domain (for LDAP/AD only)</label>
                    <input class="pam-input" style="width:100%" @bind="_rotDomain"
                           placeholder="e.g. corp.example.com" />
                </div>
            </div>
            <div class="pam-modal-footer">
                <button class="pam-btn pam-btn-secondary" @onclick="@(() => _showRotate = false)">Cancel</button>
                <button class="pam-btn pam-btn-warning" @onclick="SubmitRotateAsync" disabled="@_rotSaving">
                    @if (_rotSaving) { <span class="pam-spinner-sm"></span> }
                    Rotate Password
                </button>
            </div>
        </div>
    </div>
}

<!-- Create Folder Modal -->
@if (_showFolderModal)
{
    <div class="pam-modal-overlay" @onclick="@(() => _showFolderModal = false)">
        <div class="pam-modal" @onclick:stopPropagation="true">
            <div class="pam-modal-header">
                <h3 class="pam-modal-title">Create Folder</h3>
                <button class="pam-close-btn" @onclick="@(() => _showFolderModal = false)">×</button>
            </div>
            <div class="pam-modal-body">
                @if (_folderError != null)
                {
                    <div class="pam-alert pam-alert-danger">@_folderError</div>
                }
                <div class="pam-form-group">
                    <label class="pam-label">Folder Name *</label>
                    <input class="pam-input w-100-input" @bind="_folderName" placeholder="e.g. Production Servers" />
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Description</label>
                    <input class="pam-input w-100-input" @bind="_folderDesc" placeholder="Optional" />
                </div>
            </div>
            <div class="pam-modal-footer">
                <button class="pam-btn pam-btn-secondary" @onclick="@(() => _showFolderModal = false)">Cancel</button>
                <button class="pam-btn pam-btn-primary" @onclick="SubmitFolderAsync" disabled="@_folderSaving">
                    @if (_folderSaving) { <span class="pam-spinner-sm"></span> }
                    Create Folder
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<CredentialDto>? _creds;
    private List<FolderDto>?     _folders;
    private PageMeta?            _meta;
    private bool                 _loading  = true;
    private string?              _error;
    private string               _search   = "";
    private string?              _selectedFolderId;
    private string?              _currentUserId;
    private int                  _allTotal;
    private int                  _page     = 1;
    private const int            _pageSize = 20;
    // SoD (RFP Vault #26): admin without PasswordViewer cannot checkout passwords
    private bool                 _checkoutBlocked;

    // Create Folder modal
    private bool    _showFolderModal;
    private string  _folderName  = "";
    private string  _folderDesc  = "";
    private bool    _folderSaving;
    private string? _folderError;

    // Checkout modal
    private bool    _showCheckout;
    private string? _coCredId;
    private string? _coCredName;
    private string  _coReason   = "";
    private string  _coTicket   = "";
    private int     _coDuration = 60;
    private bool    _coSaving;
    private string? _coError;

    // Request Access modal
    private bool    _showRequestAccess;
    private string? _raCredId;
    private string? _raCredName;
    private string  _raReason  = "";
    private string  _raTicket  = "";
    private bool    _raSaving;
    private string? _raError;
    private string? _raSuccess;

    // Password reveal modal
    private bool      _showReveal;
    private string?   _revealName;
    private string?   _revealUser;
    private char[]?   _revealPass;
    private char[]?   _revealPrivKey;
    private DateTime? _revealExpiry;
    private bool      _passVisible;

    // Add Credential modal
    private bool    _showAdd;
    private string  _addName       = "";
    private int     _addType       = 0;
    private string  _addFolderId   = "";
    private string  _addUsername   = "";
    private string  _addPassword   = "";
    private string  _addPrivateKey = "";
    private string  _addDesc       = "";
    private int     _addMaxMins    = 60;
    private bool    _addApproval;
    private bool    _addSaving;
    private string? _addError;
    private string? _genPubKey;
    private bool    _genSaving;

    // Rotate Password modal
    private bool    _showRotate;
    private string? _rotCredId;
    private string? _rotCredName;
    private string  _rotConnector = "Ssh";
    private string  _rotHost      = "";
    private int?    _rotPort;
    private string  _rotDomain    = "";
    private bool    _rotSaving;
    private string? _rotError;
    private string? _rotSuccess;

    private int TotalPages => _meta == null ? 1 : (int)Math.Ceiling(_meta.TotalCount / (double)_pageSize);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var user = await Api.GetCurrentUserAsync();
        _currentUserId = user?.UserId;
        if (user != null)
        {
            var isAdmin = user.Roles.Contains("GlobalAdmin") || user.Roles.Contains("VaultAdmin");
            var hasPasswordViewer = user.Roles.Contains("PasswordViewer");
            _checkoutBlocked = isAdmin && !hasPasswordViewer;
        }
        await Task.WhenAll(LoadFoldersAsync(), LoadAsync());
    }

    private async Task LoadFoldersAsync()
    {
        _folders = await Api.GetFoldersAsync();
        if (_folders != null && string.IsNullOrEmpty(_addFolderId))
            _addFolderId = _folders.FirstOrDefault()?.Id ?? "";
        StateHasChanged();
    }

    private void OpenFolderModal()
    {
        _folderName = ""; _folderDesc = "";
        _folderError = null; _folderSaving = false;
        _showFolderModal = true;
    }

    private async Task SubmitFolderAsync()
    {
        if (string.IsNullOrWhiteSpace(_folderName))
        {
            _folderError = "Folder name is required.";
            return;
        }
        _folderSaving = true; _folderError = null; StateHasChanged();

        var ok = await Api.CreateFolderAsync(_folderName.Trim(), _folderDesc.Trim());
        _folderSaving = false;
        if (!ok)
        {
            _folderError = "Failed to create folder.";
            StateHasChanged();
            return;
        }
        _showFolderModal = false;
        await LoadFoldersAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _error = null; StateHasChanged();

        if (_selectedFolderId != null)
        {
            var list = await Api.GetFolderCredentialsAsync(_selectedFolderId);
            if (list == null) _error = "Failed to load credentials.";
            else              { _creds = list; _meta = null; }
        }
        else
        {
            var result = await Api.GetCredentialsAsync(search: _search, page: _page, pageSize: _pageSize);
            if (result == null) _error = "Failed to load credentials.";
            else
            {
                _creds    = result.Data;
                _meta     = result.Meta;
                _allTotal = result.Meta?.TotalCount ?? 0;
            }
        }

        _loading = false; StateHasChanged();
    }

    private async Task SelectFolderAsync(string? folderId)
    {
        _selectedFolderId = folderId;
        _page = 1; _search = "";
        await LoadAsync();
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { _page = 1; await LoadAsync(); }
    }

    private void OpenCheckout(string credId, string credName)
    {
        _coCredId = credId; _coCredName = credName;
        _coReason = ""; _coTicket = ""; _coDuration = 60;
        _coError = null; _coSaving = false;
        _showCheckout = true;
    }

    private async Task SubmitCheckoutAsync()
    {
        _coError = null; _coSaving = true; StateHasChanged();

        var result = await Api.CheckoutCredentialAsync(
            _coCredId!,
            string.IsNullOrWhiteSpace(_coReason) ? null : _coReason.Trim(),
            string.IsNullOrWhiteSpace(_coTicket) ? null : _coTicket.Trim(),
            _coDuration);

        _coSaving = false;

        if (result == null)
        {
            _coError = "Checkout failed. The credential may already be checked out or require approval.";
            StateHasChanged();
            return;
        }

        _showCheckout  = false;
        _revealName    = result.Name;
        _revealUser    = result.Username;
        _revealPass    = result.Password?.ToCharArray();
        _revealPrivKey = result.PrivateKey?.ToCharArray();
        _revealExpiry  = result.ExpiresAt?.ToLocalTime();
        _passVisible   = false;
        _showReveal    = true;

        await LoadAsync();
    }

    private void OpenRequestAccess(string credId, string credName)
    {
        _raCredId = credId; _raCredName = credName;
        _raReason = ""; _raTicket = "";
        _raError = null; _raSuccess = null; _raSaving = false;
        _showRequestAccess = true;
    }

    private async Task SubmitRequestAccessAsync()
    {
        if (string.IsNullOrWhiteSpace(_raReason))
        {
            _raError = "Reason is required.";
            return;
        }
        _raError = null; _raSaving = true; StateHasChanged();

        var result = await Api.RequestCredentialAccessAsync(
            _raCredId!,
            _raReason.Trim(),
            string.IsNullOrWhiteSpace(_raTicket) ? null : _raTicket.Trim());

        _raSaving = false;

        if (result == null || !result.Success)
        {
            _raError = result?.Message ?? "Failed to submit request. Please try again.";
            StateHasChanged();
            return;
        }

        _raSuccess = result.Status == "Approved"
            ? "Access already approved — you can checkout this credential now."
            : result.Message ?? "Access request submitted. An administrator will review it. Check the Approvals page for status.";
        StateHasChanged();
    }

    private void CloseReveal()
    {
        if (_revealPass != null)
        {
            System.Runtime.InteropServices.MemoryMarshal.AsBytes(_revealPass.AsSpan()).Clear();
            _revealPass = null;
        }
        if (_revealPrivKey != null)
        {
            System.Runtime.InteropServices.MemoryMarshal.AsBytes(_revealPrivKey.AsSpan()).Clear();
            _revealPrivKey = null;
        }
        _showReveal  = false;
        _passVisible = false;
    }

    private async Task CheckinAsync(string credId)
    {
        var ok = await Api.CheckinCredentialAsync(credId);
        if (!ok) _error = "Checkin failed — you may not own this checkout.";
        await LoadAsync();
    }

    private void OpenAddModal()
    {
        _addName = ""; _addUsername = ""; _addPassword = ""; _addDesc = "";
        _addType = 0; _addMaxMins = 60; _addApproval = false;
        _addPrivateKey = ""; _genPubKey = null; _genSaving = false;
        _addFolderId = _selectedFolderId ?? _folders?.FirstOrDefault()?.Id ?? "";
        _addError = null; _addSaving = false;
        _showAdd = true;
    }

    private async Task SubmitAddAsync()
    {
        _addError = null;
        if (string.IsNullOrWhiteSpace(_addName))     { _addError = "Name is required."; return; }
        if (string.IsNullOrWhiteSpace(_addFolderId)) { _addError = "Folder is required. Create a folder first."; return; }

        _addSaving = true; StateHasChanged();

        var ok = await Api.CreateCredentialAsync(
            _addName.Trim(), _addType,
            string.IsNullOrWhiteSpace(_addUsername) ? null : _addUsername.Trim(),
            string.IsNullOrWhiteSpace(_addPassword) ? null : _addPassword,
            _addFolderId,
            null,
            string.IsNullOrWhiteSpace(_addDesc) ? null : _addDesc.Trim(),
            _addMaxMins, _addApproval,
            string.IsNullOrWhiteSpace(_addPrivateKey) ? null : _addPrivateKey.Trim());

        _addSaving = false;

        if (!ok)
        {
            _addError = "Failed to create credential.";
            StateHasChanged();
            return;
        }

        _showAdd = false;
        await Task.WhenAll(LoadFoldersAsync(), LoadAsync());
    }

    private async Task GenerateKeyPairAsync()
    {
        _genSaving = true; _genPubKey = null; StateHasChanged();
        var kp = await Api.GenerateSshKeyPairAsync();
        _genSaving = false;
        if (kp != null)
        {
            _addPrivateKey = kp.PrivateKey;
            _genPubKey     = kp.PublicKey;
        }
        StateHasChanged();
    }

    private void OpenRotateModal(string credId, string credName)
    {
        _rotCredId = credId; _rotCredName = credName;
        _rotConnector = "Ssh"; _rotHost = ""; _rotPort = null; _rotDomain = "";
        _rotError = null; _rotSuccess = null; _rotSaving = false;
        _showRotate = true;
    }

    private async Task SubmitRotateAsync()
    {
        _rotError = null; _rotSuccess = null; _rotSaving = true; StateHasChanged();

        var ok = await Api.RotateCredentialAsync(
            _rotCredId!,
            _rotConnector,
            string.IsNullOrWhiteSpace(_rotHost) ? null : _rotHost.Trim(),
            _rotPort,
            string.IsNullOrWhiteSpace(_rotDomain) ? null : _rotDomain.Trim());

        _rotSaving = false;

        if (ok)
        {
            _rotSuccess = "Password rotated successfully. The vault has been updated.";
            await LoadAsync();
        }
        else
        {
            _rotError = "Rotation failed. Ensure the connector settings match the target system and that the current password is correct.";
        }

        StateHasChanged();
    }

    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }
}
