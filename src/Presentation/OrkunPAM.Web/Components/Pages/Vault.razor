@page "/vault"
@rendermode InteractiveServer
@inject PamApiService Api
@inject NavigationManager Nav

<PageTitle>Vault — OrkunPAM</PageTitle>

<div class="pam-page-header">
    <h2 class="pam-page-title">Vault</h2>
    <button class="pam-btn pam-btn-primary" @onclick="OpenAddModal">+ Add Credential</button>
</div>

<div class="pam-filters">
    <input class="pam-input pam-search" type="search" placeholder="Search credentials…"
           @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
    <button class="pam-btn pam-btn-secondary" @onclick="LoadAsync">Search</button>
</div>

@if (_error != null)
{
    <div class="pam-alert pam-alert-danger">@_error</div>
}

<div class="pam-card">
    <div class="pam-card-body p-0">
        @if (_loading)
        {
            <div class="pam-loading-text p-4">Loading credentials…</div>
        }
        else if (_creds == null || _creds.Count == 0)
        {
            <div class="pam-empty p-4">No credentials in vault.</div>
        }
        else
        {
            <table class="pam-table pam-table-hover">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Username</th>
                        <th>Type</th>
                        <th>Status</th>
                        <th>Last Rotated</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in _creds)
                    {
                        <tr>
                            <td>
                                <strong>@c.Name</strong>
                                @if (!string.IsNullOrEmpty(c.Description))
                                {
                                    <div class="pam-sub-text">@c.Description</div>
                                }
                            </td>
                            <td>@(c.Username ?? "—")</td>
                            <td><span class="pam-badge">@c.Type</span></td>
                            <td>
                                @if (c.IsCheckedOut)
                                {
                                    <span class="pam-status pam-status-warn">Checked Out</span>
                                }
                                else
                                {
                                    <span class="pam-status @(c.Status == "Active" ? "pam-status-active" : "pam-status-done")">@c.Status</span>
                                }
                            </td>
                            <td>@(c.LastRotatedAtUtc?.ToLocalTime().ToString("MM/dd/yy HH:mm") ?? "Never")</td>
                            <td>
                                <div class="pam-actions">
                                    @if (!c.IsCheckedOut)
                                    {
                                        <button class="pam-btn-icon" title="Checkout credential"
                                                @onclick="@(() => OpenCheckoutModal(c))">&#128275;</button>
                                    }
                                    else
                                    {
                                        <button class="pam-btn-icon pam-btn-warn" title="Check in"
                                                @onclick="@(() => CheckinAsync(c.Id))">&#128274;</button>
                                    }
                                    @if (c.Type == "UserPassword" || c.Type == "SshKey")
                                    {
                                        <button class="pam-btn-icon pam-btn-connect" title="SSH connect"
                                                @onclick="@(() => ConnectSsh(c.DeviceId, c.Id))">&#9000;</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (_meta != null && _meta.TotalCount > _pageSize)
            {
                <div class="pam-pagination">
                    <button class="pam-btn pam-btn-secondary pam-btn-sm"
                            disabled="@(_page == 1)" @onclick="PrevPage">← Prev</button>
                    <span class="pam-page-info">Page @_page of @TotalPages — @_meta.TotalCount credentials</span>
                    <button class="pam-btn pam-btn-secondary pam-btn-sm"
                            disabled="@(_page >= TotalPages)" @onclick="NextPage">Next →</button>
                </div>
            }
        }
    </div>
</div>

<!-- Add Credential Modal -->
@if (_showAdd)
{
    <div class="pam-modal-overlay" @onclick="CloseAddModal">
        <div class="pam-modal" @onclick:stopPropagation="true">
            <div class="pam-modal-header">
                <h3 class="pam-modal-title">Add Credential</h3>
                <button class="pam-close-btn" @onclick="CloseAddModal">&#215;</button>
            </div>
            <div class="pam-modal-body">
                @if (_addError != null)
                {
                    <div class="pam-alert pam-alert-danger">@_addError</div>
                }
                <div class="pam-form-group">
                    <label class="pam-label">Name *</label>
                    <input class="pam-input w-100-input" @bind="_fName" placeholder="e.g. root@web-server-01" />
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Type *</label>
                    <select class="pam-input w-100-input" @bind="_fType">
                        <option value="0">Password</option>
                        <option value="1">SSH Key</option>
                        <option value="2">API Key</option>
                        <option value="3">Certificate</option>
                        <option value="4">Connection String</option>
                        <option value="5">Custom</option>
                    </select>
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Username</label>
                    <input class="pam-input w-100-input" @bind="_fUsername" placeholder="e.g. root, administrator" />
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Password / Secret</label>
                    <input class="pam-input w-100-input" type="password" @bind="_fPassword" />
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Folder *</label>
                    @if (_folders == null || _folders.Count == 0)
                    {
                        <div class="pam-alert pam-alert-info">
                            No folders found. <button class="pam-link-btn" @onclick="CreateDefaultFolderAsync">Create default folder</button>
                        </div>
                    }
                    else
                    {
                        <select class="pam-input w-100-input" @bind="_fFolderId">
                            <option value="">— Select folder —</option>
                            @foreach (var f in _folders)
                            {
                                <option value="@f.Id">@f.Name (@f.CredentialCount credentials)</option>
                            }
                        </select>
                    }
                </div>
                <div class="pam-form-group">
                    <label class="pam-label">Description</label>
                    <input class="pam-input w-100-input" @bind="_fDescription" placeholder="Optional description" />
                </div>
            </div>
            <div class="pam-modal-footer">
                <button class="pam-btn pam-btn-secondary" @onclick="CloseAddModal">Cancel</button>
                <button class="pam-btn pam-btn-primary" @onclick="SubmitAddCredentialAsync" disabled="@_addSaving">
                    @if (_addSaving) { <span class="pam-spinner-sm"></span> }
                    Add Credential
                </button>
            </div>
        </div>
    </div>
}

<!-- Checkout Modal -->
@if (_showCheckout)
{
    <div class="pam-modal-overlay" @onclick="CloseCheckoutModal">
        <div class="pam-modal" @onclick:stopPropagation="true">
            <div class="pam-modal-header">
                <h3 class="pam-modal-title">Checkout: @(_checkoutCred?.Name)</h3>
                <button class="pam-close-btn" @onclick="CloseCheckoutModal">&#215;</button>
            </div>
            <div class="pam-modal-body">
                @if (_checkoutError != null)
                {
                    <div class="pam-alert pam-alert-danger">@_checkoutError</div>
                }
                @if (_checkoutPassword == null)
                {
                    <div class="pam-form-group">
                        <label class="pam-label">Reason (optional)</label>
                        <input class="pam-input w-100-input" @bind="_checkoutReason"
                               placeholder="e.g. Maintenance ticket #1234" />
                    </div>
                    <p class="pam-hint">The credential will be checked out to you. Check it back in when done.</p>
                }
                else
                {
                    <div class="pam-alert pam-alert-success">Credential checked out successfully.</div>
                    <div class="pam-form-group">
                        <label class="pam-label">Username</label>
                        <div class="pam-copy-row">
                            <input class="pam-input pam-monospace" readonly value="@(_checkoutCred?.Username ?? "—")" />
                        </div>
                    </div>
                    <div class="pam-form-group">
                        <label class="pam-label">Password</label>
                        <div class="pam-copy-row">
                            <input class="pam-input pam-monospace" id="checkout-pw"
                                   readonly type="@(_showPw ? "text" : "password")"
                                   value="@_checkoutPassword" />
                            <button class="pam-btn pam-btn-secondary pam-btn-sm" @onclick="ToggleShowPw">
                                @(_showPw ? "Hide" : "Show")
                            </button>
                        </div>
                    </div>
                    <p class="pam-hint pam-hint-warn">&#9888; Close this dialog when done. Password is not stored in browser.</p>
                }
            </div>
            <div class="pam-modal-footer">
                @if (_checkoutPassword == null)
                {
                    <button class="pam-btn pam-btn-secondary" @onclick="CloseCheckoutModal">Cancel</button>
                    <button class="pam-btn pam-btn-primary" @onclick="SubmitCheckoutAsync" disabled="@_checkoutSaving">
                        @if (_checkoutSaving) { <span class="pam-spinner-sm"></span> }
                        Checkout
                    </button>
                }
                else
                {
                    <button class="pam-btn pam-btn-primary" @onclick="CloseCheckoutModal">Done</button>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<CredentialDto>? _creds;
    private PageMeta?            _meta;
    private bool                 _loading  = true;
    private string?              _error;
    private string               _search   = "";
    private int                  _page     = 1;
    private const int            _pageSize = 20;

    private int TotalPages => _meta == null ? 1 : (int)Math.Ceiling(_meta.TotalCount / (double)_pageSize);

    // Add credential modal
    private bool            _showAdd;
    private string?         _addError;
    private bool            _addSaving;
    private string          _fName        = "";
    private string          _fType        = "0";
    private string          _fUsername    = "";
    private string          _fPassword    = "";
    private string          _fFolderId    = "";
    private string          _fDescription = "";
    private List<FolderDto>? _folders;

    // Checkout modal
    private bool          _showCheckout;
    private CredentialDto? _checkoutCred;
    private string        _checkoutReason   = "";
    private string?       _checkoutPassword;
    private string?       _checkoutError;
    private bool          _checkoutSaving;
    private bool          _showPw;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true; _error = null; StateHasChanged();
        var result = await Api.GetCredentialsAsync(search: _search, page: _page, pageSize: _pageSize);
        if (result == null) _error = "Failed to load vault credentials.";
        else { _creds = result.Data; _meta = result.Meta; }
        _loading = false; StateHasChanged();
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { _page = 1; await LoadAsync(); }
    }

    private void ConnectSsh(string? deviceId, string credId)
    {
        if (!string.IsNullOrEmpty(deviceId))
            Nav.NavigateTo($"/terminal/{deviceId}/{credId}");
    }

    private async Task OpenAddModal()
    {
        _fName = _fUsername = _fPassword = _fFolderId = _fDescription = "";
        _fType = "0";
        _addError = null;
        _folders = (await Api.GetFoldersAsync())?.Data ?? [];
        _showAdd = true;
    }

    private void CloseAddModal() { _showAdd = false; _addError = null; }

    private async Task CreateDefaultFolderAsync()
    {
        await Api.CreateFolderAsync("General", "Default credential folder");
        _folders = (await Api.GetFoldersAsync())?.Data ?? [];
        StateHasChanged();
    }

    private async Task SubmitAddCredentialAsync()
    {
        _addError = null;
        if (string.IsNullOrWhiteSpace(_fName))     { _addError = "Name is required."; return; }
        if (string.IsNullOrWhiteSpace(_fFolderId)) { _addError = "Select a folder."; return; }
        if (!int.TryParse(_fType, out var typeInt)) { _addError = "Invalid type."; return; }

        _addSaving = true;
        StateHasChanged();

        var ok = await Api.CreateCredentialAsync(
            _fFolderId, _fName.Trim(),
            string.IsNullOrWhiteSpace(_fDescription) ? null : _fDescription.Trim(),
            typeInt,
            string.IsNullOrWhiteSpace(_fUsername) ? null : _fUsername.Trim(),
            string.IsNullOrWhiteSpace(_fPassword) ? null : _fPassword,
            null);

        _addSaving = false;

        if (!ok)
        {
            _addError = "Failed to create credential. Check server logs.";
            StateHasChanged();
            return;
        }

        CloseAddModal();
        _page = 1;
        await LoadAsync();
    }

    private void OpenCheckoutModal(CredentialDto cred)
    {
        _checkoutCred     = cred;
        _checkoutReason   = "";
        _checkoutPassword = null;
        _checkoutError    = null;
        _showPw           = false;
        _showCheckout     = true;
    }

    private void CloseCheckoutModal()
    {
        _showCheckout     = false;
        _checkoutPassword = null;
        _checkoutCred     = null;
    }

    private async Task SubmitCheckoutAsync()
    {
        if (_checkoutCred == null) return;
        _checkoutError  = null;
        _checkoutSaving = true;
        StateHasChanged();

        var result = await Api.CheckoutCredentialAsync(
            _checkoutCred.Id,
            string.IsNullOrWhiteSpace(_checkoutReason) ? null : _checkoutReason.Trim());

        _checkoutSaving = false;

        if (result == null)
        {
            _checkoutError = "Checkout failed. Credential may already be checked out or requires approval.";
            StateHasChanged();
            return;
        }

        _checkoutPassword = result.Password ?? "(no password stored)";
        await LoadAsync();
    }

    private async Task CheckinAsync(string credId)
    {
        await Api.CheckinCredentialAsync(credId);
        await LoadAsync();
    }

    private void ToggleShowPw() => _showPw = !_showPw;

    private async Task PrevPage() { _page--; await LoadAsync(); }
    private async Task NextPage() { _page++; await LoadAsync(); }
}
