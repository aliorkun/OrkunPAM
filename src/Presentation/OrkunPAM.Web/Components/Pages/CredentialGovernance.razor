@page "/vault/governance"
@inject PamApiService Api
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Credential Governance — OrkunPAM</PageTitle>

<div class="pam-page-header">
    <h2 class="pam-page-title">Credential Governance</h2>
    <button class="pam-btn pam-btn-secondary" @onclick="ExportCsvAsync">&#x2B07; Export CSV</button>
</div>

@if (_error != null)
{
    <div class="pam-alert pam-alert-danger">@_error</div>
}

@* ── Summary Cards ────────────────────────────────────────────────────── *@
@if (_summary != null)
{
    <div class="pam-stats-grid" style="grid-template-columns:repeat(4,1fr);margin-bottom:1.5rem">
        <div class="pam-stat-card">
            <div class="pam-stat-value">@_summary.TotalCredentials</div>
            <div class="pam-stat-label">Total Credentials</div>
        </div>
        <div class="pam-stat-card">
            <div class="pam-stat-value" style="color:@(_summary.ExpiredCredentials > 0 ? "#dc2626" : "inherit")">@_summary.ExpiredCredentials</div>
            <div class="pam-stat-label">Expired</div>
        </div>
        <div class="pam-stat-card">
            <div class="pam-stat-value" style="color:@(_summary.ExpiringIn7Days > 0 ? "#f59e0b" : "inherit")">@_summary.ExpiringIn7Days</div>
            <div class="pam-stat-label">Expiring in 7 Days</div>
        </div>
        <div class="pam-stat-card">
            <div class="pam-stat-value" style="color:@(_summary.CriticalRisk > 0 ? "#dc2626" : "inherit")">@_summary.CriticalRisk</div>
            <div class="pam-stat-label">Critical Risk</div>
        </div>
        <div class="pam-stat-card">
            <div class="pam-stat-value">@_summary.TotalAssignments</div>
            <div class="pam-stat-label">Active Assignments</div>
        </div>
        <div class="pam-stat-card">
            <div class="pam-stat-value" style="color:@(_summary.NeverRotated > 0 ? "#f59e0b" : "inherit")">@_summary.NeverRotated</div>
            <div class="pam-stat-label">Never Rotated</div>
        </div>
        <div class="pam-stat-card">
            <div class="pam-stat-value" style="color:@(_summary.RotationFailures > 0 ? "#f59e0b" : "inherit")">@_summary.RotationFailures</div>
            <div class="pam-stat-label">Rotation Failures</div>
        </div>
        <div class="pam-stat-card">
            <div class="pam-stat-value" style="color:@(_summary.OrphanedAssignments > 0 ? "#dc2626" : "inherit")">@_summary.OrphanedAssignments</div>
            <div class="pam-stat-label">Orphaned Assignments</div>
        </div>
    </div>
}

@* ── Tabs ─────────────────────────────────────────────────────────────── *@
<div class="pam-tabs" style="margin-bottom:1rem">
    <button class="pam-tab @(_tab == "matrix" ? "active" : "")" @onclick="@(() => SwitchTab("matrix"))">Access Matrix</button>
    <button class="pam-tab @(_tab == "stale" ? "active" : "")" @onclick="@(() => SwitchTab("stale"))">Stale Access</button>
</div>

@* ── Access Matrix Tab ────────────────────────────────────────────────────── *@
@if (_tab == "matrix")
{
    <div class="pam-card">
        <div class="pam-card-header">
            <h3 class="pam-card-title">Access Matrix — Who Has Access to What</h3>
            <span style="font-size:0.85em;color:#888">@_matrixTotal total assignments</span>
        </div>
        <div class="pam-card-body p-0">
            @if (_matrixLoading)
            {
                <div class="pam-loading-text p-4">Loading access matrix&#x2026;</div>
            }
            else if (_matrixItems == null || _matrixItems.Count == 0)
            {
                <div class="pam-empty p-4">No credential assignments found.</div>
            }
            else
            {
                <table class="pam-table pam-table-hover">
                    <thead>
                        <tr>
                            <th>Credential</th>
                            <th>Folder</th>
                            <th>Risk</th>
                            <th>Principal</th>
                            <th>Type</th>
                            <th>Device Group</th>
                            <th>Last Used</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _matrixItems)
                        {
                            <tr>
                                <td>
                                    <strong>@item.CredentialName</strong>
                                    @if (!string.IsNullOrEmpty(item.CredentialUsername))
                                    {
                                        <br /><small style="color:#888">@item.CredentialUsername</small>
                                    }
                                </td>
                                <td>@item.FolderName</td>
                                <td>
                                    <span class="pam-badge @RiskBadgeClass(item.CredentialRiskLevel)">@item.CredentialRiskLevel</span>
                                </td>
                                <td>@item.PrincipalName</td>
                                <td>
                                    <span class="pam-badge @(item.PrincipalType == "User" ? "pam-badge-info" : "pam-badge-secondary")">
                                        @item.PrincipalType
                                    </span>
                                </td>
                                <td>@(item.DeviceGroup ?? "—")</td>
                                <td>
                                    @if (item.LastUsed.HasValue)
                                    {
                                        <span title="@item.LastUsed.Value.ToString("yyyy-MM-dd HH:mm")">
                                            @item.LastUsed.Value.ToString("yyyy-MM-dd")
                                        </span>
                                    }
                                    else if (item.PrincipalType == "User")
                                    {
                                        <span style="color:#f59e0b">Never</span>
                                    }
                                    else
                                    {
                                        <span style="color:#888">—</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsEnabled)
                                    {
                                        <span class="pam-badge pam-badge-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="pam-badge pam-badge-secondary">Disabled</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_matrixTotal > _matrixPageSize)
                {
                    <div class="pam-pagination" style="padding:0.75rem 1rem">
                        <button class="pam-btn pam-btn-secondary pam-btn-sm" @onclick="MatrixPrevPage" disabled="@(_matrixPage <= 1)">&#x2190; Prev</button>
                        <span style="margin:0 1rem;font-size:0.9em">Page @_matrixPage of @((int)Math.Ceiling((double)_matrixTotal / _matrixPageSize))</span>
                        <button class="pam-btn pam-btn-secondary pam-btn-sm" @onclick="MatrixNextPage" disabled="@(_matrixPage * _matrixPageSize >= _matrixTotal)">Next &#x2192;</button>
                    </div>
                }
            }
        </div>
    </div>
}

@* ── Stale Access Tab ────────────────────────────────────────────────────── *@
@if (_tab == "stale")
{
    <div class="pam-card">
        <div class="pam-card-header">
            <div style="display:flex;align-items:center;gap:1rem">
                <h3 class="pam-card-title">Stale Access</h3>
                <div style="display:flex;gap:0.5rem">
                    @foreach (var days in new[] { 30, 60, 90, 180 })
                    {
                        <button class="pam-btn @(_staleDays == days ? "pam-btn-primary" : "pam-btn-secondary") pam-btn-sm"
                                @onclick="@(() => SetStaleDays(days))">@(days)d</button>
                    }
                </div>
            </div>
            <span style="font-size:0.85em;color:#888">Users with assigned credentials unused for @_staleDays+ days</span>
        </div>
        <div class="pam-card-body p-0">
            @if (_staleLoading)
            {
                <div class="pam-loading-text p-4">Loading stale access data&#x2026;</div>
            }
            else if (_staleItems == null || _staleItems.Count == 0)
            {
                <div class="pam-empty p-4" style="color:#22c55e">
                    &#x2713; No stale credential access detected for the @_staleDays-day window.
                </div>
            }
            else
            {
                <div class="pam-alert" style="background:#fff7ed;border-color:#f59e0b;color:#92400e;margin:0.75rem">
                    <strong>@_staleItems.Count stale assignment(s)</strong> found. Consider revoking unused access in
                    <a href="/credential-assignments" style="color:#92400e;text-decoration:underline">Credential Assignments</a>.
                </div>
                <table class="pam-table pam-table-hover">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Credential</th>
                            <th>Username</th>
                            <th>Last Used</th>
                            <th>Days Inactive</th>
                            <th>Assigned Since</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in _staleItems)
                        {
                            <tr>
                                <td>@item.Username</td>
                                <td>@item.CredentialName</td>
                                <td>@(item.CredentialUsername ?? "—")</td>
                                <td>
                                    @if (item.IsNeverUsed)
                                    {
                                        <span style="color:#dc2626">Never used</span>
                                    }
                                    else
                                    {
                                        @item.LastUsed?.ToString("yyyy-MM-dd")
                                    }
                                </td>
                                <td>
                                    @if (item.IsNeverUsed)
                                    {
                                        <span class="pam-badge pam-badge-danger">N/A</span>
                                    }
                                    else
                                    {
                                        <span class="pam-badge @(item.DaysInactive >= 180 ? "pam-badge-danger" : "pam-badge-warning")">
                                            @item.DaysInactive d
                                        </span>
                                    }
                                </td>
                                <td>@item.AssignedAt.ToString("yyyy-MM-dd")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    private string _tab = "matrix";
    private string? _error;

    // Summary
    private CredentialGovernanceSummaryDto? _summary;

    // Access Matrix
    private List<CredentialAccessMatrixItemDto>? _matrixItems;
    private bool _matrixLoading = false;
    private int _matrixPage = 1;
    private int _matrixPageSize = 50;
    private int _matrixTotal = 0;

    // Stale Access
    private List<StaleCredentialAccessDto>? _staleItems;
    private bool _staleLoading = false;
    private int _staleDays = 90;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadSummaryAsync();
        await LoadMatrixAsync();
        StateHasChanged();
    }

    private async Task LoadSummaryAsync()
    {
        _summary = await Api.GetCredentialGovernanceSummaryAsync();
    }

    private async Task LoadMatrixAsync()
    {
        _matrixLoading = true; StateHasChanged();
        var result = await Api.GetCredentialAccessMatrixAsync(_matrixPage, _matrixPageSize);
        _matrixItems = result?.Items;
        _matrixTotal = result?.Total ?? 0;
        _matrixLoading = false;
    }

    private async Task LoadStaleAsync()
    {
        _staleLoading = true; StateHasChanged();
        _staleItems = await Api.GetStaleCredentialAccessAsync(_staleDays);
        _staleLoading = false;
    }

    private async Task SwitchTab(string tab)
    {
        _tab = tab;
        if (tab == "stale" && _staleItems == null)
            await LoadStaleAsync();
        StateHasChanged();
    }

    private async Task SetStaleDays(int days)
    {
        _staleDays = days;
        _staleItems = null;
        await LoadStaleAsync();
        StateHasChanged();
    }

    private async Task MatrixPrevPage()
    {
        if (_matrixPage > 1) { _matrixPage--; await LoadMatrixAsync(); }
    }

    private async Task MatrixNextPage()
    {
        _matrixPage++;
        await LoadMatrixAsync();
    }

    private async Task ExportCsvAsync()
    {
        try
        {
            var csv = await Api.ExportCredentialsCsvAsync();
            if (csv != null)
                await JS.InvokeVoidAsync("downloadCsvFile", "credentials-export.csv", csv);
        }
        catch (Exception ex)
        {
            _error = "Export failed: " + ex.Message;
        }
    }

    private static string RiskBadgeClass(string? level) => level switch
    {
        "Critical" => "pam-badge-danger",
        "High"     => "pam-badge-warning",
        "Medium"   => "pam-badge-info",
        _          => "pam-badge-success"
    };
}
