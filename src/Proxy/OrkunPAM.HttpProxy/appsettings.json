{
  "HttpProxy": {
    "ListenPort": 8080,
    "ListenAddress": "0.0.0.0",
    "MaxConcurrentSessions": 50,
    "LogDirectory": "http-logs",
    "RetentionDays": 90,
    "UrlBlacklist": [],
    "UrlWhitelist": []
  },
  "PamApi": {
    "BaseUrl": "https://localhost:5001",
    "ProxySecret": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
