{
  "RdpProxy": {
    "ListenPort": 3389,
    "ListenAddress": null,
    "MaxConcurrentSessions": 50,
    "RecordingDirectory": "rdp-recordings",
    "RetentionDays": 183,
    "SessionTokenTtlSeconds": 300,
    "RdsGatewayHostname": null,
    "RdsGatewayPort": 443,
    "TlsCertificatePath": null,
    "TlsCertificatePassword": null,
    "RdsHosts": [],
    "ConnectionBroker": null,
    "EnableSessionShadowing": true,
    "EnableRemoteApp": true,
    "RemoteAppCollection": "PAM-RemoteApps"
  },
  "PamApi": {
    "BaseUrl": "https://localhost:5001",
    "ProxySecret": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
