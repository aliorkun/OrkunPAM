{
  "RdpProxy": {
    "ListenPort": 3389,
    "ListenAddress": null,
    "MaxConcurrentSessions": 50,
    "RecordingDirectory": "rdp-recordings",
    "RetentionDays": 183,
    "SessionTokenTtlSeconds": 300,
    "RdsGatewayHostname": null,
    "RdsGatewayPort": 443
  },
  "PamApi": {
    "BaseUrl": "https://localhost:5001",
    "ProxySecret": "changeme-generate-with-openssl-rand-base64-32"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  }
}
